 ;; Content addresses, not paths or bare version strings: a Maven entry's
 ;; `:sha256` is the digest of its resolved jar, a git entry's `:git-sha` is
 ;; git's own content address for the tree. `aiueos.tcb` re-verifies both
 ;; against `deps.edn` (and, for the shared security package, against
 ;; `security-adoption.edn`) so the records cannot silently disagree, and
 ;; rejects any runtime dependency that never reached this list.
 :tcb/external
 [{:coordinate "com.dylibso.chicory/wasm" :version "1.4.0"
   :role :wasm-parser :source :maven
   :sha256 "a850df5e77f60411648fd970144f825517a2c076dbb807ff6de95c6cfa439968"}
  {:coordinate "com.dylibso.chicory/runtime" :version "1.4.0"
   :role :wasm-runtime :source :maven
   :sha256 "81245b1f832afcf52169e655d2db6a07009864dba352b174b90a444bf096bf6e"}
  {:coordinate "io.github.kotoba-lang/security" :source :git
   :git-url "https://github.com/kotoba-lang/security.git"
   :git-sha "49fc4ce359752e9fe6e547e9071b5b9b40da937a"
   :role :shared-security-primitives}
  {:coordinate "io.github.kotoba-lang/abi" :source :git
   :git-url "https://github.com/kotoba-lang/abi.git"
   :git-sha "32ee84b2efc92478c846629c8d8319280eed506c"
   :role :freestanding-abi-contract}
  ;; The transport half of the cloud authorities runs on the platform HTTP
  ;; client. Since ADR-0044 the trust DECISION is no longer the platform's:
  ;; the default trust store is not consulted and an https peer is accepted
  ;; only if its key is in the policy's pin set. What remains platform-owned
  ;; is the TLS implementation itself -- the handshake, the record layer, the
  ;; cipher suites -- which this repository cannot content-address from inside
  ;; itself.
  {:coordinate "java.net.http" :role :remote-authority-tls-transport :source :platform
   :assurance-gap :platform-tls-implementation-not-content-addressed}
  {:coordinate "java.base" :minimum-version 25
   :role :crypto-ffi-process-runtime :source :platform
   ;; The host runtime cannot be content-addressed from inside this repository;
   ;; recorded as a gap rather than pinned by a version string that nothing
   ;; verifies.
   :assurance-gap :platform-runtime-not-content-addressed
   ;; The declared floor and the only place in this repository that provisions
   ;; a JDK disagree. Which one is wrong is an owner decision, so this records
   ;; the disagreement instead of picking a side — and `aiueos.tcb` checks the
   ;; record against the workflow, so raising the runner to >= 25 or lowering
   ;; the floor to 21 both make this entry fail until it is removed. It cannot
   ;; rot into a comment about a contradiction someone already fixed.
   :floor-unmet-by-ci {:workflow ".github/workflows/ci.yml"
                       :provisioned [21]
                       :decision :owner-pending
                       :see "docs/adr/0016-content-addressed-external-tcb.md"}}]
 ;; The transitive closure `:tcb/external` cannot express. `org.clojure/clojure`,
 ;; `spec.alpha` and `core.specs.alpha` are on every runtime classpath here and
 ;; are named by no declaration in `deps.edn`. Note the version: the shared
 ;; security package declares clojure 1.12.4, and 1.12.5 is what actually
 ;; loads — a declaration-level record would have said 1.12.4 and been wrong.
 ;;
 ;; `:scope :test` jars are on the classpath only under the `:test` alias and
 ;; are excluded from the TCB by `:tcb/excluded`; they are listed because the
 ;; check runs under that alias and an unrecorded classpath jar is an error.
 ;; Regenerate the digests with `clojure -M:test:tcb-check classpath`; roles are
 ;; a human judgement and are not generated.
 :tcb/classpath
 [{:jar "clojure-1.12.5.jar" :role :language-runtime :scope :runtime
