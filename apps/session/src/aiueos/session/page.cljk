(ns aiueos.session.page
  "SSR the hosted daily shell as one DADS document.

  `:app-css` is `tokens/skin-css` (bridge `--hig-*` onto DADS primitives, plus
  tap-target / safe-area) then a short unlayered phone shell. Not liquid-glass.
  Not a second design system."
  (:require [jp-go-dds.page :as page]
            [jp-go-dds.tokens :as tokens]
            [aiueos.session.views :as views]))

(def app-css
  "Desktop and app chrome. Colours, spacing, and radii come from the DADS tokens."
  (str
   ".session-shell{max-width:88rem;margin:0 auto;"
   "padding:0 var(--hig-spacing-4) var(--hig-spacing-4);"
   "color:var(--hig-color-label);"
   "background:var(--hig-color-system-background)}\n"
   ".session-shell:has(#desktop:not([hidden])){max-width:88rem}\n"
   ".session-main{min-height:calc(100vh - 4rem)}\n"
   ".desktop-surface{position:relative;display:flex;flex-direction:column;"
   "min-height:min(76vh,48rem);overflow:hidden;"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:var(--hig-radius-xs);"
   "background:linear-gradient(145deg,var(--hig-color-tint),"
   "var(--hig-color-secondary-system-background) 72%)}\n"
   ".desktop-menubar{display:flex;align-items:center;gap:var(--hig-spacing-4);"
   "min-height:2.75rem;padding:0 var(--hig-spacing-4);"
   "border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "background:var(--hig-color-system-background)}\n"
   ".desktop-brand{font-weight:700;color:var(--hig-color-label);text-decoration:none}\n"
   ".desktop-menubar-app{font-weight:600}\n"
   ".desktop-menubar-spacer,.window-spacer{flex:1}\n"
   ".desktop-menu-link{color:var(--hig-color-secondary-label);text-decoration:none}\n"
   ".desktop-menu-link:hover,.session-nav a:hover{color:var(--hig-color-tint)}\n"
   ".desktop-welcome{padding:var(--hig-spacing-6) var(--hig-spacing-6) 0}\n"
   ".desktop-welcome h1{margin:0}\n"
   ".desktop-app-grid{display:grid;grid-template-columns:repeat(4,minmax(6rem,8rem));"
   "gap:var(--hig-spacing-4);padding:var(--hig-spacing-5) var(--hig-spacing-6);"
   "align-content:start;flex:1}\n"
   ".desktop-app{display:flex;flex-direction:column;align-items:center;gap:var(--hig-spacing-2);"
   "padding:var(--hig-spacing-3);color:var(--hig-color-label);"
   "text-decoration:none;border-radius:var(--hig-radius-xs)}\n"
   ".desktop-app:hover{background:var(--hig-color-secondary-system-background)}\n"
   ".desktop-app-icon{display:grid;place-items:center;width:4.25rem;height:4.25rem;"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);"
   "color:var(--hig-color-tint);font-size:1.75rem;font-weight:700;"
   "box-shadow:0 0.25rem 0.75rem var(--hig-color-secondary-system-fill)}\n"
   ".desktop-app-label{padding:0 var(--hig-spacing-2);border-radius:var(--hig-radius-xs);"
   "background:var(--hig-color-system-background);font-size:var(--hig-text-footnote-font-size)}\n"
   ".desktop-dock-wrap{display:flex;justify-content:center;padding:0 var(--hig-spacing-4) var(--hig-spacing-4)}\n"
   ".desktop-dock{display:flex;align-items:center;gap:var(--hig-spacing-2);"
   "padding:var(--hig-spacing-2);border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);"
   "box-shadow:0 0.25rem 1rem var(--hig-color-secondary-system-fill)}\n"
   ".dock-app{display:flex;flex-direction:column;align-items:center;gap:var(--hig-spacing-1);"
   "min-width:4.5rem;padding:var(--hig-spacing-2);border-radius:var(--hig-radius-xs);"
   "color:var(--hig-color-label);text-decoration:none}\n"
   ".dock-app:hover{background:var(--hig-color-secondary-system-background)}\n"
   ".dock-app-icon{display:grid;place-items:center;width:2.75rem;height:2.75rem;"
   "border-radius:var(--hig-radius-xs);background:var(--hig-color-secondary-system-background);"
   "color:var(--hig-color-tint);font-weight:700;font-size:1.25rem}\n"
   ".dock-app-label{font-size:var(--hig-text-caption-1-font-size,0.7rem)}\n"
   ".dock-divider{width:var(--hig-hairline,1px);height:2.5rem;"
   "background:var(--hig-color-separator);margin:0 var(--hig-spacing-1)}\n"
   ".desktop-footer{padding:0 var(--hig-spacing-4) var(--hig-spacing-3);"
   "color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption-1-font-size,0.7rem)}\n"
   ".app-window{max-width:64rem;margin:var(--hig-spacing-6) auto;overflow:hidden;"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);"
   "box-shadow:0 0.5rem 2rem var(--hig-color-secondary-system-fill)}\n"
   ".app-window-head{display:flex;align-items:center;gap:var(--hig-spacing-3);"
   "min-height:2.75rem;padding:0 var(--hig-spacing-3);"
   "border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "background:var(--hig-color-secondary-system-background)}\n"
   ".app-window-title{font-weight:600}\n"
   ".app-window-state{color:var(--hig-color-secondary-label);"
   "font-size:var(--hig-text-footnote-font-size)}\n"
   ".window-close{display:grid;place-items:center;width:1.5rem;height:1.5rem;"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:50%;color:var(--hig-color-label);text-decoration:none}\n"
   ".app-window-body{padding:var(--hig-spacing-5)}\n"
   ".app-window-body h1{margin-top:0}\n"
   ".app-return{display:inline-block;margin-top:var(--hig-spacing-4);"
   "color:var(--hig-color-tint)}\n"
   ".app-empty-state{padding:var(--hig-spacing-4);"
   "border-left:var(--hig-hairline,1px) solid var(--hig-color-tint);"
   "background:var(--hig-color-secondary-system-background);"
   "color:var(--hig-color-secondary-label)}\n"
   ".reader-empty{max-width:42rem;padding:var(--hig-spacing-5);"
   "margin:var(--hig-spacing-5) auto;border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "background:var(--hig-color-secondary-system-background)}\n"
   ".wm-stage{position:relative;height:36rem;"
   "background:var(--hig-color-secondary-system-background);"
   "border-radius:var(--hig-radius-xs);"
   "margin:var(--hig-spacing-4) 0;"
   "outline:none}\n"
   ".ime-bar{min-height:2.75rem;"
   "padding:var(--hig-spacing-3);"
   "margin:var(--hig-spacing-4) 0;"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:var(--hig-radius-xs);"
   "background:var(--hig-color-secondary-system-background);"
   "gap:var(--hig-spacing-3);"
   "align-items:center}\n"
   ".ime-bar .dads-heading{margin:0}\n"
   ".ime-bar .dads-button{width:auto;margin:0}\n"
   ".wm-window{position:absolute;display:flex;flex-direction:column;"
   "background:var(--hig-color-system-background);"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "border-radius:var(--hig-radius-xs)}\n"
   ".wm-window.is-focused{outline:var(--hig-hairline,1px) solid var(--hig-color-label)}\n"
   ".wm-window:not(.is-focused) .wm-guest{pointer-events:none}\n"
   ".wm-titlebar{min-height:2.75rem;"
   "padding:var(--hig-spacing-3);"
   "border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "background:var(--hig-color-secondary-system-background);"
   "gap:var(--hig-spacing-3)}\n"
   ".wm-titlebar .dads-heading{margin:0;flex:1}\n"
   ".wm-body{flex:1;min-height:8rem;overflow:hidden}\n"
   ".wm-guest{width:100%;height:100%;min-height:8rem;"
   "padding:var(--hig-spacing-3);"
   "background:var(--hig-color-secondary-system-background)}\n"
   ".kami-viewport{display:block;width:100%;height:12rem;"
   "background:var(--hig-color-secondary-system-background);"
   "border-radius:var(--hig-radius-xs);"
   "margin:var(--hig-spacing-3) 0}\n"
   ".session-chrome{position:sticky;top:0;z-index:1;display:flex;"
   "justify-content:space-between;align-items:center;gap:var(--hig-spacing-4);"
   "padding:var(--hig-spacing-3) 0;"
   "margin-bottom:var(--hig-spacing-3);"
   "border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);"
   "background:var(--hig-color-system-background)}\n"
   ".session-brand{font-weight:700;color:var(--hig-color-label);text-decoration:none}\n"
   ".session-nav{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-4)}\n"
   ".session-nav a{color:var(--hig-color-secondary-label);text-decoration:none;"
   "font-size:var(--hig-text-footnote-font-size)}\n"
   ".session-lede{color:var(--hig-color-secondary-label);"
   "font-size:var(--hig-text-body-font-size,1rem);"
   "line-height:var(--hig-text-body-line-height,1.5)}\n"
   ".session-out{white-space:pre-wrap;overflow:auto;"
   "min-height:var(--hig-spacing-4);"
   "padding:var(--hig-spacing-3);"
   "background:var(--hig-color-secondary-system-background);"
   "border-radius:var(--hig-radius-xs);"
   "font-size:var(--hig-text-footnote-font-size)}\n"
   ".device-auth-qr{display:block;width:min(100%,18rem);height:auto;"
   "margin:var(--hig-spacing-4) auto;image-rendering:pixelated;"
   "background:var(--hig-color-system-background)}\n"
   ".device-auth-qr[hidden]{display:none!important}\n"
   ".session-view[hidden]{display:none!important}\n"
   "@media(max-width:40rem){.desktop-app-grid{grid-template-columns:repeat(2,minmax(6rem,8rem));justify-content:space-around}.desktop-menubar{gap:var(--hig-spacing-2);padding:0 var(--hig-spacing-2)}.desktop-menu-link{font-size:var(--hig-text-caption-1-font-size,0.7rem)}.dock-app{min-width:3rem}.dock-app-label{display:none}.session-shell{padding-inline:var(--hig-spacing-2)}}\n"
   ".dds-ext-card{margin:var(--hig-spacing-4) 0}\n"
   ".session-main .dads-button{width:100%;margin:var(--hig-spacing-3) 0}\n"
   ".wm-titlebar .dads-button{width:auto;margin:0}\n"
   ;; Chrome polish layer. Geometry, colour and type stay on DADS tokens;
   ;; only the soft elevation shadows are local (ink-alpha, not a palette).
   ":root{--ui-shadow-low:0 1px 2px rgba(0,17,43,0.06),0 2px 8px rgba(0,17,43,0.05);"
   "--ui-shadow-mid:0 2px 6px rgba(0,17,43,0.07),0 12px 28px rgba(0,17,43,0.09);"
   "--ui-shadow-dock:0 1px 2px rgba(0,17,43,0.06),0 16px 40px rgba(0,17,43,0.12)}\n"
   "a:focus,button:focus,input:focus,textarea:focus,summary:focus,"
   "[tabindex]:focus{outline:2px solid var(--hig-color-tint);outline-offset:2px}\n"
   ".desktop-app,.dock-app,.session-nav a,.desktop-menu-link,.window-close{"
   "transition:background-color var(--hig-motion-press) linear,"
   "color var(--hig-motion-press) linear,box-shadow var(--hig-motion-press) linear}\n"
   ".desktop-surface{border-radius:var(--hig-radius-sm);"
   "background:linear-gradient(165deg,var(--hig-color-system-background),"
   "var(--hig-color-tertiary-system-background) 55%,"
   "var(--hig-color-secondary-system-background))}\n"
   ".desktop-app-icon{box-shadow:var(--ui-shadow-low)}\n"
   ".desktop-app:hover .desktop-app-icon{box-shadow:var(--ui-shadow-mid)}\n"
   ".desktop-app-icon[data-app=\"murakumo\"],.dock-app-icon[data-app=\"murakumo\"]{"
   "color:var(--color-primitive-purple-700);"
   "background:var(--color-primitive-purple-50);"
   "border-color:var(--color-primitive-purple-200)}\n"
   ".desktop-app-icon[data-app=\"itonami\"],.dock-app-icon[data-app=\"itonami\"]{"
   "color:var(--color-primitive-orange-800);background:var(--color-primitive-orange-50);"
   "border-color:var(--color-primitive-orange-200)}\n"
   ".desktop-app-icon[data-app=\"yataverse\"],.dock-app-icon[data-app=\"yataverse\"]{"
   "color:var(--color-primitive-green-800);background:var(--color-primitive-green-50);"
   "border-color:var(--color-primitive-green-200)}\n"
   ".desktop-app-icon[data-app=\"aozora\"],.dock-app-icon[data-app=\"aozora\"]{"
   "color:var(--color-primitive-light-blue-800);"
   "background:var(--color-primitive-light-blue-50);"
   "border-color:var(--color-primitive-light-blue-200)}\n"
   ".dock-app-icon{border:var(--hig-hairline,1px) solid var(--hig-color-separator)}\n"
   ".dock-app.is-active .dock-app-icon{box-shadow:0 0 0 2px var(--hig-color-tint)}\n"
   ".dock-app.is-active{background:var(--hig-color-quaternary-system-fill)}\n"
   ".desktop-dock{border-radius:var(--hig-radius-md);box-shadow:var(--ui-shadow-dock)}\n"
   ".app-window{border-radius:var(--hig-radius-sm);box-shadow:var(--ui-shadow-mid)}\n"
   ".window-close:hover{background:var(--hig-color-tint);"
   "color:var(--hig-color-system-background);border-color:var(--hig-color-tint)}\n"
   ".session-nav a[aria-current=\"page\"]{color:var(--hig-color-tint);font-weight:600;"
   "border-bottom:2px solid var(--hig-color-tint);padding-bottom:2px}\n"
   ".desktop-menu-link[aria-current=\"page\"]{color:var(--hig-color-label);font-weight:600}\n"
   ".desktop-welcome h1{letter-spacing:-0.01em}\n"
   ".desktop-footer{letter-spacing:0.02em}\n"
   ".session-lede{max-width:44rem}\n"
   ".session-out{font-family:var(--hig-font-mono);"
   "border:var(--hig-hairline,1px) solid var(--hig-color-separator)}\n"
   ".session-main .dads-button{max-width:24rem}\n"))

(defn document
  "Full HTML string. `dds-css` is the vendored DADS stylesheet; `client-js`
  is the fragment-router + session-process client, inlined so `/` is one
  HTML document."
  [{:keys [dds-css client-js]}]
  (when (or (nil? dds-css) (zero? (count dds-css)))
    (throw (ex-info "dds.css is required; generate with --dds-css" {})))
  (page/->page
   {:title "AIUEOS Desktop"
    :description "AIUEOS app desktop rendered through Kotoba Browser."
    :lang "ja"
    :css dds-css
    :app-css (str tokens/skin-css "\n" app-css)
    :head [[:meta {:name "aiueos-design" :content "jp-go-dds"}]
           [:meta {:name "aiueos-ui-engine" :content "kotoba-lang/browser"}]
           [:meta {:name "aiueos-hosted-adapter" :content "html-js-verification-only"}]]}
   (views/shell)
   [:script {:src "/kami-presenter.js"}]
   [:script (or client-js "")]))
