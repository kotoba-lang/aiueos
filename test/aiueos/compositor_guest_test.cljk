(def ^:private title-lines
  (apply str
         (map (fn [n at] (str "AIUEOS_GUEST_BROWSER_FOCUS_TITLE n=" n " active=2 inactive=4 at=" at "\r\n"))
              (range 1 13)
              (concat (repeat 3 "82,80") (repeat 2 "274,132") (repeat 7 "82,80")))))

(deftest guest-browser-title-active-classifier
  (let [base (str cursor-ok-line focus-lines focus-ok)]
    (testing "twelve frames, one focused titlebar and two others in each, at the focused window: green"
      (let [r (guest/classify "guest-browser-title-active" {:serial (str base title-lines)})]
        (is (= :guest-browser-title-active (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a frame where two windows are drawn active is red, and says which"
      (let [r (guest/classify "guest-browser-title-active"
                              {:serial (str base (.replace title-lines "n=4 active=2 inactive=4" "n=4 active=4 inactive=2"))})]
        (is (= :title-differs-from-model (:reason r)))
        (is (= 4 (first (:kernel (:first-difference r)))))))
    (testing "the active titlebar at the wrong window is red"
      (is (= :title-differs-from-model
             (:reason (guest/classify "guest-browser-title-active"
                                      {:serial (str base (.replace title-lines "n=4 active=2 inactive=4 at=274,132" "n=4 active=2 inactive=4 at=82,80"))})))))
    (testing "a missing frame is red"
      (is (= :title-differs-from-model
             (:reason (guest/classify "guest-browser-title-active"
                                      {:serial (str base (.replace title-lines "FOCUS_TITLE n=12 " "FOCUS_TITLE n=120 "))})))))
    (testing "no title lines at all is absent, not green"
      (is (= :guest-browser-title-active-absent
             (:reason (guest/classify "guest-browser-title-active" {:serial base})))))
    (testing "it needs the focus-cycle gate green first"
      (is (= :no-focus-cycle
             (:reason (guest/classify "guest-browser-title-active" {:serial (str cursor-ok-line title-lines)})))))
    (testing "an unmeasured boot is exit 3"
      (is (= 3 (:exit (guest/classify "guest-browser-title-active" {:serial base :qemu-unmeasured? true})))))))

(deftest guest-browser-focus-cycle-classifier
  (testing "twelve frames, three window-manager focuses, the model's censuses: green"
    (let [r (guest/classify "guest-browser-focus-cycle" {:serial (str cursor-ok-line focus-lines focus-ok)})]
      (is (= :guest-browser-focus-cycle (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:kernel-focus-cycle-shortcut :left-alt-only :no-switcher-overlay] (:leftover r)))))
  (testing "Alt+Tab needs the pointer stage first"
    (is (= :no-cursor
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str dict-ok-line focus-lines focus-ok)})))))
  (testing "an OK line with a frame line missing is not green"
    (is (= :focus-lines-missing
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str cursor-ok-line
                                                  (.replace focus-lines "FRAME n=7 " "FRAME n=70 ")
                                                  focus-ok)})))))
  (testing "an OK line without the GO line is not green"
    (is (= :focus-lines-missing
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str cursor-ok-line
                                                  (.replace focus-lines "FOCUS_GO" "FOCUS_G0")
                                                  focus-ok)})))))
  (testing "an OK line naming a different chain is not this gate's"
    (is (= :guest-browser-focus-cycle-absent
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str cursor-ok-line focus-lines
                                                  (.replace focus-ok "chain=2254db31" "chain=1e19707d"))})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_FOCUS leftover=events-missing events=3 frames=3\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_FOCUS leftover=census-miss off=5 wm=3 bodies=unchanged chain=1e19707d focus=2 alt=0\r\n" :census-miss]
                           ["" :guest-browser-focus-cycle-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-focus-cycle" {:serial (str cursor-ok-line line)}))) line)))
  (testing "tablet profile, with the pointer's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "1260"} (guest/extra-env "guest-browser-focus-cycle")))))

