       "AIUEOS_GUEST_BROWSER_FOCUS_FRAME n=7 src=0 key=60 key-answer=0 answer=0 focus=3 stack=213 ops=129 text-px=946 hash=c461a68f\r\n"
       "AIUEOS_GUEST_BROWSER_FOCUS_FRAME n=8 src=0 key=61 key-answer=258 answer=2 focus=2 stack=132 ops=129 text-px=1082 hash=e90ed2bc\r\n"
       "AIUEOS_GUEST_BROWSER_FOCUS_FRAME n=9 src=0 key=60 key-answer=0 answer=0 focus=2 stack=132 ops=129 text-px=1082 hash=e90ed2bc\r\n"
       "AIUEOS_GUEST_BROWSER_FOCUS_FRAME n=10 src=0 key=224 key-answer=0 answer=0 focus=2 stack=132 ops=129 text-px=1082 hash=e90ed2bc\r\n"
       "AIUEOS_GUEST_BROWSER_FOCUS_FRAME n=11 src=0 key=61 key-answer=0 answer=0 focus=2 stack=132 ops=129 text-px=1082 hash=e90ed2bc\r\n"
       "AIUEOS_GUEST_BROWSER_FOCUS_FRAME n=12 src=0 key=60 key-answer=0 answer=0 focus=2 stack=132 ops=129 text-px=1082 hash=e90ed2bc\r\n"))

(def ^:private focus-ok
  "AIUEOS_GUEST_BROWSER_FOCUS_OK events=12 answers=200103020000 wm=3 stack=132 focus=2 bodies=unchanged chain=2254db31 ops=129 text-px=1082 hash=e90ed2bc\r\n")

(deftest guest-browser-focus-cycle-classifier
  (testing "twelve frames, three window-manager focuses, the model's censuses: green"
    (let [r (guest/classify "guest-browser-focus-cycle" {:serial (str cursor-ok-line focus-lines focus-ok)})]
      (is (= :guest-browser-focus-cycle (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:kernel-focus-cycle-shortcut :left-alt-only :no-switcher-overlay] (:leftover r)))))
  (testing "Alt+Tab needs the pointer stage first"
    (is (= :no-cursor
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str dict-ok-line focus-lines focus-ok)})))))
  (testing "an OK line with a frame line missing is not green"
    (is (= :focus-lines-missing
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str cursor-ok-line
                                                  (.replace focus-lines "FRAME n=7 " "FRAME n=70 ")
                                                  focus-ok)})))))
  (testing "an OK line without the GO line is not green"
    (is (= :focus-lines-missing
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str cursor-ok-line
                                                  (.replace focus-lines "FOCUS_GO" "FOCUS_G0")
                                                  focus-ok)})))))
  (testing "an OK line naming a different chain is not this gate's"
    (is (= :guest-browser-focus-cycle-absent
           (:reason (guest/classify "guest-browser-focus-cycle"
                                    {:serial (str cursor-ok-line focus-lines
                                                  (.replace focus-ok "chain=2254db31" "chain=1e19707d"))})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_FOCUS leftover=events-missing events=3 frames=3\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_FOCUS leftover=census-miss off=5 wm=3 bodies=unchanged chain=1e19707d focus=2 alt=0\r\n" :census-miss]
                           ["" :guest-browser-focus-cycle-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-focus-cycle" {:serial (str cursor-ok-line line)}))) line)))
  (testing "tablet profile, with the pointer's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "1260"} (guest/extra-env "guest-browser-focus-cycle")))))

;; Guest browser body flow (ADR-0234). A one-window stand-in for the kernel's
;; op dump: the classifier's span rule and its comparison, not the real scene
;; (the real scene's hosted answer is os/aiueos/contracts/browser-flow-parity-v1.edn).

(defn- word-hex [v]
  (let [h "0123456789abcdef"]
    (apply str (for [shift [28 24 20 16 12 8 4 0]] (nth h (bit-and (bit-shift-right v shift) 15))))))

(defn- ops-line [ops]
  (str "AIUEOS_GUEST_BROWSER_FLOW_OPS n=" (count ops) " words="
       (apply str (map word-hex (apply concat ops))) "\r\n"))

(def ^:private flow-stand-in
  ;; background, window 1's body and titlebar rects, a title glyph (y + 6:
  ;; not the body's), two body glyphs, the caret
  [[1 0 0 1280 800 16119544] [1 10 20 300 100 16777215] [1 10 20 300 28 14215167]
   [2 18 26 67 8 1118481] [2 24 62 67 8 1118481] [2 32 62 7421 16 1118481]
   [1 48 62 1 16 1118481]])

(def ^:private flow-parity
  {:scene {:vw 1280 :vh 800 :focus 1 :stack [{:id 1 :x 10 :y 20 :w 300 :h 100}]}
   :bodies {1 [[14 14 67 8] [22 14 7421 16]]}})

(def ^:private flow-ok
  "AIUEOS_GUEST_BROWSER_FLOW_OK windows=4 ops=158 text-px=3593 hash=a19f95a8\r\n")

(deftest guest-browser-flow-parity-classifier
  (testing "the body glyphs read out of the op dump equal the hosted engine's, and the census line: green"
    (let [r (guest/classify "guest-browser-flow-parity"
                            {:serial (str (ops-line flow-stand-in) flow-ok) :flow-parity flow-parity})]
      (is (= :guest-browser-flow-parity (:reason r)))
      (is (= 0 (:exit r)))
      (is (= 2 (:compared r)))
      (is (= [:no-cjk-break-opportunity :windows-sit-at-their-rect :kernel-clips-the-body] (:leftover r)))))
  (testing "the span rule: the title glyph is above y + 28 and is not a body glyph"
    (is (= {1 [[14 14 67 8] [22 14 7421 16]]}
           (guest/flow-body-glyphs (get-in flow-parity [:scene :stack]) flow-stand-in))))
  (testing "one glyph a pixel to the right of the hosted engine's is red, and says which"
    (let [r (guest/classify "guest-browser-flow-parity"
                            {:serial (str (ops-line (assoc flow-stand-in 5 [2 33 62 7421 16 1118481])) flow-ok)
                             :flow-parity flow-parity})]
      (is (= :body-differs-from-hosted (:reason r)))
      (is (= {:window 1 :glyph 1 :hosted [22 14 7421 16] :kernel [23 14 7421 16]} (:first-difference r)))))
  (testing "a missing glyph is red too"
    (is (= :body-differs-from-hosted
           (:reason (guest/classify "guest-browser-flow-parity"
                                    {:serial (str (ops-line (vec (concat (subvec flow-stand-in 0 5) [(peek flow-stand-in)]))) flow-ok)
                                     :flow-parity flow-parity})))))
  (testing "equal glyphs without the census line are not green"
    (is (= :census-miss
           (:reason (guest/classify "guest-browser-flow-parity"
                                    {:serial (ops-line flow-stand-in) :flow-parity flow-parity})))))
  (testing "a window whose rects are not in the dump is not read as empty"
    (is (= :window-span-missing
           (:reason (guest/classify "guest-browser-flow-parity"
                                    {:serial (str (ops-line flow-stand-in) flow-ok)
                                     :flow-parity (assoc-in flow-parity [:scene :stack 0 :w] 301)})))))
  (testing "a dump whose words do not make n ops is absent, not compared"
    (is (= :guest-browser-flow-absent
           (:reason (guest/classify "guest-browser-flow-parity"
                                    {:serial (str (str/replace (ops-line flow-stand-in) "n=7 " "n=8 ") flow-ok)
                                     :flow-parity flow-parity})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_FLOW leftover=frame-refused reason=-5\r\n" :frame-refused]
                           ["AIUEOS_GUEST_BROWSER_FLOW leftover=present-refused\r\n" :present-refused]
                           ["" :guest-browser-flow-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-flow-parity" {:serial line :flow-parity flow-parity}))) line)))
  (testing "no hosted answer, or no serial, is exit 3 -- not measured"
    (is (= 3 (:exit (guest/classify "guest-browser-flow-parity" {:serial (str (ops-line flow-stand-in) flow-ok)}))))
    (is (= 3 (:exit (guest/classify "guest-browser-flow-parity" {:qemu-unmeasured? true :flow-parity flow-parity})))))
  (testing "no tablet: the default profile"
    (is (nil? (guest/extra-env "guest-browser-flow-parity")))))
