(def ^:private cursor-ok
  "AIUEOS_GUEST_BROWSER_CURSOR_OK events=5 answers=00000 before=0 at=1000,600 tip=111111 fill=ffffff chain=f4bb42d8 ops=127 text-px=948 hash=3e8be657\r\n")

(deftest guest-browser-cursor-classifier
  (testing "five frames, each ending with the arrow at the pointer, the model's censuses: green"
    (let [r (guest/classify "guest-browser-cursor" {:serial (str dict-ok-line cursor-lines cursor-ok)})]
      (is (= :guest-browser-cursor (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:pointer-only-from-the-cursor-stage :kernel-arrow-sprite :no-cursor-shapes] (:leftover r)))))
  (testing "the pointer needs the dictionary first"
    (is (= :no-dictionary
           (:reason (guest/classify "guest-browser-cursor"
