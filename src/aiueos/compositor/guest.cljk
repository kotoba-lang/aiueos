(ns aiueos.compositor.guest
  "KERNEL.ELF guest compositor serial classifiers (ADR-0100).

  Portable. nbb loads this namespace without kami / phone-bind / JVM.
  Hosted `kbb -M:compositor wm` / `ime` remain the named reds.
  Evidence command is `kbb --backend sci --classpath src scripts/compositor-guest.cljk`
  plus a guest profile. QEMU/firmware/serial unanswered is exit 3."
  (:require [kotoba.lang.text :as str]))

(def gate-prefix
  "kbb --backend sci --classpath src scripts/compositor-guest.cljk")

(def guest-profiles
  ["guest-ime" "guest-wm" "guest-paint" "guest-input"
   "guest-gpu-two" "guest-scanout-two" "guest-broker" "guest-session"
   "guest-browser-frame" "guest-browser-input"
   "guest-browser-text" "guest-browser-text-raised" "guest-browser-type"
   "guest-browser-preedit" "guest-browser-ime-toggle" "guest-browser-drag"
   "guest-browser-resize" "guest-browser-event-loop" "guest-browser-caret"
   "guest-browser-launch" "guest-browser-flow-parity" "guest-browser-dictionary"
   "guest-browser-cursor" "guest-browser-focus-cycle" "guest-browser-scroll"
   "guest-browser-selection" "guest-browser-clipboard" "guest-browser-damage"
   "guest-browser-title-active" "guest-browser-hover"
   "guest-browser-high-contrast" "guest-browser-focus-ring"
   "guest-browser-keyboard-activate"
   "guest-browser-window-maximize" "guest-browser-maximize-control"
   "guest-browser-cursor-shape" "guest-browser-pressed-state"
   "guest-browser-minimize" "guest-browser-screen-lock"])

(defn gate-cmd
  "SPA-visible evidence command for a guest profile. Not clojure -M."
  [profile]
  (str gate-prefix " " profile))

(defn serial-measured?
  [serial]
  (boolean (and (string? serial) (re-find #"AIUEOS_" serial))))

(defn guest-ime-ok?
  "True only when KERNEL.ELF serial says Kotoba IME committed U+304B
  without echoing latin `ka`. Hosted JVM IME serial does not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_IME_OK committed=u\+304b latin-leak=0" serial)
        (not (re-find #"(?m)^AIUEOS_GUEST_IME_OK committed=ka" serial))
        (not (re-find #"AIUEOS_COMPOSITOR_IME_OK" serial)))))

(defn guest-ime-result
  "Classify a KERNEL.ELF boot for compositor `guest-ime`.
  Hosted `kbb -M:compositor ime` is the named red."
  [{:keys [serial qemu-unmeasured? hosted-ime?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-ime?
        (re-find #"AIUEOS_COMPOSITOR_IME_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-ime-does-not-count
     :leftover [:hosted-ime-does-not-count]}

    (guest-ime-ok? serial)
    {:green? true :exit 0 :reason :guest-ime-kotoba-commit :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_IME leftover=latin-leak" (or serial ""))
    {:green? false :exit 1 :reason :latin-leak :leftover [:latin-leak]}

    (re-find #"(?m)^AIUEOS_GUEST_IME leftover=vector-miss" (or serial ""))
    {:green? false :exit 1 :reason :vector-miss :leftover [:vector-miss]}

    :else
    {:green? false :exit 1 :reason :guest-ime-absent
     :leftover [:guest-ime-absent]}))

(defn guest-wm-ok?
  "True only when KERNEL.ELF serial says Kotoba WM hit the four
  boot-desktop vectors. Hosted JVM WM serial does not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_WM_OK two-surfaces z-hit=2 miss-front=1 raise=1 one-surface=0" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-wm-result
  "Classify a KERNEL.ELF boot for compositor `guest-wm`.
  Hosted `kbb -M:compositor wm` is the named red."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-wm-ok? serial)
    {:green? true :exit 0 :reason :guest-wm-kotoba-hit :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_WM leftover=one-surface-ignored" (or serial ""))
    {:green? false :exit 1 :reason :one-surface-ignored :leftover [:one-surface-ignored]}

    (re-find #"(?m)^AIUEOS_GUEST_WM leftover=z-order-ignored" (or serial ""))
    {:green? false :exit 1 :reason :z-order-ignored :leftover [:z-order-ignored]}

    (re-find #"(?m)^AIUEOS_GUEST_WM leftover=always-front" (or serial ""))
    {:green? false :exit 1 :reason :always-front :leftover [:always-front]}

    (re-find #"(?m)^AIUEOS_GUEST_WM leftover=raise-is-noop" (or serial ""))
    {:green? false :exit 1 :reason :raise-is-noop :leftover [:raise-is-noop]}

    (re-find #"(?m)^AIUEOS_GUEST_WM leftover=vector-miss" (or serial ""))
    {:green? false :exit 1 :reason :vector-miss :leftover [:vector-miss]}

    :else
    {:green? false :exit 1 :reason :guest-wm-absent
     :leftover [:guest-wm-absent]}))

(defn guest-paint-ok?
  "True only when KERNEL.ELF serial says both boot rects were painted
  in Kotoba z-order and the overlap pixel followed front, not key
  order. Hosted JVM WM serial does not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_PAINT_OK boot-overlap=2 raised-overlap=1 key-order=0" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-paint-result
  "Classify a KERNEL.ELF boot for compositor `guest-paint`.
  Hosted `kbb -M:compositor wm` is the named red."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-paint-ok? serial)
    {:green? true :exit 0 :reason :guest-paint-z-order :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_PAINT leftover=fb-too-small" (or serial ""))
    {:green? false :exit 1 :reason :fb-too-small :leftover [:fb-too-small]}

    (re-find #"(?m)^AIUEOS_GUEST_PAINT leftover=one-guest-scanout" (or serial ""))
    {:green? false :exit 1 :reason :one-guest-scanout :leftover [:one-guest-scanout]}

    (re-find #"(?m)^AIUEOS_GUEST_PAINT leftover=key-order-paint" (or serial ""))
    {:green? false :exit 1 :reason :key-order-paint :leftover [:key-order-paint]}

    (re-find #"(?m)^AIUEOS_GUEST_PAINT leftover=always-front-paint" (or serial ""))
    {:green? false :exit 1 :reason :always-front-paint :leftover [:always-front-paint]}

    (re-find #"(?m)^AIUEOS_GUEST_PAINT leftover=vector-miss" (or serial ""))
    {:green? false :exit 1 :reason :vector-miss :leftover [:vector-miss]}

    :else
    {:green? false :exit 1 :reason :guest-paint-absent
     :leftover [:guest-paint-absent]}))

(defn guest-input-ok?
  "True only when KERNEL.ELF serial says the desktop envelope came
  from a virtio-input used-ring event, not the synthetic fill.
  Hosted JVM compositor input does not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_INPUT_OK eventq-used=1 synthetic=0" serial)
        (not (re-find #"(?m)^AIUEOS_GUEST_INPUT leftover=synthetic-smoke" serial))
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-input-result
  "Classify a KERNEL.ELF boot for compositor `guest-input`.
  Hosted `kbb -M:compositor wm` is the named red. C filling the
  envelope is leftover `:synthetic-smoke`."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-input-ok? serial)
    {:green? true :exit 0 :reason :guest-input-eventq :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_INPUT leftover=synthetic-smoke" (or serial ""))
    {:green? false :exit 1 :reason :synthetic-smoke :leftover [:synthetic-smoke]}

    (re-find #"(?m)^AIUEOS_GUEST_INPUT leftover=eventq-empty" (or serial ""))
    {:green? false :exit 1 :reason :eventq-empty :leftover [:eventq-empty]}

    :else
    {:green? false :exit 1 :reason :guest-input-absent
     :leftover [:guest-input-absent]}))

(defn guest-gpu-two-ok?
  "True only when KERNEL.ELF serial says two virtio-gpu 2D resources
  were created and flushed after Kotoba admitted n=2. Hosted JVM gpu
  serial alone does not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_GPU_TWO_OK resources=2 flush=2 kotoba-n=2" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-gpu-two-result
  "Classify a KERNEL.ELF boot for compositor `guest-gpu-two`.
  Hosted `kbb -M:compositor wm` is the named red. One resource
  when Kotoba admits two is leftover `:one-resource`."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-gpu-two-ok? serial)
    {:green? true :exit 0 :reason :guest-gpu-two-resources :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_GPU_TWO leftover=one-resource" (or serial ""))
    {:green? false :exit 1 :reason :one-resource :leftover [:one-resource]}

    :else
    {:green? false :exit 1 :reason :guest-gpu-two-absent
     :leftover [:guest-gpu-two-absent]}))

(defn guest-scanout-two-ok?
  "True only when KERNEL.ELF serial says two virtio-gpu scanouts were
  bound after Kotoba admitted n=2. Hosted JVM wm serial alone does
  not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_SCANOUT_TWO_OK scanouts=2 resource-0=1 resource-1=2 kotoba-n=2" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-scanout-two-result
  "Classify a KERNEL.ELF boot for compositor `guest-scanout-two`.
  Hosted `kbb -M:compositor wm` is the named red. One scanout
  when Kotoba admits two is leftover `:one-scanout`."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-scanout-two-ok? serial)
    {:green? true :exit 0 :reason :guest-scanout-two-bound :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_SCANOUT_TWO leftover=one-scanout" (or serial ""))
    {:green? false :exit 1 :reason :one-scanout :leftover [:one-scanout]}

    :else
    {:green? false :exit 1 :reason :guest-scanout-two-absent
     :leftover [:guest-scanout-two-absent]}))

(defn guest-broker-ok?
  "True only when KERNEL.ELF serial says clipboard was admitted and
  file-picker refused after Kotoba. Hosted JVM wm serial alone does
  not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_BROKER_OK clipboard=1 picker=0 kotoba-clip=1 kotoba-pick=0" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-broker-result
  "Classify a KERNEL.ELF boot for compositor `guest-broker`.
  Hosted `kbb -M:compositor wm` is the named red. Picker admitted
  on a clipboard-only grant is leftover `:always-grant`."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-broker-ok? serial)
    {:green? true :exit 0 :reason :guest-broker-admitted :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_BROKER leftover=always-grant" (or serial ""))
    {:green? false :exit 1 :reason :always-grant :leftover [:always-grant]}

    (re-find #"(?m)^AIUEOS_GUEST_BROKER leftover=deny-all" (or serial ""))
    {:green? false :exit 1 :reason :deny-all :leftover [:deny-all]}

    :else
    {:green? false :exit 1 :reason :guest-broker-absent
     :leftover [:guest-broker-absent]}))

(defn guest-session-ok?
  "True only when KERNEL.ELF serial says packed front 2 restored and
  wm-hit used that front. Hosted JVM wm serial alone does not count."
  [serial]
  (boolean
   (and (string? serial)
        (re-find #"(?m)^AIUEOS_GUEST_SESSION_OK restored-front=2 packed=2 kotoba-front=2 hit=2" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-session-result
  "Classify a KERNEL.ELF boot for compositor `guest-session`.
  Hosted `kbb -M:compositor wm` is the named red. Restore that
  returns 2 for packed 0 is leftover `:always-front`."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (cond
    qemu-unmeasured?
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

    (or hosted-wm?
        (re-find #"AIUEOS_COMPOSITOR_WM_OK" (or serial "")))
    {:green? false :exit 1 :reason :hosted-wm-does-not-count
     :leftover [:hosted-wm-does-not-count]}

    (guest-session-ok? serial)
    {:green? true :exit 0 :reason :guest-session-admitted :leftover []}

    (re-find #"(?m)^AIUEOS_GUEST_SESSION leftover=always-front" (or serial ""))
    {:green? false :exit 1 :reason :always-front :leftover [:always-front]}

    (re-find #"(?m)^AIUEOS_GUEST_SESSION leftover=empty-session" (or serial ""))
    {:green? false :exit 1 :reason :empty-session :leftover [:empty-session]}

    (re-find #"(?m)^AIUEOS_GUEST_SESSION leftover=unknown-surface" (or serial ""))
    {:green? false :exit 1 :reason :unknown-surface :leftover [:unknown-surface]}

    (re-find #"(?m)^AIUEOS_GUEST_SESSION leftover=restore-ignored" (or serial ""))
    {:green? false :exit 1 :reason :restore-ignored :leftover [:restore-ignored]}

    :else
    {:green? false :exit 1 :reason :guest-session-absent
     :leftover [:guest-session-absent]}))


;; Guest browser desktop (ADR-0223). kotoba-lang/browser ADR 0002 makes the
;; browser surface the aiueos desktop; these two gates are that surface on
;; KERNEL.ELF. Hosted desktop-backend frames (JS/JVM) and hosted WM serial do
;; not count.

(def ^:private browser-frame-ok-re
  #"(?m)^AIUEOS_GUEST_BROWSER_FRAME_OK ops=5 overlap=d8e7ff win1-title=dde2ea surface=\d+x\d+")

(defn guest-browser-frame-ok?
  "True only when KERNEL.ELF serial says the Kotoba browser frame was
  presented: five ops, the overlap pixel is the FRONT window's focused
  titlebar and window 1's titlebar is the unfocused colour."
  [serial]
  (boolean
   (and (string? serial)
        (re-find browser-frame-ok-re serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-browser-frame-result
  "Classify a KERNEL.ELF boot for compositor `guest-browser-frame`."
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured?
      {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

      (or hosted-wm? (re-find #"AIUEOS_COMPOSITOR_WM_OK" s))
      {:green? false :exit 1 :reason :hosted-wm-does-not-count
       :leftover [:hosted-wm-does-not-count]}

      (guest-browser-frame-ok? s)
      {:green? true :exit 0 :reason :guest-browser-frame :leftover [:no-text-raster]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_FRAME leftover=frame-refused" s)
      {:green? false :exit 1 :reason :frame-refused :leftover [:frame-refused]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_FRAME leftover=fb-too-small" s)
      {:green? false :exit 1 :reason :fb-too-small :leftover [:fb-too-small]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_FRAME leftover=key-order-paint" s)
      {:green? false :exit 1 :reason :key-order-paint :leftover [:key-order-paint]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_FRAME leftover=colour-miss" s)
      {:green? false :exit 1 :reason :colour-miss :leftover [:colour-miss]}

      :else
      {:green? false :exit 1 :reason :guest-browser-frame-absent
       :leftover [:guest-browser-frame-absent]})))

(defn guest-browser-input-ok?
  "True only when KERNEL.ELF serial says a virtio-tablet press was reduced
  by Kotoba to focus-and-raise of window 1 and the redrawn frame shows it:
  the overlap pixel is now window 1's focused body. A frame that never
  presented does not reach this line."
  [serial]
  (boolean
   (and (string? serial)
        (guest-browser-frame-ok? serial)
        (re-find #"(?m)^AIUEOS_GUEST_BROWSER_INPUT_OK eventq-used=1 kind=pointer-down px=\d+ py=\d+ hit=1 front=1 overlap=ffffff win1-title=d8e7ff" serial)
        (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn guest-browser-input-result
  "Classify a KERNEL.ELF boot for compositor `guest-browser-input`."
  [{:keys [serial qemu-unmeasured? hosted-wm?] :as opts}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured?
      {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}

      (or hosted-wm? (re-find #"AIUEOS_COMPOSITOR_WM_OK" s))
      {:green? false :exit 1 :reason :hosted-wm-does-not-count
       :leftover [:hosted-wm-does-not-count]}

      (not (guest-browser-frame-ok? s))
      (let [r (guest-browser-frame-result opts)]
        (assoc r :reason :no-presented-frame
               :leftover (into [:no-presented-frame] (:leftover r))))

      (guest-browser-input-ok? s)
      {:green? true :exit 0 :reason :guest-browser-pointer-raise
       :leftover [:no-pointer-capture :no-text-raster]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_INPUT leftover=no-pointer-event" s)
      {:green? false :exit 1 :reason :no-pointer-event :leftover [:no-pointer-event]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_INPUT leftover=pointer-miss" s)
      {:green? false :exit 1 :reason :pointer-miss :leftover [:pointer-miss]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_INPUT leftover=raise-not-painted" s)
      {:green? false :exit 1 :reason :raise-not-painted :leftover [:raise-not-painted]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_INPUT leftover=frame-refused" s)
      {:green? false :exit 1 :reason :frame-refused :leftover [:frame-refused]}

      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_INPUT leftover=vector-miss" s)
      {:green? false :exit 1 :reason :vector-miss :leftover [:vector-miss]}

      :else
      {:green? false :exit 1 :reason :guest-browser-input-absent
       :leftover [:guest-browser-input-absent]})))

;; Guest browser desktop with text (ADR-0224). The known answers -- 57 ops,
;; and the count and FNV-1a of the #111111 pixels -- come from a model of the
;; same frame written apart from the Kotoba object and from C.

(def ^:private browser-text-ok-re
  #"(?m)^AIUEOS_GUEST_BROWSER_TEXT_OK ops=70 text-px=1079 hash=89910f34 font-bytes=\d+ surface=1280x800")

(defn guest-browser-text-ok?
  [serial]
  (boolean (and (string? serial) (re-find browser-text-ok-re serial)
                (not (re-find #"AIUEOS_COMPOSITOR_WM_OK" serial)))))

(defn- browser-text-red [s]
  (cond
    (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT leftover=font-absent" s)
    {:green? false :exit 1 :reason :font-absent :leftover [:font-absent]}
    (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT leftover=frame-refused" s)
    {:green? false :exit 1 :reason :frame-refused :leftover [:frame-refused]}
    (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT leftover=present-refused" s)
    {:green? false :exit 1 :reason :present-refused :leftover [:present-refused]}
    (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT leftover=census-miss" s)
    {:green? false :exit 1 :reason :census-miss :leftover [:census-miss]}
    :else
    {:green? false :exit 1 :reason :guest-browser-text-absent
     :leftover [:guest-browser-text-absent]}))

(defn guest-browser-text-result
  [{:keys [serial qemu-unmeasured? hosted-wm?]}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured? {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}
      (or hosted-wm? (re-find #"AIUEOS_COMPOSITOR_WM_OK" s))
      {:green? false :exit 1 :reason :hosted-wm-does-not-count
       :leftover [:hosted-wm-does-not-count]}
      (guest-browser-text-ok? s)
      {:green? true :exit 0 :reason :guest-browser-text
       :leftover [:no-text-edit]}
      :else (browser-text-red s))))

(defn guest-browser-text-raised-result
  "The tablet press raises window 1 over the text frame; its text must now
  cover window 2's entirely (864 text pixels, a different hash)."
  [{:keys [serial qemu-unmeasured? hosted-wm?] :as opts}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured? {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}
      (not (guest-browser-text-ok? s))
      (let [r (guest-browser-text-result opts)]
        (assoc r :reason :no-text-frame
               :leftover (into [:no-text-frame] (:leftover r))))
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT_RAISED_OK hit=1 ops=70 text-px=880 hash=b9f96599" s)
      {:green? true :exit 0 :reason :guest-browser-text-raised
       :leftover [:no-text-edit :no-pointer-capture]}
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT_RAISED leftover=census-miss" s)
      {:green? false :exit 1 :reason :census-miss :leftover [:census-miss]}
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT_RAISED leftover=frame-refused" s)
      {:green? false :exit 1 :reason :frame-refused :leftover [:frame-refused]}
      :else
      {:green? false :exit 1 :reason :no-pointer-event :leftover [:no-pointer-event]})))

;; Guest browser typing (ADR-0225): n i h o n n g o Enter k a Space Enter,
;; typed once by the host, through the Kotoba IME into window 1's body. The
;; census is the model's for that body + にほんご加.

(defn guest-browser-type-result
  [{:keys [serial qemu-unmeasured?] :as opts}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured? {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}
      (not (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TEXT_RAISED_OK hit=1 ops=70 text-px=880 hash=b9f96599" s))
      (let [r (guest-browser-text-raised-result opts)]
        (assoc r :reason :no-raised-text-frame
               :leftover (into [:no-raised-text-frame] (:leftover r))))
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TYPE_OK presses=19 committed=5 ops=75 text-px=1068 hash=a92b8f58" s)
      {:green? true :exit 0 :reason :guest-browser-type
       :leftover [:no-preedit-shown :three-reading-dictionary]}
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TYPE leftover=keys-missing" s)
      {:green? false :exit 1 :reason :keys-missing :leftover [:keys-missing]}
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TYPE leftover=census-miss" s)
      {:green? false :exit 1 :reason :census-miss :leftover [:census-miss]}
      :else
      {:green? false :exit 1 :reason :guest-browser-type-absent
       :leftover [:guest-browser-type-absent]})))

;; Guest browser preedit (ADR-0227): after the typing frame, `k a n` leaves
;; か preedit + `n` romaji drawn underlined after window 1's body; Enter
;; commits かん and the rule goes. Both censuses are
;; os/aiueos/scripts/browser-frame-model.cljk's.

(defn guest-browser-preedit-result
  [{:keys [serial qemu-unmeasured?] :as opts}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured? {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}
      (not (re-find #"(?m)^AIUEOS_GUEST_BROWSER_TYPE_OK presses=19 committed=5 ops=75 text-px=1068 hash=a92b8f58" s))
      (let [r (guest-browser-type-result opts)]
        (assoc r :reason :no-typing-frame :leftover (into [:no-typing-frame] (:leftover r))))
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_PREEDIT_OK shown-ops=67 shown-px=1146 shown-hash=566a1c8f committed=2 ops=77 text-px=1128 hash=193030b3" s)
      {:green? true :exit 0 :reason :guest-browser-preedit
       :leftover [:three-reading-dictionary]}
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_PREEDIT leftover=keys-missing" s)
      {:green? false :exit 1 :reason :keys-missing :leftover [:keys-missing]}
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_PREEDIT leftover=census-miss" s)
      {:green? false :exit 1 :reason :census-miss :leftover [:census-miss]}
      :else
      {:green? false :exit 1 :reason :guest-browser-preedit-absent
       :leftover [:guest-browser-preedit-absent]})))

;; Guest browser IME toggle (ADR-0228): after the preedit commit,
;; Hankaku/Zenkaku (evdev 41) turns the IME off so `k a` lands as latin, a
;; second one turns it on so `k a` Enter commits か. The census is
;; os/aiueos/scripts/browser-frame-model.cljk's.

(defn guest-browser-ime-toggle-result
  [{:keys [serial qemu-unmeasured?] :as opts}]
  (let [s (or serial "")]
    (cond
      qemu-unmeasured? {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}
      (not (re-find #"(?m)^AIUEOS_GUEST_BROWSER_PREEDIT_OK shown-ops=67 shown-px=1146 shown-hash=566a1c8f committed=2 ops=77 text-px=1128 hash=193030b3" s))
      (let [r (guest-browser-preedit-result opts)]
        (assoc r :reason :no-preedit-frame :leftover (into [:no-preedit-frame] (:leftover r))))
      (re-find #"(?m)^AIUEOS_GUEST_BROWSER_IME_TOGGLE_OK presses=7 off=0 latin=2 committed=1 ime=1 ops=80 text-px=1205 hash=322e206e" s)
      {:green? true :exit 0 :reason :guest-browser-ime-toggle
