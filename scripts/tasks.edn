;; nbb scripts/run-task.cljs <task> [args…]
;;
;; Originally generated from bb.edn (ADR-2607173000) and empty ever since; the
;; USB boot profile (ADR-0019) is the first thing registered here. The
;; bare-metal build/smoke chain under os/aiueos/scripts stays as it is — those
;; are the OS's own dependency-minimal build tools (sh + python stdlib only),
;; and pulling them behind nbb would put Node in the boot-evidence path.
{:usb-boot-smoke
 {:cmd ["nbb" "os/aiueos/scripts/smoke-qemu-usb-boot.cljs"]
  :doc "Boot the release image over both transports and require identical evidence."}

 :usb-flash
 {:cmd ["nbb" "os/aiueos/scripts/flash-usb.cljs"]
  :pass-args? true
  :doc "Write the release image to a USB stick. Inspects unless --confirm repeats --device."}

 ;; The multiboot path had a smoke that nothing invoked. That is how a build
 ;; break reached main and sat there: `build-multiboot.sh` compiles
 ;; `kernel/acpi.c`, which since ADR-0024 calls two Kotoba symbols the script did
 ;; not link, so it could not link at all -- and the UEFI smoke never touches it.
 ;; Registering them here does not make anything run them, but it does make them
 ;; findable, which is strictly better than a script nobody knows exists.
 ;;
 ;; `multiboot-smoke` was FLAKY, not red: an inherited 8259 racing the LAPIC
 ;; timer, ~22% failure. Fixed in ADR-0028. Because it was a race, a single
 ;; green run is weak evidence -- count repeat boots if you are checking it.
 :multiboot-build
 {:cmd ["./os/aiueos/scripts/build-multiboot.sh"]
  :doc "Build the Multiboot image. Links kernel/acpi.c and kernel/apic.c, so it needs the same Kotoba objects the UEFI path does."}

 :multiboot-smoke
 {:cmd ["./os/aiueos/scripts/smoke-qemu-multiboot.sh"]
  :doc "Boot the Multiboot image under QEMU. Was ~22% flaky until ADR-0028 (inherited 8259 racing the LAPIC timer); 0/80 failures since. A single green run proves little on a former race -- repeat it."}

 :grub-multiboot-smoke
 {:cmd ["./os/aiueos/scripts/smoke-qemu-grub-multiboot.sh"]
  :doc "Boot the Multiboot image through GRUB. Also never invoked by anything; status unmeasured."}

 ;; ADR-0060. The offline floor ADR-0041 asked for: the same image booted with
 ;; the NIC absent and present, required to differ by exactly the network. It
 ;; is registered here because it is nbb already -- the objection above, that
 ;; putting the sh chain behind nbb would put Node in the boot-evidence path,
 ;; does not apply to a gate that was written in nbb to begin with.
 :offline-floor-smoke
 {:cmd ["nbb" "os/aiueos/scripts/smoke-qemu-offline-floor.cljs"]
  :doc "Boot with and without a NIC and require the difference to be exactly the three network markers. Needs KERNEL.ELF and BOOTX64.EFI built first."}

 ;; SSH passive-open listener (ssh-v1.edn / ADR-0102). Build the SSH kernel
 ;; variant, then boot it and have a real external client complete an inbound
 ;; TCP connection + SSH identification exchange. No crypto -- this proves the
 ;; two blockers under the crypto (no LISTEN, no post-evidence loop) are gone.
 :ssh-build
 {:cmd ["sh" "-c" "AIUEOS_SSH_LISTEN=1 sh os/aiueos/scripts/build-release-image.sh"]
  :doc "Build the release image with the SSH passive-open listener compiled in (AIUEOS_SSH_LISTEN=1). Every other build is byte-for-byte unchanged."}

 :ssh-smoke
 {:cmd ["sh" "-c" "AIUEOS_SSH_LISTEN=1 AIUEOS_TEST_NET=1 AIUEOS_SSH_HOSTFWD=8022 nbb os/aiueos/scripts/smoke-qemu-ssh.cljs"]
  :doc "Boot the SSH kernel and require an external client to complete an inbound TCP connection on :22 and read exactly SSH-2.0-aiueos_0.1, with the kernel's AIUEOS_SSH_LISTEN_OK marker. Needs :ssh-build first."}

 :entropy-smoke
 {:cmd ["sh" "-c" "AIUEOS_SSH_LISTEN=1 AIUEOS_TEST_NET=1 nbb os/aiueos/scripts/smoke-qemu-entropy.cljs"]
  :doc "Boot and require AIUEOS_RANDOM_OK: aiueos_random_bytes delivers two distinct, non-constant 32-byte batches from the persisted virtio-rng. The entropy source an SSH handshake draws from (ADR-0103)."}

 :ecdsa-sign-oracle
 {:cmd ["nbb" "os/aiueos/scripts/ecdsa-sign-oracle.cljs"]
  :doc "The RFC 6979 A.2.5 known answer for ecdsa-p256-sign.kotoba: a BigInt reference proves the sign FORMULA and r||s ABI (ADR-0104)."}

 :ecdsa-sign-object
 {:cmd ["sh" "-c" "cd $(git rev-parse --show-toplevel 2>/dev/null || echo .) && clojure -M -e '(load-file \"os/aiueos/scripts/reproduce-ecdsa-sign-object.clj\")'"]
  :doc "Regenerate os/aiueos/kotoba/ecdsa-p256-sign.o via the pinned toolchain patched for the ecdsa entry + 250M fuel tier (ADR-0105). Needs the amu/kotoba-native git deps."}

 :ecdsa-sign-kat
 {:cmd ["sh" "-c" "AIUEOS_ECDSA_SIGN_KAT=1 AIUEOS_TEST_NET=1 nbb os/aiueos/scripts/smoke-qemu-ecdsa-sign.cljs"]
  :doc "Build the kernel with the sign object linked and require AIUEOS_ECDSA_SIGN_OK: the object reproduces the RFC 6979 A.2.5 signature in a QEMU boot (ADR-0105)."}

 ;; Install chain (install-v1.edn, root ADR adr-2608251418). The installer
 ;; .mjs files are ported, scope-frozen legacy assets from the unmerged
 ;; agent/aiueos-dospara-native-install branch; orchestration and gates are
 ;; nbb per workspace policy.
 :installer-test
 {:cmd ["node" "--test"
        "os/aiueos/installer/test/installer.test.mjs"
        "os/aiueos/installer/test/encrypted-image.test.mjs"
        "os/aiueos/installer/test/encrypted-image-cli.test.mjs"]
  :doc "Ported installer guard/readback and encrypted-image tests. Fake devices and temp files only."}

 :install-chain-test
 {:cmd ["nbb" "os/aiueos/scripts/test-install-chain.cljs"]
  :doc "Intent admission refusals (named reasons), fake-device install, target receipt, repeat-erase refusal, provisioning record placement. Gates I2/I5, offline."}

 :provision-record-test
 {:cmd ["nbb" "os/aiueos/scripts/test-provision-record.cljs"]
  :doc "SSH provisioning record: host key derived to the RFC 8032 vector, authorized key = the intent's, injected-seed and non-ed25519 and tampered-intent refusals. Gate I4 provisioning half, offline."}

 :install-usb-build
 {:cmd ["nbb" "os/aiueos/scripts/run-install-usb-build.cljs"]
  :doc "Create the install intent if missing, then build + verify the install USB image and its chain receipt (gate I1)."}

 :live-installer-build
 {:cmd ["python3" "os/aiueos/scripts/make-live-installer.py" "build"
        "--output-dir" "build/aiueos/live"]
  :doc "Build the live-installer UKI (Debian kernel + thin initramfs mechanism) via docker. Decisions stay in the payload bundle."}

 :install-smoke
 {:cmd ["nbb" "os/aiueos/scripts/smoke-qemu-install.cljs"]
  :doc "Gate I3+I5 under QEMU: USB-live install to a blank NVMe, boot the NVMe twice without the USB, then re-insert the USB and require the erase to be refused with the disk untouched. Needs release image, live UKI, node-linux-x64 and an nbb tree in build/aiueos."}

 :hw-probe-build
 {:cmd ["./os/aiueos/scripts/build-hw-probe.sh"]
  :doc "Build the bounded read-only x86_64 UEFI hardware-probe USB image (gate I6 tooling)."}

 :hw-probe-smoke
 {:cmd ["./os/aiueos/scripts/smoke-qemu-hw-probe.sh"]
  :doc "Boot the hardware probe as removable USB under QEMU/OVMF and require all positive markers."}

 :plc-test
 {:cmd ["./os/aiueos/scripts/test-plc.sh"]
  :doc "Bounded Structured Text frontend, exact I/O safe-state map, timing admission and fail-closed PLC deployment receipt tests."}

 :plc-native-build
 {:cmd ["./os/aiueos/scripts/build-plc-native-program.sh"]
  :pass-args? true
  :doc "Compile a bounded ST program twice to a reproducible static x86_64 AIUEOS user ELF and emit its deployment binding receipt."}

 :plc-rt-qemu-smoke
 {:cmd ["sh" "-c" "AIUEOS_PLC_RT_SMOKE=1 ./os/aiueos/scripts/smoke-qemu-uefi.sh"]
  :doc "Boot the native PLC RT provider and prove APIC-tick release, snapshot input, atomic output and safe-state failures."}}
