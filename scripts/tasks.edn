;; kbb --backend sci scripts/run-task.cljk <task> [args…]
;;
;; Originally generated from bb.edn (ADR-2607173000) and empty ever since; the
;; USB boot profile (ADR-0019) is the first thing registered here. The
;; bare-metal build/smoke chain under os/aiueos/scripts stays as it is — those
;; are the OS's own dependency-minimal build tools (sh + python stdlib only),
;; and pulling them behind nbb would put Node in the boot-evidence path.
{:node-usb-image
 {:cmd ["python3" "os/aiueos/scripts/make-install-usb-image.py" "node-image"]
  :pass-args? true
  :doc "Build a bootable node USB (live UKI + node payload). --live-uki --endpoint --classpath --node-binary --nbb-dir --output."}

 :node-usb-smoke
 {:cmd ["kbb" "--backend" "sci" "--classpath" "../grant/src:../text/src:../sekisho/src"
        "os/aiueos/scripts/smoke-qemu-node-usb.cljk"]
  :pass-args? true
  :doc "Build a stick pointed at a local plane, boot it under OVMF, and require the plane to claim it."}

 :node-boot-test
 {:cmd ["kbb" "--backend" "sci" "--classpath" "../grant/src:../text/src:../sekisho/src"
        "os/aiueos/scripts/node-boot-test.cljk"]
  :pass-args? true
  :doc "Everything the booted stick does after the network is up, without the boot. Both directions."}

 :live-network-smoke
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/smoke-qemu-live-network.cljk"]
  :pass-args? true
  :doc "Boot the live installer under OVMF with and without a NIC; require a lease in one and no-interface in the other."}

 :device-attest-agent
 {:cmd ["kbb" "--backend" "sci" "--classpath" "../grant/src:../text/src"
        "os/aiueos/scripts/device-attest-agent.cljk"]
  :pass-args? true
  :doc "Prove possession of this device's key against a control plane. --did --endpoint --key [--watch]."}

 :device-attest-agent-test
 {:cmd ["kbb" "--backend" "sci" "--classpath" "../grant/src:../text/src"
        "os/aiueos/scripts/device-attest-agent-test.cljk"]
  :doc "Sign the way the agent does, verify the way the Worker does; require every binding to hold."}

 :device-attest-loop-test
 {:cmd ["kbb" "--backend" "sci" "--classpath" "../grant/src:../text/src"
        "os/aiueos/scripts/device-attest-agent-loop-test.cljk" "../grant/src:../text/src"]
  :doc "The whole claim loop against a server that verifies like the plane, in both directions."}

 :usb-boot-smoke
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/smoke-qemu-usb-boot.cljk"]
  :doc "Boot the release image over both transports and require identical evidence."}

 :usb-flash
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/flash-usb.cljk"]
  :pass-args? true
  :doc "Write the release image to a USB stick. Inspects unless --confirm repeats --device."}

 ;; The multiboot path had a smoke that nothing invoked. That is how a build
 ;; break reached main and sat there: `build-multiboot.sh` compiles
 ;; `kernel/acpi.c`, which since ADR-0024 calls two Kotoba symbols the script did
 ;; not link, so it could not link at all -- and the UEFI smoke never touches it.
 ;; Registering them here does not make anything run them, but it does make them
 ;; findable, which is strictly better than a script nobody knows exists.
 ;;
 ;; `multiboot-smoke` was FLAKY, not red: an inherited 8259 racing the LAPIC
 ;; timer, ~22% failure. Fixed in ADR-0028. Because it was a race, a single
 ;; green run is weak evidence -- count repeat boots if you are checking it.
 :multiboot-build
 {:cmd ["./os/aiueos/scripts/build-multiboot.sh"]
  :doc "Build the Multiboot image. Links kernel/acpi.c and kernel/apic.c, so it needs the same Kotoba objects the UEFI path does."}

 :multiboot-smoke
 {:cmd ["./os/aiueos/scripts/smoke-qemu-multiboot.sh"]
  :doc "Boot the Multiboot image under QEMU. Was ~22% flaky until ADR-0028 (inherited 8259 racing the LAPIC timer); 0/80 failures since. A single green run proves little on a former race -- repeat it."}

 :grub-multiboot-smoke
 {:cmd ["./os/aiueos/scripts/smoke-qemu-grub-multiboot.sh"]
  :doc "Boot the Multiboot image through GRUB. Also never invoked by anything; status unmeasured."}

 ;; ADR-0060. The offline floor ADR-0041 asked for: the same image booted with
 ;; the NIC absent and present, required to differ by exactly the network. It
 ;; is registered here because it is nbb already -- the objection above, that
 ;; putting the sh chain behind nbb would put Node in the boot-evidence path,
 ;; does not apply to a gate that was written in nbb to begin with.
 :offline-floor-smoke
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/smoke-qemu-offline-floor.cljk"]
  :doc "Boot with and without a NIC and require the difference to be exactly the three network markers. Needs KERNEL.ELF and BOOTX64.EFI built first."}

;; AArch64 bare-metal boot path (root ADR-2608080600 tracks a1/a2, landed).
;; Gate written in nbb per the 2026-07-14 owner rule. Requires an AArch64
;; toolchain (clang --target=aarch64, aarch64 lld), qemu-system-aarch64 with
;; AAVMF firmware at /usr/share/AAVMF/, and mkfs.vfat/mtools. The x86_64 host
;; that runs the rest of the smoke chain may not have these — status is
;; unmeasured on this Mac until the AAVMF firmware set is provisioned.
 :aarch64-boot-smoke
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/aarch64/smoke-qemu-aarch64-uefi.cljk"]
  :doc "Boot the AArch64 UEFI loader + kernel (loaded from an ESP under AAVMF) and require every AIUEOS_AARCH64_ marker on PL011 serial, with SCTLR_EL1.M actually set, tables from the page allocator, and both W^X directions faulting at the exact ESR class. --expect-fail runs three negative controls. Needs clang/lld(aarch64)/qemu-system-aarch64/AAVMF/mkfs.vfat/mtools."}

 ;; SSH passive-open listener (ssh-v1.edn / ADR-0102). Build the SSH kernel
 ;; variant, then boot it and have a real external client complete an inbound
 ;; TCP connection + SSH identification exchange. No crypto -- this proves the
 ;; two blockers under the crypto (no LISTEN, no post-evidence loop) are gone.
 :ssh-build
 {:cmd ["sh" "-c" "AIUEOS_SSH_LISTEN=1 sh os/aiueos/scripts/build-release-image.sh"]
  :doc "Build the release image with the SSH passive-open listener compiled in (AIUEOS_SSH_LISTEN=1). Every other build is byte-for-byte unchanged."}

 :ssh-smoke
 {:cmd ["sh" "-c" "AIUEOS_SSH_LISTEN=1 AIUEOS_TEST_NET=1 AIUEOS_SSH_HOSTFWD=8022 kbb --backend sci os/aiueos/scripts/smoke-qemu-ssh.cljk"]
  :doc "Boot the SSH kernel and require an external client to complete an inbound TCP connection on :22 and read exactly SSH-2.0-aiueos_0.1, with the kernel's AIUEOS_SSH_LISTEN_OK marker. Needs :ssh-build first."}

 :entropy-smoke
 {:cmd ["sh" "-c" "AIUEOS_SSH_LISTEN=1 AIUEOS_TEST_NET=1 kbb --backend sci os/aiueos/scripts/smoke-qemu-entropy.cljk"]
  :doc "Boot and require AIUEOS_RANDOM_OK: aiueos_random_bytes delivers two distinct, non-constant 32-byte batches from the persisted virtio-rng. The entropy source an SSH handshake draws from (ADR-0103)."}

 :ecdsa-sign-oracle
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/ecdsa-sign-oracle.cljk"]
  :doc "The RFC 6979 A.2.5 known answer for ecdsa-p256-sign.kotoba: a BigInt reference proves the sign FORMULA and r||s ABI (ADR-0104)."}

 :reproduce-objects
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/reproduce-kotoba-objects.cljk"]
  :doc "Recompile every committed Kotoba kernel object from os/aiueos/kotoba/provenance.edn and compare the bytes. Needs --amu <checkout>; or --git-resolve to fetch each object's RECORDED revision; exit 0 all reproduce, 3 any differ, 2 could not run. Turns the recipes' pin from a claim into a measurement."}

 :kernel-object-digests
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/sync-kernel-object-digests.cljk" "--check"]
  :doc "Do build-uefi.sh's pinned object digests still agree with provenance.edn? exit 3 when they do not; --write syncs them from the manifest."}

 :ecdsa-sign-kat
 {:cmd ["sh" "-c" "AIUEOS_ECDSA_SIGN_KAT=1 AIUEOS_TEST_NET=1 kbb --backend sci os/aiueos/scripts/smoke-qemu-ecdsa-sign.cljk"]
  :doc "Build the kernel with the sign object linked and require AIUEOS_ECDSA_SIGN_OK: the object reproduces the RFC 6979 A.2.5 signature in a QEMU boot (ADR-0105)."}

 ;; Install chain (install-v1.edn, root ADR adr-2608251418). The installer
 ;; .mjs files are ported, scope-frozen legacy assets from the unmerged
 ;; agent/aiueos-dospara-native-install branch; orchestration and gates are
 ;; nbb per workspace policy.
 :installer-test
 {:cmd ["node" "--test"
        "os/aiueos/installer/test/installer.test.mjs"
        "os/aiueos/installer/test/encrypted-image.test.mjs"
        "os/aiueos/installer/test/encrypted-image-cli.test.mjs"]
  :doc "Ported installer guard/readback and encrypted-image tests. Fake devices and temp files only."}

 :install-chain-test
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/test-install-chain.cljk"]
  :doc "Intent admission refusals (named reasons), fake-device install, target receipt, repeat-erase refusal, provisioning record placement. Gates I2/I5, offline."}

 :install-intent-admit-contract
 {:cmd ["sh" "-c" "node --stack-size=8000 \"$(command -v nbb)\" --classpath \"$(kbb -Spath -M:verify-admissions):../text/src\" os/aiueos/scripts/verify-admissions.cljk os/aiueos/contracts/install-intent-admit-v1.edn"]
  :doc "The install intent admission DECISION as a Kotoba object (install-intent-admit-v1.edn): 17 vectors, reasons 0-9 all observed, real SHA-256 digests from node:crypto. The cljk CLI keeps JSON/IO; this owns the verdict."}

 :install-intent-parity-test
 {:cmd ["sh" "-c" "node --stack-size=8000 \"$(command -v nbb)\" --classpath \"$(kbb -Spath -M:verify-admissions):../text/src\" os/aiueos/scripts/test-install-intent-parity.cljk"]
  :doc "Parity gate: the same (intent, report, serial) cases through BOTH the production install-intent.cljk CLI and the Kotoba object. A verdict mismatch in either direction fails; a tampered object was measured red (8 FAIL lines) before landing."}

 :install-intent-admit-native
 {:cmd ["sh" "-c" "set -eu; AMU=${AMU:-../amu}; \"$AMU/bin/amu\" compile os/aiueos/kotoba/install-intent-admit.kotoba --source-path os/aiueos/kotoba --unpinned --target x86_64-aiueos-kernel-v1 --output /tmp/iia-gate.o > /dev/null; cmp /tmp/iia-gate.o os/aiueos/kotoba/install-intent-admit.o; python3 os/aiueos/scripts/verify-kotoba-kernel-object.py os/aiueos/kotoba/install-intent-admit.o \"\" kotoba_aiueos_install_intent_admit"]
  :doc "The admission object COMPILES natively (x86_64-aiueos-kernel-v1, kotoba-native 7da60185's allowlist row), is byte-identical to the committed .o (determinism), and passes the kernel-object ABI verifier under its own symbol kotoba_aiueos_install_intent_admit with 0 imports. AMU defaults to ../amu (superproject pin b2a52f48 or newer carries kotoba-native 7da60185); override AMU to point elsewhere."}

 :cfree-wave-1-contracts
 {:cmd ["sh" "-c" "node --stack-size=4000 \"$(command -v nbb)\" --classpath \"$(kbb -Spath -M:verify-admissions):../text/src\" os/aiueos/scripts/verify-admissions.cljk os/aiueos/contracts/inference-status-valid-v1.edn os/aiueos/contracts/inference-milli-tokens-per-second-v1.edn os/aiueos/contracts/model-mapping-plan-v1.edn os/aiueos/contracts/model-handoff-validate-v1.edn os/aiueos/contracts/device-worker-poll-response-v1.edn"]
  :doc "C-free wave 1 (ADR-0219): the five flat-record objects' sources executed in the KIR oracle against records the retained C marshalling packed and verdicts the RETIRED C decisions gave (inference_status.c, model_handoff.c, device_worker_protocol.c at 352c385): 36 + 12 + 18 + 22 + 26 vectors, both verdicts, 35 memory assertions. Under 25 seconds."}

 :cfree-wave-1-native
 {:cmd ["sh" "-c" "set -eu; AMU=${AMU:-../amu}; K=os/aiueos/kotoba; V=os/aiueos/scripts/verify-kotoba-kernel-object.py; T=$(mktemp -d); for pair in inference-status-valid.kotoba:inference-status-valid.o:kotoba_aiueos_inference_status_valid inference-milli-tokens-per-second.kotoba:inference-milli-tokens-per-second.o:kotoba_aiueos_inference_milli_tokens_per_second aiueos/model_mapping_plan.kotoba:model-mapping-plan.o:kotoba_aiueos_model_mapping_plan device-worker-poll-response.kotoba:device-worker-poll-response.o:kotoba_aiueos_device_worker_poll_response; do src=${pair%%:*}; rest=${pair#*:}; obj=${rest%%:*}; sym=${rest#*:}; \"$AMU/bin/amu\" compile $K/$src --target x86_64-aiueos-kernel-v1 --output $T/$obj --jvm-free > /dev/null; cmp $T/$obj $K/$obj; python3 $V $K/$obj \"\" $sym; done; \"$AMU/bin/amu\" compile $K/model-handoff-validate.kotoba --source-path $K --unpinned --target x86_64-aiueos-kernel-v1 --output $T/model-handoff-validate.o > /dev/null; cmp $T/model-handoff-validate.o $K/model-handoff-validate.o; python3 $V $K/model-handoff-validate.o \"\" kotoba_aiueos_model_handoff_validate; echo AIUEOS_CFREE_WAVE_1_NATIVE_OK objects=5"]
  :doc "C-free wave 1 (ADR-0219): the five objects COMPILE natively (x86_64-aiueos-kernel-v1, kotoba-native a6a4616's allowlist rows) by the recipe the provenance manifest records (single-file --jvm-free for four, --source-path project route for model-handoff-validate, which requires aiueos.model-mapping-plan), are byte-identical to the committed .o (determinism), and pass the kernel-object ABI verifier under their own symbols with 0 imports. AMU defaults to ../amu; override AMU to point elsewhere."}

 :guided-install-test
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/test-guided-install.cljk"]
  :doc "Guided installer (ADR-0208): answer-file refusals by named reason, the screen walk, the derived match on both capacity boundaries, and the intent the guided run writes handed to the real install-intent.cljk verify. 53 cases, offline, no block device."}

 :provision-record-test
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/test-provision-record.cljk"]
  :doc "SSH provisioning record: host key derived to the RFC 8032 vector, authorized key = the intent's, injected-seed and non-ed25519 and tampered-intent refusals. Gate I4 provisioning half, offline."}

 :install-bundle-test
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/test-install-bundle.cljk"]
  :doc "The install USB bundle EXECUTED, not merely built (ADR-0209/0210): assemble both products, extract them, run every bundled entry point from inside them, and drive the real guided handover on a stick that carries no intent. Controls: without the classpath nothing loads; a stick that carries an intent never asks. 34 cases, offline."}

 ;; The node stick: Ubuntu Server plus the agent, which is the route that
 ;; produced a working node when the bespoke initramfs lost to hardware. These
 ;; three were unregistered until ADR-0214 -- the tooling existed and the task
 ;; registry, which is how anything here is found and run, did not mention it.

 :node-agent-bundle
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/make-node-agent-bundle.cljk"]
  :pass-args? true
  :doc "Pack the node agent (what decides something, plus a runtime to decide it with) for installation onto a Linux that already boots. Needs --node and --nbb; carries grant.device-attest and sekisho.didkey rather than restating them."}

 :node-installer-build
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/make-node-installer.cljk"]
  :pass-args? true
  :doc "Build the node install stick for ONE NAMED BOX from contracts/node-machines-v1.edn (ADR-0214). --machine <id> --iso <ubuntu.iso> --ssh-key <pub>. Storage is interactive unless that box's disk serial is MEASURED; --unattended demands it and refuses otherwise. --dry-run prints the plan and the builder argv."}

 :node-machine-probe-record
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/record-node-machine-probe.cljk"]
  :pass-args? true
  :doc "Turn the hardware record a box wrote about itself (/var/log/aiueos-node-hwprobe.txt) into :measured fields in the machine registry. --machine <id> --probe <file>. Writes only fields the probe actually carries; refuses the file rather than recording a measured nil."}

 :node-installer-test
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/test-node-installer.cljk"]
  :doc "The per-machine node installer (ADR-0214), offline: the registry typed rather than parsed, every driver and ingest refusal by named reason, the probe block EXECUTED and parsed, and the loop closed -- ingest a probe into a registry copy, then require the driver to build the unattended stick with the serial it carried. 55 cases, no ISO, no block device."}

 :install-usb-build
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/run-install-usb-build.cljk"]
  :doc "Build + verify the install USB image and its chain receipt (gate I1). Pass --guided for the stick that carries no intent and asks at the machine (ADR-0210); otherwise an intent must already exist and is never auto-created."}

 :live-installer-build
 {:cmd ["python3" "os/aiueos/scripts/make-live-installer.py" "build"
        "--output-dir" "build/aiueos/live"]
  :doc "Build the live-installer UKI (Debian kernel + thin initramfs mechanism) via docker. Decisions stay in the payload bundle."}

 :install-smoke
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/smoke-qemu-install.cljk"]
  :doc "Gate I3+I5 under QEMU: USB-live install to a blank NVMe, boot the NVMe twice without the USB, then re-insert the USB and require the erase to be refused with the disk untouched. Needs release image, live UKI, node-linux-x64 and an nbb tree in build/aiueos."}

 :hw-probe-build
 {:cmd ["./os/aiueos/scripts/build-hw-probe.sh"]
  :doc "Build the bounded read-only x86_64 UEFI hardware-probe USB image (gate I6 tooling)."}

 :hw-probe-smoke
 {:cmd ["./os/aiueos/scripts/smoke-qemu-hw-probe.sh"]
  :doc "Boot the hardware probe as removable USB under QEMU/OVMF and require all positive markers."}

 :plc-test
 {:cmd ["./os/aiueos/scripts/test-plc.sh"]
  :doc "Bounded Structured Text frontend, exact I/O safe-state map, timing admission and fail-closed PLC deployment receipt tests."}

 :plc-native-build
 {:cmd ["./os/aiueos/scripts/build-plc-native-program.sh"]
  :pass-args? true
  :doc "Compile a bounded ST program twice to a reproducible static x86_64 AIUEOS user ELF and emit its deployment binding receipt."}

 :plc-rt-qemu-smoke
 {:cmd ["sh" "-c" "AIUEOS_PLC_RT_SMOKE=1 ./os/aiueos/scripts/smoke-qemu-uefi.sh"]
  :doc "Boot the receipt-bound PLC ELF at CPL3 and prove fixed-priority preemption, APIC release, atomic output and safe-state failures."}

 :os-coverage
 {:cmd ["sh" "-c" "kbb --backend sci os/aiueos/scripts/os-coverage.cljk build/aiueos/*.log"]
  :doc "Score the last smoke's coverage against ALL of its evidence logs. Registered 2026-09-10 because there was no canonical invocation and picking one log silently lowers the number: measured, kernel-serial.log alone scores CORE 63/117 while the same boot's four logs score 66/117 -- ACPI_RETAIN, KERNEL and LOADER_INTEGRITY are the loader's markers and go to uefi-debug.log."}

 :relay-parity
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/relay-protocol-c-kotoba-parity.cljk"]
  :doc "native/relay_{line,text}.kotoba (the template pair) and the HELLO line the retired kernel/relay_protocol.c produced, as recorded in contracts/relay-hello-v1.edn, are the same bytes; stays red if either is edited alone (ADR-0213, ADR-0215)."}

 :relay-line-verify
 {:cmd ["sh" "-c" "node --stack-size=4000 \"$(command -v nbb)\" --classpath \"$(kbb -Spath -M:verify-admissions):../text/src\" os/aiueos/scripts/verify-admissions.cljk os/aiueos/contracts/relay-hello-v1.edn os/aiueos/contracts/relay-ack-valid-v1.edn"]
  :doc "Execute the two relay kernel objects' sources in the KIR oracle against the bytes and verdicts kernel/relay_protocol.c produced before its retirement (ADR-0215): 6 HELLO vectors incl. the capacity boundary 90/91, 8 ACK vectors incl. both verdicts. Under a second."}

 :plc-rt-policy-reproduce
 {:cmd ["./os/aiueos/scripts/reproduce-plc-rt-policy-objects.sh"]
  :pass-args? true
  :doc "Reproduce the linked fixed-priority policy and PLC-specific C-free ELF admission objects with their exact measured Amu revisions."}

 :target-parity-icount
 {:cmd ["kbb" "--backend" "sci" "os/aiueos/scripts/smoke-qemu-target-parity-icount.cljk"]
  :pass-args? true
  :doc "Takes /path/to/amu. Measure that x86_64-linux and x86_64-aiueos-kernel-v1 emit the same bytes for one source, and count them under -icount as guest instructions rather than host time (ADR-0211)."}}
