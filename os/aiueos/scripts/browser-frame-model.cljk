#!/usr/bin/env kbb
;; A model of the guest browser desktop frame (ADR-0224 .. 0233), written
;; apart from browser-frame2.kotoba and from the C blit, so a gate's known
;; answers do not come from the thing the gate measures.
;;
;;   kbb --backend sci os/aiueos/scripts/browser-frame-model.cljk [font.fnt]
;;   kbb --backend sci os/aiueos/scripts/browser-frame-model.cljk --ops <scene.edn> <font>
;;
;; The second form prints the op count and the op list as the object would
;; write it at word 480 (kind x y a b rgb, u32 LE) for one scene, or one line
;; per scene for a vector of them -- how the
;; success vectors of os/aiueos/contracts/browser-frame2-v1.edn got their
;; expected memory.
;;
;; It lays out a surface by the rules in browser-frame2.kotoba's header (read
;; as prose, not code), paints the ops as aiueos_desktop_present_ops2 does
;; (rects fill, glyph bits set in the op's colour, later ops over earlier),
;; and prints for each named scene the op count and the #111111 census that
;; aiueos_desktop_colour_census would report: the count, and FNV-1a over each
;; pixel's position (y * 65536 + x, four little-endian bytes) in raster order.
;;
;; The scenes marked :pinned are frames already pinned on KERNEL.ELF serial
;; (ADR-0224, 0225, 0227, 0228, 0229, 0230; re-pinned with the caret by ADR-0232); the model must reproduce them before its other
;; answers are used. Exit 0 all pinned scenes reproduced, 1 one did not, 2 could not
;; run (font unreadable).
(ns browser-frame-model
  (:require [clojure.edn :as edn]
            ["node:fs" :as fs]))

(defn- die [code msg] (.error js/console msg) (.exit js/process code))

(def ^:private args (vec (remove #(= "--" %) *command-line-args*)))
(def ^:private ops-mode? (= "--ops" (first args)))
(def ^:private font-path
  (or (if ops-mode? (get args 2) (first args)) "os/aiueos/fonts/aiueos-16.fnt"))

(def ^:private font
  (try (.readFileSync fs font-path) (catch :default e (die 2 (str "COULD-NOT-RUN font " font-path ": " e)))))

(defn- u32 [i] (.readUInt32LE font (* 4 i)))
(def ^:private glyphs (u32 2))

(def ^:private index
  ;; code point -> [glyph index, width]
  (into {} (for [i (range glyphs)
                 :let [e (u32 (+ 4 i))]]
             [(bit-and e 16777215) [i (if (> e 16777215) 16 8)]])))

(defn- glyph [cp] (or (index cp) (index 65533)))

(defn- bits [gi]
  ;; positions [dx dy] of the set bits of glyph gi
  (let [base (+ 16 (* 4 glyphs) (* 32 gi))]
    (for [row (range 16)
          :let [line (bit-or (bit-shift-left (aget font (+ base (* 2 row))) 8)
                             (aget font (+ base (* 2 row) 1)))]
          col (range 16)
          :when (pos? (bit-and line (unsigned-bit-shift-right 32768 col)))]
      [col row])))

;; --- layout -------------------------------------------------------------------

(def ^:private ink 0x111111)

(defn- lay-line
  "Lay code points from cursor [x y]; returns {:ops :x :y}. Wrap at `right`
  (or stop, when wrap? is false), skip glyphs whose foot passes `bottom`.
  With underline? every drawn glyph gets a 1 px rule under it."
  [{:keys [x y left right bottom wrap? underline?]} cps]
  (loop [cps cps x x y y ops []]
    (if-let [cp (first cps)]
      (if (= cp 10)
        (recur (rest cps) left (+ y 20) ops)
        (let [[gi gw] (glyph cp)
              cross? (> (+ x gw) right)]
          (if (and cross? (not wrap?))
            {:ops ops :x x :y y}
            (let [[x y] (if cross? [left (+ y 20)] [x y])
                  drawn? (<= (+ y 16) bottom)
                  ops (if drawn?
                        (cond-> (conj ops [:glyph x y gi gw])
                          underline? (conj [:rect x (+ y 17) gw 1 ink]))
                        ops)]
              (recur (rest cps) (+ x gw) y ops)))))
      {:ops ops :x x :y y})))

(defn- launcher
  "ADR-0233: with an app register (:apps, bit k-1 = app k), the launcher row
  under every window -- #edf0f5 across the top 28 px -- and one #e4e8ef
  96 x 24 button per registered app at x 6 + 102(k-1), y 2, its title
  (:titles k) from (x + 6, 6), one line, clipped at x + 90."
  [{:keys [vw apps titles]}]
  (when (pos? (or apps 0))
    (into [[:rect 0 0 vw 28 0xedf0f5]]
          (mapcat (fn [k]
                    (let [x (+ 6 (* 102 (dec k)))]
                      (when (pos? (bit-and apps (bit-shift-left 1 (dec k))))
                        (into [[:rect x 2 96 24 0xe4e8ef]]
                              (:ops (lay-line {:x (+ x 6) :y 6 :left (+ x 6) :right (+ x 90)
                                               :bottom 28 :wrap? false}
                                              (take 32 (get titles k))))))))
                  [1 2 3 4]))))

(defn frame
  "Ops for a scene: {:vw :vh :focus :stack [{:id :x :y :w :h :title :body}]
  :composition [cp ...] :apps register :titles {k [cp ...]}} (stack bottom first)."
  [{:keys [vw vh focus stack composition apps] :as scene}]
  (into (into [[:rect 0 0 vw vh 0xf5f6f8]] (launcher scene))
        (mapcat
         (fn [{:keys [id x y w h title body]}]
           (let [f? (= id focus)
                 ;; ADR-0233: a close control in windows at least 40 wide
                 ;; when there is an app register; the title then stops 4 px
                 ;; before it.
                 chrome? (and (pos? (or apps 0)) (>= w 40))
                 t (lay-line {:x (+ x 8) :y (+ y 6) :left (+ x 8)
                              :right (- (+ x w) (if chrome? 28 8))
                              :bottom (+ y 28) :wrap? false} (take 32 title))
                 [xi xw] (glyph 215)
                 close (when chrome?
                         [[:rect (- (+ x w) 24) (+ y 6) 16 16 0xe4e8ef]
                          [:glyph (+ (- (+ x w) 24) (quot (- 16 xw) 2)) (+ y 6) xi xw]])
                 b (lay-line {:x (+ x 8) :y (+ y 36) :left (+ x 8) :right (- (+ x w) 8)
                              :bottom (- (+ y h) 8) :wrap? true} (take 64 body))
                 c (when (and f? (seq composition))
                     (lay-line {:x (:x b) :y (:y b) :left (+ x 8) :right (- (+ x w) 8)
                                :bottom (- (+ y h) 8) :wrap? true :underline? true}
                               composition))
                 ;; ADR-0232: the focused window's caret, cssom sel-ops'
                 ;; collapsed selection -- 1 x 16 in the text colour, where
                 ;; the next glyph would go (after the composition, if any);
                 ;; not drawn when its foot passes the bottom inset.
                 [cx cy] (if c [(:x c) (:y c)] [(:x b) (:y b)])
                 caret (when (and f? (<= (+ cy 16) (- (+ y h) 8)))
                         [[:rect cx cy 1 16 ink]])]
             (concat [[:rect x y w h (if f? 0xffffff 0xeef1f5)]
                      [:rect x y w 28 (if f? 0xd8e7ff 0xdde2ea)]]
                     (:ops t) close (:ops b) (:ops c) caret))))
        stack))

;; --- paint and census -----------------------------------------------------------

(defn census [ops]
  (let [ink-px (reduce
                (fn [px [k x y a b c]]
                  (case k
                    :rect (if (= c ink)
                            (into px (for [yy (range y (+ y b)) xx (range x (+ x a))] (+ (* yy 65536) xx)))
                            (into #{} (remove (fn [p] (let [py (quot p 65536) pxx (mod p 65536)]
                                                        (and (<= x pxx) (< pxx (+ x a)) (<= y py) (< py (+ y b)))))
                                              px)))
                    :glyph (into px (for [[dx dy] (bits a) :when (< dx b)] (+ (* (+ y dy) 65536) (+ x dx))))))
                #{} ops)
        h (reduce (fn [h p]
                    (reduce (fn [h b]
                              (let [h (bit-xor h (bit-and (unsigned-bit-shift-right p (* 8 b)) 255))]
                                (unsigned-bit-shift-right (js/Math.imul h 16777619) 0)))
                            h (range 4)))
                  2166136261 (sort ink-px))]
    {:ops (count ops) :text-px (count ink-px)
     :hash (.padStart (.toString (unsigned-bit-shift-right h 0) 16) 8 "0")}))

;; --- the kernel's scenes (os/aiueos/kernel/main.c, ADR-0224 .. 0227) ---------------

(def ^:private w1 {:id 1 :x 32 :y 32 :w 720 :h 540
                   :title [97 105 117 101 111 115]
                   :body [107 111 116 111 98 97 45 108 97 110 103 47 98 114 111 119 115 101 114 10
                          12502 12521 12454 12470 12364 30011 38754 12391 12377]})
(def ^:private w2 {:id 2 :x 96 :y 72 :w 640 :h 480
                   :title [12502 12521 12454 12470]
                   :body [26085 26412 35486 12398 25991 23383 12418 34920 31034 12391 12365 12414 12377 12290]})
(def ^:private nihongo-ka [12395 12411 12435 12372 21152])

(def scenes
  [{:name "text" :pinned {:ops 58 :text-px 1100 :hash "4ab25516"}
    :scene {:vw 1280 :vh 800 :focus 2 :stack [w1 w2]}}
   {:name "text-raised" :pinned {:ops 58 :text-px 880 :hash "ca6c2709"}
    :scene {:vw 1280 :vh 800 :focus 1 :stack [w2 w1]}}
   {:name "typed" :pinned {:ops 63 :text-px 1068 :hash "b741bf74"}
    :scene {:vw 1280 :vh 800 :focus 1 :stack [w2 (update w1 :body into nihongo-ka)]}}
   ;; ADR-0227: after typing `k a n`, the composition か + romaji n is drawn,
   ;; underlined, after the body; Enter commits かん and the rule is gone.
   {:name "preedit" :pinned {:ops 67 :text-px 1146 :hash "04d93a5f"}
    :scene {:vw 1280 :vh 800 :focus 1 :stack [w2 (update w1 :body into nihongo-ka)]
            :composition [12363 110]}}
   {:name "preedit-committed" :pinned {:ops 65 :text-px 1128 :hash "e67d620b"}
    :scene {:vw 1280 :vh 800 :focus 1 :stack [w2 (update w1 :body into (concat nihongo-ka [12363 12435]))]}}
   ;; ADR-0228: Hankaku/Zenkaku turns the IME off, `k a` goes in as latin,
   ;; Hankaku/Zenkaku turns it back on, `k a` Enter commits か.
   {:name "ime-toggle" :pinned {:ops 68 :text-px 1205 :hash "f516238a"}
    :scene {:vw 1280 :vh 800 :focus 1
            :stack [w2 (update w1 :body into (concat nihongo-ka [12363 12435] [107 97 12363]))]}}
   ;; ADR-0229: a titlebar press at (60, 50), moves to (140, 90) (220, 120)
   ;; (300, 150), release: window 1 is dragged by (240, 100) to (272, 132).
   {:name "drag" :pinned {:ops 68 :text-px 1947 :hash "a2969186"}
    :scene {:vw 1280 :vh 800 :focus 1
            :stack [w2 (-> w1
                           (update :body into (concat nihongo-ka [12363 12435] [107 97 12363]))
                           (assoc :x 272 :y 132))]}}
   ;; ADR-0230: a press in window 1's resize handle at (984, 664), moves to
   ;; (784, 564) (300, 200 -- clamped at 120 x 80) (504, 324), release:
   ;; window 1 is 240 x 200 at (272, 132), and its body wraps at the new width.
   {:name "resize" :pinned {:ops 68 :text-px 1947 :hash "4fa3baa2"}
    :scene {:vw 1280 :vh 800 :focus 1
            :stack [w2 (-> w1
                           (update :body into (concat nihongo-ka [12363 12435] [107 97 12363]))
                           (assoc :x 272 :y 132 :w 240 :h 200))]}}])

;; ADR-0231: the event loop. After the resize, one running loop takes k a Enter
;; (window 1), a press on window 2's titlebar at (150, 85), a move to
;; (250, 185), a release, then n i Enter (window 2), and presents a frame after
;; each of the nine. These are the nine frames, in order.
(def ^:private w1r (-> w1
                       (update :body into (concat nihongo-ka [12363 12435] [107 97 12363]))
                       (assoc :x 272 :y 132 :w 240 :h 200)))
(def ^:private w1k (update w1r :body conj 12363))
(def ^:private w2m (assoc w2 :x 196 :y 172))

(def loop-frames
  [["k" {:vw 1280 :vh 800 :focus 1 :stack [w2 w1r] :composition [107]}]
   ["a" {:vw 1280 :vh 800 :focus 1 :stack [w2 w1r] :composition [12363]}]
   ["enter" {:vw 1280 :vh 800 :focus 1 :stack [w2 w1k]}]
   ["down" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2]}]
   ["move" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2m]}]
   ["up" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2m]}]
   ["n" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2m] :composition [110]}]
   ["i" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2m] :composition [12395]}]
   ["enter" {:vw 1280 :vh 800 :focus 2 :stack [w1k (update w2m :body conj 12395)]}]])

;; ADR-0232: the caret. After the loop, window 2 is focused with に committed.
;; k a composes か (the caret after it), Backspace drops the preedit (the
;; caret back after the body), and two more Backspaces delete に and 。 -- the
;; code points before the caret (browser.text-edit delete-backward).
(def ^:private w2n (update w2m :body conj 12395))

(def caret-frames
  [["k" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2n] :composition [107]}]
   ["a" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2n] :composition [12363]}]
   ["backspace" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2n]}]
   ["backspace" {:vw 1280 :vh 800 :focus 2 :stack [w1k w2m]}]
   ["backspace" {:vw 1280 :vh 800 :focus 2 :stack [w1k (update w2m :body pop)]}]])

;; ADR-0233: launcher and close. After the caret, the host registers apps 1 2
;; 3 (window 3's title メモ and body ランチャーから開きました are its slot's)
;; and sends eight tablet events: a press on launcher button 3 at (258, 14),
;; release, a press on window 3's close control at (584, 94), release, the
;; launcher again, release, a press on window 2's close control at (820, 186),
;; release. A frame after each.
(def ^:private w2c (update w2m :body pop))
(def ^:private w3 {:id 3 :x 80 :y 80 :w 520 :h 360
                   :title [12513 12514]
                   :body [12521 12531 12481 12515 12540 12363 12425 38283 12365 12414 12375 12383]})
(def ^:private shell {:vw 1280 :vh 800 :apps 7
                      :titles {1 (:title w1) 2 (:title w2) 3 (:title w3)}})

(def launch-frames
  [["launch" (assoc shell :focus 3 :stack [w1k w2c w3])]
   ["up" (assoc shell :focus 3 :stack [w1k w2c w3])]
   ["close-3" (assoc shell :focus 2 :stack [w1k w2c])]
   ["up" (assoc shell :focus 2 :stack [w1k w2c])]
   ["launch" (assoc shell :focus 3 :stack [w1k w2c w3])]
   ["up" (assoc shell :focus 3 :stack [w1k w2c w3])]
   ["close-2" (assoc shell :focus 3 :stack [w1k w3])]
   ["up" (assoc shell :focus 3 :stack [w1k w3])]])

(defn chain
  "FNV-1a over each frame's census hash (u32, little-endian), in order -- what
  the kernel folds as it presents the loop's frames."
  [hashes]
  (let [h (reduce (fn [h v]
                    (reduce (fn [h b]
                              (let [h (bit-xor h (bit-and (unsigned-bit-shift-right v (* 8 b)) 255))]
                                (unsigned-bit-shift-right (js/Math.imul h 16777619) 0)))
                            h (range 4)))
                  2166136261 hashes)]
    (.padStart (.toString (unsigned-bit-shift-right h 0) 16) 8 "0")))

(defn- op-hex [[k x y a b c]]
  (let [buf (js/Buffer.alloc 24)
        words (if (= k :rect) [1 x y a b c] [2 x y a b ink])]
    (doseq [[i v] (map-indexed vector words)] (.writeUInt32LE buf v (* 4 i)))
    (.toString buf "hex")))

(if ops-mode?
  (let [in (edn/read-string (str (.readFileSync fs (get args 1))))]
    ;; one scene, or a vector of scenes: one line each
    (doseq [scene (if (map? in) [in] in)
            :let [ops (frame scene)]]
      (println (count ops) (apply str (map op-hex ops)))))
(let [results (for [{:keys [name pinned scene]} scenes
                    :let [c (census (frame scene))]]
                (do (println (str name " ops=" (:ops c) " text-px=" (:text-px c) " hash=" (:hash c)
                                  (cond (nil? pinned) ""
                                        (= pinned c) " pinned=reproduced"
                                        :else (str " pinned=MISMATCH " pinned))))
                    (or (nil? pinned) (= pinned c))))]
  (when-not (every? true? (doall results)) (.exit js/process 1))
  (let [cs (map-indexed (fn [i [ev scene]]
                          (let [c (census (frame scene))]
                            (println (str "loop-frame n=" (inc i) " " ev " ops=" (:ops c)
                                          " text-px=" (:text-px c) " hash=" (:hash c)))
                            c))
                        loop-frames)
        cs (vec cs)]
    (println (str "loop frames=" (count cs) " ops=" (apply str (interpose "," (map :ops cs)))
                  " chain=" (chain (map #(js/parseInt (:hash %) 16) cs))
                  " last-px=" (:text-px (peek cs)) " last-hash=" (:hash (peek cs)))))
  (let [cs (vec (map-indexed (fn [i [ev scene]]
                               (let [ops (frame scene)
                                     c (census ops)
                                     [_ cx cy] (peek ops)]
                                 (println (str "caret-frame n=" (inc i) " " ev " ops=" (:ops c)
                                               " text-px=" (:text-px c) " hash=" (:hash c)
                                               " caret=" cx "," cy))
                                 c))
                             caret-frames))]
    (println (str "caret frames=" (count cs) " ops=" (apply str (interpose "," (map :ops cs)))
                  " chain=" (chain (map #(js/parseInt (:hash %) 16) cs))
                  " last-px=" (:text-px (peek cs)) " last-hash=" (:hash (peek cs)))))
  (let [cs (vec (map-indexed (fn [i [ev scene]]
                               (let [c (census (frame scene))]
                                 (println (str "launch-frame n=" (inc i) " " ev " ops=" (:ops c)
                                               " text-px=" (:text-px c) " hash=" (:hash c)))
                                 c))
                             launch-frames))]
    (println (str "launch frames=" (count cs) " ops=" (apply str (interpose "," (map :ops cs)))
                  " chain=" (chain (map #(js/parseInt (:hash %) 16) cs))
                  " last-px=" (:text-px (peek cs)) " last-hash=" (:hash (peek cs)))))))
