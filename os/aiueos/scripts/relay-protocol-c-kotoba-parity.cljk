#!/usr/bin/env nbb
;; kernel/relay_protocol.c and native/relay_{line,text}.kotoba are TWO
;; implementations of one wire protocol, and both are live: the C is compiled
;; into the UEFI kernel by build-uefi.sh and called from pci.c:4038 and :4109,
;; while the Kotoba pair serves debug_link.kotoba and murakumo-join-plan.kotoba.
;;
;; That is the state ADR-0212's conversion order has to resolve, and the first
;; thing it needs is evidence that retiring the C changes no byte on the wire.
;; This is that evidence, and it is also a drift alarm until the retirement
;; happens: if either side is edited alone, this goes red.
;;
;; The comparison masks the two VARIABLE fields (boot=, mac=) because the
;; Kotoba side stores a skeleton and overwrites them in place, so a template
;; carries '0' where the C carries a value. Everything outside those two spans
;; -- the banner, the separators, the profile suffix, and the total length --
;; is compared byte for byte.
;;
;; Usage: nbb os/aiueos/scripts/relay-protocol-c-kotoba-parity.cljk
(ns relay-protocol-c-kotoba-parity
  (:require ["child_process" :as cp] ["fs" :as fs] ["os" :as os] ["path" :as path]))

(def repo (path/resolve (path/join (path/dirname *file*) ".." ".." "..")))
(def aiueos (path/join repo "os" "aiueos"))
(def kernel (path/join aiueos "kernel"))
(def relay-text (path/join aiueos "native" "relay_text.kotoba"))

;; "AIUEOS_NODE_HELLO_V1 boot=" is 26 bytes, then 16 hex; " mac=" is 5, then 17.
(def boot-span [26 42])
(def mac-span [47 64])
(def hello-kind 0)

(defn die [code & msg]
  (js/console.error (apply str msg))
  (js/process.exit code))

(defn template-words
  "The packed i64 words of template `kind` from the generated Kotoba source.

  relay_text.kotoba is generated and stores each line as ASCII packed eight
  bytes to an i64, low byte first, inside a nest of `(if (= index N) <word>`.
  Reading the words rather than the comment above them is deliberate: the
  comment is prose and the words are what the board transmits."
  [kind]
  (let [text (fs/readFileSync relay-text "utf8")
        block (second (re-find (re-pattern (str "\\(if \\(= kind " kind "\\)([\\s\\S]*?)\\n\\n"))
                               text))]
    (when-not block
      (die 2 "REFUSED: no template block for kind " kind " in " relay-text))
    (let [ws (map #(js/BigInt (second %))
                  (re-seq #"\(if \(= index \d+\) (\d+)" block))]
      (when (empty? ws)
        (die 2 "REFUSED: template block for kind " kind " parsed to zero words"))
      ws)))

(defn words->bytes [words]
  (js/Buffer.from
   (into-array
    (for [w words
          i (range 8)
          :let [c (js/Number (js/BigInt.asUintN 8 (/ w (js/BigInt (js/Math.pow 2 (* 8 i))))))]
          :when (pos? c)]
      c))))

(defn mask
  "Overwrite the variable spans with '0', the byte the skeleton carries."
  [buf]
  (let [copy (js/Buffer.from buf)]
    (doseq [[from to] [boot-span mac-span]
            i (range from to)]
      (aset copy i 48))
    copy))

(defn c-oracle
  "Compile relay_protocol.c standalone and print the bytes it produces.

  It is layer 0 in ADR-0212's symbol graph -- it references no symbol another
  .c defines -- so it links with nothing else, which is why this can run here
  rather than needing a kernel build."
  [out]
  (let [src (path/join out "oracle.c")
        bin (path/join out "oracle")]
    (fs/writeFileSync src (str "#include <stdio.h>\n#include <stdint.h>\n"
                               "#include \"relay_protocol.h\"\n"
                               "int main(void){uint8_t o[AIUEOS_RELAY_HELLO_CAPACITY];\n"
                               "const uint8_t m[6]={0x70,0x70,0xfc,0x0b,0xb6,0x31};\n"
                               "uint32_t n=aiueos_relay_hello_payload(o,sizeof o,"
                               "0x0123456789abcdefULL,m);\n"
                               "for(uint32_t i=0;i<n;i++)printf(\"%02x\",o[i]);\n"
                               "return 0;}\n"))
    (let [c (cp/spawnSync "cc" #js ["-O2" "-I" kernel "-o" bin src
                                    (path/join kernel "relay_protocol.c")]
                          #js {:encoding "utf8"})]
      (when-not (zero? (.-status c))
        (die 2 "REFUSED: could not build the C oracle:\n" (.-stderr c))))
    (let [r (cp/spawnSync bin #js [] #js {:encoding "utf8"})]
      (when-not (zero? (.-status r))
        (die 2 "REFUSED: the C oracle did not run"))
      (js/Buffer.from (.trim (.-stdout r)) "hex"))))

(defn -main []
  (let [out (fs/mkdtempSync (path/join (os/tmpdir) "relay-parity-"))
        kot (words->bytes (template-words hello-kind))
        c (c-oracle out)
        masked (mask c)
        agree? (zero? (.compare js/Buffer masked kot))
        ;; Discrimination, every run. A comparison that has only ever agreed is
        ;; indistinguishable from one that always agrees.
        flipped (let [b (js/Buffer.from c)] (aset b (dec (.-length b)) 88) (mask b))
        in-field (let [b (js/Buffer.from c)] (aset b 30 57) (mask b))
        neg-fixed (zero? (.compare js/Buffer flipped kot))
        neg-var (zero? (.compare js/Buffer in-field kot))]
    (println (str "RELAY-PARITY c-bytes=" (.-length c)
                  " kotoba-bytes=" (.-length kot)
                  " agree=" agree?))
    (println (str "  C     " (pr-str (.toString c "utf8"))))
    (println (str "  kotoba" (pr-str (.toString kot "utf8"))))
    (println (str "DISCRIMINATES fixed-byte-flipped=" neg-fixed " (false required)"
                  " variable-field-changed=" neg-var " (true required)"))
    (println "SCANNED 3")
    (if (and agree? (not neg-fixed) neg-var)
      (do (println "RELAY-PARITY-OK the C and the Kotoba template are the same wire format")
          (js/process.exit 0))
      (do (js/console.error "FAIL the two relay implementations disagree")
          (js/process.exit 1)))))

(-main)
