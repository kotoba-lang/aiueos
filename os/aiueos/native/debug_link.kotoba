(ns native.debug-link
  ;; Gate: LAN2 (bus3, bar-b) debug console. The K16 has two RTL8125BG;
  ;; bus2/bar-a carries the PXE stream profile, bus3/bar-b is wired to the
  ;; Mac's second NIC (en8) as the debug/control plane.
  ;;
  ;; This module owns a MINIMAL raw-Ethernet UDP TX on bus3: a fixed
  ;; 10.10.10.<k16>:9000 log the Mac receives with
  ;;   socat -u UDP-RECV:9000,reuseaddr -
  ;;
  ;; RAW only: no ARP, no IP stack beyond the fixed 4-tuple. The Mac en8 is
  ;; static 10.10.10.1 and its MAC is baked in, so the Ethernet header is
  ;; complete without a lookup. This is the Phase-1 debug substrate: RTL8125
  ;; Tx + Ethernet + IPv4 + UDP, nothing more.
  ;;
  ;; It deliberately runs as a SINGLE-SHOT send on bus3 per call, using a
  ;; 16 KiB DMA window the CALLER supplies. That window must be loader-owned:
  ;; Phase 1 pointed it at kernel pages 14..17, which the Amu loader never
  ;; allocated (kernel_scratch.pages = 14), so the NIC would have mastered
  ;; into memory the kernel does not own (ADR-0156). The TX ring is installed
  ;; once by debug-init, then debug-send reuses it.
  ;;
  ;; Every entry point returns a DISTINCT code per outcome. Phase 1 returned
  ;; 0 both when the frame failed to build and when it was submitted, so the
  ;; caller could not tell a working send from a dead one.
  (:require [capability.link.frame :as link]
            [capability.dma.map :as dma]
            [capability.mmio.map :as mapped]
            [native.rtl8125 :as rtl])
  (:export [debug-init debug-send]))

;; ── fixed debug 4-tuple ──────────────────────────────────────────────────
;; K16 bus3 = 10.10.10.2, Mac en8 = 10.10.10.1, UDP 9000 -> 9000.
(def k16-debug-ip 168493058)    ; 0x0A0A0A02
(def mac-debug-ip 168493057)    ; 0x0A0A0A01
(def debug-udp-port 9000)

;; Mac en8 NIC MAC (3c:18:a0:d5:82:a8), the fixed debug peer.
(defn store-peer-mac [frame]
  (if (and (= (kernel-store-u8-4k frame 4096 0 60) 60)
           (= (kernel-store-u8-4k frame 4096 1 24) 24)
           (= (kernel-store-u8-4k frame 4096 2 160) 160)
           (= (kernel-store-u8-4k frame 4096 3 213) 213)
           (= (kernel-store-u8-4k frame 4096 4 130) 130)
           (= (kernel-store-u8-4k frame 4096 5 168) 168))
    1
    0))

(defn store-device-mac [frame mmio index]
  (if (= index 6)
    1
    (let [value (kernel-load-u8 mmio 512 index)
          stored (kernel-store-u8-4k frame 4096 (+ 6 index)
                                     (bit-and value 255))]
      (if (and (= stored (bit-and value 255))
               (= (kernel-store-u8-4k frame 4096 (+ 6 index) stored) stored))
        (store-device-mac frame mmio (+ index 1))
        0))))

(defn store-be16 [frame offset value]
  (let [hi (kernel-store-u8-4k frame 4096 offset
                               (bit-and (quot value 256) 255))
        lo (kernel-store-u8-4k frame 4096 (+ offset 1)
                               (bit-and value 255))]
    (if (and (= hi (bit-and (quot value 256) 255))
             (= lo (bit-and value 255)))
      value
      0)))

(defn store-be32 [frame offset value]
  (let [b0 (kernel-store-u8-4k frame 4096 offset
                               (bit-and (quot value 16777216) 255))
        b1 (kernel-store-u8-4k frame 4096 (+ offset 1)
                               (bit-and (quot value 65536) 255))
        b2 (kernel-store-u8-4k frame 4096 (+ offset 2)
                               (bit-and (quot value 256) 255))
        b3 (kernel-store-u8-4k frame 4096 (+ offset 3)
                               (bit-and value 255))
        ok (and (= b0 (bit-and (quot value 16777216) 255))
                (= b1 (bit-and (quot value 65536) 255))
                (= b2 (bit-and (quot value 256) 255))
                (= b3 (bit-and value 255)))]
    (if ok value 0)))

(defn zero-prefix [frame bytes offset]
  (if (= offset bytes)
    1
    (let [stored (kernel-store-u8-4k frame 4096 offset 0)]
      (if (= stored 0) (zero-prefix frame bytes (+ offset 1)) 0))))

;; payload: short fixed ASCII; a richer kprintf comes later. (placeholder
;; single byte 'Z'; the stream netlog body is the richer format.)

(defn build-udp-debug-frame [frame mmio]
  ;; 14 eth + 20 ip + 8 udp = 42 header; payload 1 byte placeholder.
  (let [total 43]
    (if (and (= (zero-prefix frame 60 0) 1)
             (= (store-peer-mac frame) 1)
             (= (store-device-mac frame mmio 0) 1)
             (= (store-be16 frame 12 2048) 2048)           ; ethertype IPv4
             (= (kernel-store-u8-4k frame 4096 14 69) 69)  ; v4/IHL
             (= (kernel-store-u8-4k frame 4096 15 0) 0)
             (= (store-be16 frame 16 total) total)         ; total length
             (= (kernel-store-u8-4k frame 4096 22 64) 64)  ; TTL
             (= (kernel-store-u8-4k frame 4096 23 17) 17)  ; UDP proto
             ;; IPv4 header checksum. Every other field of this header is a
             ;; compile-time constant, so the checksum is one too: 0x52AC
             ;; over 45 00 / 00 2B / 0000 / 0000 / 40 11 / 0000 /
             ;; 10.10.10.2 / 10.10.10.1. Leaving it zero (the state
             ;; zero-prefix leaves) makes the Mac drop the datagram in
             ;; ip_input before socat ever sees it -- the same reason
             ;; rtl8125/build-ipv4-udp-header bakes in its own 0x6619.
             (= (store-be16 frame 24 21164) 21164)
             (= (store-be32 frame 26 k16-debug-ip) k16-debug-ip)
             (= (store-be32 frame 30 mac-debug-ip) mac-debug-ip)
             (= (store-be16 frame 34 debug-udp-port) debug-udp-port)
             (= (store-be16 frame 36 debug-udp-port) debug-udp-port)
             (= (store-be16 frame 38 9) 9)                 ; udp len
             (= (kernel-store-u8-4k frame 4096 42 90) 90)  ; 'Z' payload
             (= (store-be16 frame 40 0) 0))                ; udp checksum 0
      total
      0)))

(defn debug-init [bus mmio dma-pages]
  ;; Bring bus3 to the same footing `rtl/qualify` gives bus2, then install a
  ;; single TX ring and leave the engine running. Each refusal has its own
  ;; code so the kernel's netlog says WHICH prerequisite failed:
  ;;   0  ready
  ;;   9  the device would not report MEM-SPACE|BUS-MASTER after the write
  ;;   7  IDR0..5 is not a plausible unicast MAC
  ;;   2  ChipCmd revision unreadable (the BAR does not read back)
  ;;   8  PHY reports no link -- a submit here is owned forever
  ;;   10+n  rtl/rings-start refused with n (4 fifo, 1 install)
  (if (= (rtl/arm-bus-master bus) 0)
    9
    (if (not (rtl/mac-valid mmio))
      7
      (let [revision-id (rtl/revision mmio)]
        (if (= revision-id 0)
          2
          (let [started (rtl/rings-start mmio revision-id dma-pages)]
            (if (not (= started 0))
              (+ 10 started)
              (if (= (rtl/link-up mmio) 0) 8 0))))))))

(defn debug-send [mmio dma-pages]
  ;; Single-shot UDP :9000 log on bus3:
  ;;   0  the descriptor was submitted AND the engine cleared OWN
  ;;   1  the frame could not be built
  ;;   5  the descriptor was still owned, or the wire length was rejected
  ;;   3  a descriptor store did not read back
  ;;   4  submitted, but OWN never cleared -- the engine is not consuming
  ;; 0 must mean exactly one thing: bytes left the NIC.
  (let [tx dma-pages
        tx-frame (kernel-subregion dma-pages 16384 8192 4096)
        len (build-udp-debug-frame tx-frame mmio)]
    (if (= len 0)
      1
      (let [submitted (rtl/tx-submit mmio tx tx-frame len)]
        (if (= submitted 5)
          5
          (if (not (= submitted 0))
            3
            (if (= (rtl/wait-tx-complete tx 200000000) 0) 4 0)))))))