(ns aiueos.native.kernel)

;; The compiler-emitted loader keeps the final UEFI memory map in a bounded
;; region directly after the 64-byte boot-info prefix.  The kernel derives that
;; region; it never turns the pointer stored by firmware into authority.
(defn load64 [base length offset]
  (+ (kernel-load-u8-16k base length offset)
     (* (kernel-load-u8-16k base length (+ offset 1)) 256)
     (* (kernel-load-u8-16k base length (+ offset 2)) 65536)
     (* (kernel-load-u8-16k base length (+ offset 3)) 16777216)
     (* (kernel-load-u8-16k base length (+ offset 4)) 4294967296)
     (* (kernel-load-u8-16k base length (+ offset 5)) 1099511627776)
     (* (kernel-load-u8-16k base length (+ offset 6)) 281474976710656)
     (* (kernel-load-u8-16k base length (+ offset 7)) 72057594037927936)))

(defn load64-boot [base offset]
  (+ (kernel-load-u8 base 64 offset)
     (* (kernel-load-u8 base 64 (+ offset 1)) 256)
     (* (kernel-load-u8 base 64 (+ offset 2)) 65536)
     (* (kernel-load-u8 base 64 (+ offset 3)) 16777216)
     (* (kernel-load-u8 base 64 (+ offset 4)) 4294967296)
     (* (kernel-load-u8 base 64 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8 base 64 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8 base 64 (+ offset 7)) 72057594037927936)))

(defn load32 [base length offset]
  (+ (kernel-load-u8-16k base length offset)
     (* (kernel-load-u8-16k base length (+ offset 1)) 256)
     (* (kernel-load-u8-16k base length (+ offset 2)) 65536)
     (* (kernel-load-u8-16k base length (+ offset 3)) 16777216)))

;; UEFI type 7 is EfiConventionalMemory.  The compiler-emitted loader identity
;; maps the first GiB, so this bounded allocator slice admits one aligned,
;; contiguous eight-page extent in [2 MiB, 1 GiB).  Loader/kernel pages have
;; non-conventional UEFI types.
(defn find-page [memory-map map-size descriptor-size offset remaining]
  (if (or (= remaining 0)
          (> (+ offset descriptor-size) map-size))
    0
    (let [memory-type (load32 memory-map map-size offset)
          physical-start (load64 memory-map map-size (+ offset 8))
          pages (load64 memory-map map-size (+ offset 24))]
      (if (and (= memory-type 7)
               (> pages 7)
               (>= physical-start 2097152)
               (< physical-start 1073717248)
               (= (bit-and physical-start 4095) 0))
        physical-start
        (find-page memory-map map-size descriptor-size
                   (+ offset descriptor-size) (- remaining 1))))))

;; Sixteen writes per tail call keep the recursive depth below the kernel fuel
;; ceiling while proving that every byte in the admitted page is writable and
;; zeroed before it can become allocator output.
(defn zero-page [page offset]
  (if (= offset 4096)
    1
    (let [s0 (kernel-store-u8-4k page 4096 offset 0)
          s1 (kernel-store-u8-4k page 4096 (+ offset 1) 0)
          s2 (kernel-store-u8-4k page 4096 (+ offset 2) 0)
          s3 (kernel-store-u8-4k page 4096 (+ offset 3) 0)
          s4 (kernel-store-u8-4k page 4096 (+ offset 4) 0)
          s5 (kernel-store-u8-4k page 4096 (+ offset 5) 0)
          s6 (kernel-store-u8-4k page 4096 (+ offset 6) 0)
          s7 (kernel-store-u8-4k page 4096 (+ offset 7) 0)
          s8 (kernel-store-u8-4k page 4096 (+ offset 8) 0)
          s9 (kernel-store-u8-4k page 4096 (+ offset 9) 0)
          sa (kernel-store-u8-4k page 4096 (+ offset 10) 0)
          sb (kernel-store-u8-4k page 4096 (+ offset 11) 0)
          sc (kernel-store-u8-4k page 4096 (+ offset 12) 0)
          sd (kernel-store-u8-4k page 4096 (+ offset 13) 0)
          se (kernel-store-u8-4k page 4096 (+ offset 14) 0)
          sf (kernel-store-u8-4k page 4096 (+ offset 15) 0)]
      (if (= (+ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 sa sb sc sd se sf) 0)
        (zero-page page (+ offset 16))
        0))))

;; One byte per bounded allocator slot is deliberately simple: zero means
;; free, one means owned.  The state lives in an allocator page rather than in
;; transient scalar control flow, so later claims observe earlier decisions.
(defn claim-slot [state slot]
  (let [current (kernel-load-u8-4k state 4096 slot)]
    (if (= current 0)
      (let [stored (kernel-store-u8-4k state 4096 slot 1)]
        (if (and (= stored 1)
                 (= (kernel-load-u8-4k state 4096 slot) 1))
          1
          0))
      0)))

(defn release-slot [state slot]
  (let [current (kernel-load-u8-4k state 4096 slot)]
    (if (= current 1)
      (let [stored (kernel-store-u8-4k state 4096 slot 0)]
        (if (and (= stored 0)
                 (= (kernel-load-u8-4k state 4096 slot) 0))
          1
          0))
      0)))

(defn load64-page [page offset]
  (+ (kernel-load-u8-4k page 4096 offset)
     (* (kernel-load-u8-4k page 4096 (+ offset 1)) 256)
     (* (kernel-load-u8-4k page 4096 (+ offset 2)) 65536)
     (* (kernel-load-u8-4k page 4096 (+ offset 3)) 16777216)
     (* (kernel-load-u8-4k page 4096 (+ offset 4)) 4294967296)
     (* (kernel-load-u8-4k page 4096 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8-4k page 4096 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8-4k page 4096 (+ offset 7)) 72057594037927936)))

;; Page-table entries are little-endian u64 values.  Keeping this in Kotoba
;; avoids introducing a C helper or widening the privileged intrinsic surface.
(defn store64-page [page offset value]
  (let [s0 (kernel-store-u8-4k page 4096 offset (bit-and value 255))
        s1 (kernel-store-u8-4k page 4096 (+ offset 1) (bit-and (quot value 256) 255))
        s2 (kernel-store-u8-4k page 4096 (+ offset 2) (bit-and (quot value 65536) 255))
        s3 (kernel-store-u8-4k page 4096 (+ offset 3) (bit-and (quot value 16777216) 255))
        s4 (kernel-store-u8-4k page 4096 (+ offset 4) (bit-and (quot value 4294967296) 255))
        s5 (kernel-store-u8-4k page 4096 (+ offset 5) (bit-and (quot value 1099511627776) 255))
        s6 (kernel-store-u8-4k page 4096 (+ offset 6) (bit-and (quot value 281474976710656) 255))
        s7 (kernel-store-u8-4k page 4096 (+ offset 7) (bit-and (quot value 72057594037927936) 255))]
    (if (= (load64-page page offset) value)
      (+ 1 (* 0 (+ s0 s1 s2 s3 s4 s5 s6 s7)))
      0)))

;; NX lives in byte 7, so it is installed without pretending signed i64
;; literals are unsigned page-table entries.
(defn store64-nx-page [page offset value]
  (if (and (= (store64-page page offset value) 1)
           (= (kernel-store-u8-4k page 4096 (+ offset 7) 128) 128)
           (= (kernel-load-u8-4k page 4096 (+ offset 7)) 128))
    1
    0))

;; PDE 0 points to a 4 KiB PT.  The remaining 2 MiB leaves preserve the first
;; GiB identity map but are RW+NX rather than executable.
(defn fill-identity-pd [page index]
  (if (= index 512)
    1
    (let [value (+ (* index 2097152) 131)]
      (if (= (store64-nx-page page (* index 8) value) 1)
        (fill-identity-pd page (+ index 1))
        0))))

(defn fill-low-pt [page index]
  (if (= index 512)
    1
    (let [physical (* index 4096)
          offset (* index 8)
          stored (if (= index 256)
                   (store64-page page offset 0)
                   (if (and (>= index 257) (<= index 267))
                     (store64-page page offset (+ physical 1))
                     (store64-nx-page page offset (+ physical 3))))]
      (if (= stored 1)
        (fill-low-pt page (+ index 1))
        0))))

(defn five-distinct [a b c d e]
  (and (> a 0) (> b 0) (> c 0) (> d 0) (> e 0)
       (< e 1073741824)
       (not (= a b)) (not (= a c)) (not (= a d)) (not (= a e))
       (not (= b c)) (not (= b d)) (not (= b e))
       (not (= c d)) (not (= c e)) (not (= d e))))

(defn zero-five [state pml4 pdpt pd pt]
  (and (= (zero-page state 0) 1)
       (= (zero-page pml4 0) 1)
       (= (zero-page pdpt 0) 1)
       (= (zero-page pd 0) 1)
       (= (zero-page pt 0) 1)
       (= (kernel-load-u8-4k state 4096 4095) 0)
       (= (kernel-load-u8-4k pml4 4096 4095) 0)
       (= (kernel-load-u8-4k pdpt 4096 4095) 0)
       (= (kernel-load-u8-4k pd 4096 4095) 0)
       (= (kernel-load-u8-4k pt 4096 4095) 0)))

(defn ownership-eight [state]
  (and (= (claim-slot state 0) 1)
       (= (claim-slot state 1) 1)
       (= (claim-slot state 2) 1)
       (= (claim-slot state 3) 1)
       (= (claim-slot state 4) 1)
       (= (claim-slot state 5) 1)
       (= (claim-slot state 6) 1)
       (= (claim-slot state 7) 1)
       (= (claim-slot state 1) 0)
       (= (release-slot state 4) 1)
       (= (release-slot state 4) 0)
       (= (claim-slot state 4) 1)
       (= (kernel-load-u8-4k state 4096 0) 1)
       (= (kernel-load-u8-4k state 4096 1) 1)
       (= (kernel-load-u8-4k state 4096 2) 1)
       (= (kernel-load-u8-4k state 4096 3) 1)
       (= (kernel-load-u8-4k state 4096 4) 1)
       (= (kernel-load-u8-4k state 4096 5) 1)
       (= (kernel-load-u8-4k state 4096 6) 1)
       (= (kernel-load-u8-4k state 4096 7) 1)))

(defn prepare-page-tables [pml4 pdpt pd pt]
  (and (= (store64-page pml4 0 (+ pdpt 3)) 1)
       (= (store64-page pdpt 0 (+ pd 3)) 1)
       (= (store64-page pd 0 (+ pt 3)) 1)
       (= (fill-identity-pd pd 1) 1)
       (= (fill-low-pt pt 0) 1)
       (= (load64-page pml4 0) (+ pdpt 3))
       (= (load64-page pdpt 0) (+ pd 3))
       (= (load64-page pd 0) (+ pt 3))
       (= (load64-page pt 2048) 0)
       (= (load64-page pt 2056) 1052673)
       (= (load64-page pt 2136) 1093633)
       (= (kernel-load-u8-4k pt 4096 2151) 128)
       (= (kernel-load-u8-4k pd 4096 15) 128)
       (= (kernel-load-u8-4k pd 4096 4095) 128)))

(defn enable-page-protection []
  (if (and (>= (kernel-cpuid-eax 2147483648 0) 2147483649)
           (not (= (bit-and (kernel-cpuid-edx 2147483649 0) 1048576) 0)))
    (let [efer (kernel-read-msr 3221225600)
          nxe (bit-or efer 2048)
          efer-written (kernel-write-msr 3221225600 nxe)
          cr0 (kernel-read-cr0)
          wp (bit-or cr0 65536)
          cr0-written (kernel-write-cr0 wp)]
      (and (= efer-written nxe)
           (= (bit-and (kernel-read-msr 3221225600) 2048) 2048)
           (= cr0-written wp)
           (= (bit-and (kernel-read-cr0) 65536) 65536)))
    false))

(defn activate-page-tables [pml4]
  (let [written (kernel-write-cr3 pml4)
        active (kernel-read-cr3)
        flushed (kernel-invlpg 1048576)]
    (and (= written pml4)
         (= (+ active (* 0 flushed)) pml4))))

;; The IDT storage is allocator-owned and remains RW+NX under the replacement
;; map. The backend contributes only the address of its sealed non-returning
;; entry; Kotoba constructs vector 14 and the pseudo-descriptor byte layout.
(defn install-page-fault-idt [idt-page]
  (let [handler (kernel-page-fault-handler-address)
        selector (kernel-read-cs)
        handler-low (bit-and handler 65535)
        handler-mid (bit-and (quot handler 65536) 65535)
        handler-high (bit-and (quot handler 4294967296) 4294967295)
        gate-low (+ handler-low
                    (* selector 65536)
                    (* 142 1099511627776)
                    (* handler-mid 281474976710656))]
    (if (and (>= handler 1052672) (< handler 1097728)
             (> selector 0) (<= selector 65535)
             (= (store64-page idt-page 224 gate-low) 1)
             (= (store64-page idt-page 232 handler-high) 1)
             (= (kernel-store-u8-4k idt-page 4096 512 239) 239)
             (= (kernel-store-u8-4k idt-page 4096 513 0) 0)
             (= (store64-page idt-page 514 idt-page) 1)
             (= (load64-page idt-page 224) gate-low)
             (= (load64-page idt-page 232) handler-high)
             (= (kernel-load-u8-4k idt-page 4096 512) 239)
             (= (load64-page idt-page 514) idt-page))
      (let [descriptor (kernel-subregion idt-page 4096 512 10)]
        (kernel-load-idt descriptor 10))
      0)))

(defn recoverable-frame-valid [frame-page stack-page probe]
  (if (= probe 424242)
    1
    (if (and (= probe 0)
             (= (load64-page frame-page 0) 1048576)
             (= (bit-and (load64-page frame-page 8) 3) 2)
             (> (load64-page frame-page 16) 1052672)
             (= (load64-page frame-page 24) (+ stack-page 4080)))
      (if (= (kernel-out-u8 233 69) 69) 1 0)
      0)))

;; Mutation scripts replace this exact body with one sealed hardware access.
;; Keeping the positive artifact free of a dormant arbitrary-address branch
;; makes each fault receipt attributable to the compiled probe it contains.
(defn page-fault-probe []
  (+ 424200 42))

(defn main []
  (let [boot (kernel-boot-info)
        cr3 (kernel-read-cr3)
        map-size (load64-boot boot 24)
        descriptor-size (load64-boot boot 32)
        memory-map (kernel-subregion boot 16448 64 16384)]
    (if (and (> boot 0) (> cr3 0)
             (= (kernel-load-u8 boot 64 0) 65)
             (= (kernel-load-u8 boot 64 1) 73)
             (= (kernel-load-u8 boot 64 2) 85)
             (= (kernel-load-u8 boot 64 3) 69)
             (= (kernel-load-u8 boot 64 4) 66)
             (= (kernel-load-u8 boot 64 5) 79)
             (= (kernel-load-u8 boot 64 6) 79)
             (= (kernel-load-u8 boot 64 7) 84)
             (= (load64-boot boot 8) 1)
             (= (load64-boot boot 16) memory-map)
             (> map-size 0)
             (<= map-size 16384)
             (>= descriptor-size 40)
             (<= descriptor-size map-size)
             (> (load64-boot boot 40) 0))
      (let [map-marker (kernel-out-u8 233 77)
            ;; 16 KiB / the admitted 40-byte minimum is at most 409 complete
            ;; descriptors.  Keep an independent recursive bound so corrupt
            ;; arithmetic can never turn the firmware-controlled stride into
            ;; an unbounded walk.
            physical-start (find-page memory-map map-size descriptor-size 0 410)]
        (if (> physical-start 0)
          (let [second-start (+ physical-start 4096)
                third-start (+ physical-start 8192)
                fourth-start (+ physical-start 12288)
                fifth-start (+ physical-start 16384)
                sixth-start (+ physical-start 20480)
                seventh-start (+ physical-start 24576)
                eighth-start (+ physical-start 28672)]
            (if (and (five-distinct physical-start second-start third-start
                                    fourth-start fifth-start)
                     (> sixth-start 0) (< sixth-start 1073741824)
                     (not (= sixth-start physical-start))
                     (not (= sixth-start second-start))
                     (not (= sixth-start third-start))
                     (not (= sixth-start fourth-start))
                     (not (= sixth-start fifth-start))
                     (> seventh-start 0) (> eighth-start 0)
                     (< eighth-start 1073741824)
                     (not (= seventh-start physical-start))
                     (not (= seventh-start second-start))
                     (not (= seventh-start third-start))
                     (not (= seventh-start fourth-start))
                     (not (= seventh-start fifth-start))
                     (not (= seventh-start sixth-start))
                     (not (= eighth-start physical-start))
                     (not (= eighth-start second-start))
                     (not (= eighth-start third-start))
                     (not (= eighth-start fourth-start))
                     (not (= eighth-start fifth-start))
                     (not (= eighth-start sixth-start))
                     (not (= eighth-start seventh-start)))
                  ;; The literal parent names the loader's identity-mapped
                  ;; physical window. Map values select only checked offsets.
                  (let [state (kernel-subregion 4096 1073737728
                                                (- physical-start 4096) 4096)
                        page-table-root (kernel-subregion 4096 1073737728
                                                          (- second-start 4096) 4096)
                        pdpt (kernel-subregion 4096 1073737728
                                               (- third-start 4096) 4096)
                        pd (kernel-subregion 4096 1073737728
                                             (- fourth-start 4096) 4096)
                        pt (kernel-subregion 4096 1073737728
                                             (- fifth-start 4096) 4096)
                        reusable-page (kernel-subregion 4096 1073737728
                                                       (- sixth-start 4096) 4096)]
                    (if (and (= map-marker 77)
                             (zero-five state page-table-root pdpt pd pt)
                             (= (zero-page reusable-page 0) 1)
                             (= (zero-page (kernel-subregion 4096 1073737728
                                                            (- seventh-start 4096) 4096) 0) 1)
                             (= (zero-page (kernel-subregion 4096 1073737728
                                                            (- eighth-start 4096) 4096) 0) 1)
                             (= (kernel-load-u8-4k reusable-page 4096 4095) 0)
                             (ownership-eight state))
                      (if (prepare-page-tables page-table-root pdpt pd pt)
                          (if (and (enable-page-protection)
                                   (activate-page-tables page-table-root)
                                   (= (kernel-configure-page-fault-recovery
                                       (kernel-subregion 4096 1073737728
                                                         (- seventh-start 4096) 4096)
                                       (kernel-subregion 4096 1073737728
                                                         (- eighth-start 4096) 4096)) 1)
                                   (= (install-page-fault-idt reusable-page) 1))
                            (let [page-marker (kernel-out-u8 233 80)
                                  root-marker (kernel-out-u8 233 82)
                                  cr3-marker (kernel-out-u8 233 67)
                                  idt-marker (kernel-out-u8 233 68)
                                  probe (page-fault-probe)]
                              (kernel-out-u32 244
                                              (if (and (= page-marker 80)
                                                       (= root-marker 82)
                                                       (= cr3-marker 67)
                                                       (= idt-marker 68)
                                                       (= (recoverable-frame-valid
                                                           (kernel-subregion 4096 1073737728
                                                                             (- seventh-start 4096) 4096)
                                                           (kernel-subregion 4096 1073737728
                                                                             (- eighth-start 4096) 4096)
                                                           probe) 1))
                                                16 17)))
                            (kernel-out-u32 244 24))
                        (kernel-out-u32 244 23))
                      (kernel-out-u32 244 22)))
              (kernel-out-u32 244 20)))
          (kernel-out-u32 244 19)))
      (kernel-out-u32 244 18))))
