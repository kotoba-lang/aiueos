(ns aiueos.native.user-elf-v2-live-goal-entry
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.desktop :as desktop]
            [aiueos.native.user-v2-inline :as user]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain
            aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant
            aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete
            aiueos-value-runtime-cas-verify]))

;; C-free integration image root. The ordinary boot entry remains the native
;; kernel's main function; the ValueRuntime entry is linked into the same
;; sealed KIR/native image instead of being supplied as a foreign object.

;; The v3 profile owns vector6's controlled #UD entry. Keep the legacy kernel
;; declaration in the retained graph, without exporting a conflicting vector.
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

(defn aiueos-value-runtime-entry
  [arena :i64 entry-profile :i64 user-page :i64
   kernel-request :i64 cap-table :i64] :i64
  (runtime/aiueos-value-runtime-entry
   arena entry-profile user-page kernel-request cap-table))

(defn aiueos-value-runtime-syscall-plan
  [number :i64 domain :i64 pointer :i64 user-rip :i64 user-rsp :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan
   number domain pointer user-rip user-rsp))

(defn aiueos-value-runtime-publish-domain [current-domain :i64] :i64
  (domain/aiueos-value-runtime-publish-domain current-domain))

(defn aiueos-value-runtime-provider-status
  [generation :i64 active :i64] :i64
  (provider/aiueos-value-runtime-provider-status generation active))

(defn aiueos-value-runtime-capability-grant
  [action :i64 slot :i64 generation :i64 rights :i64 owner :i64] :i64
  (provider/aiueos-value-runtime-capability-grant
   action slot generation rights owner))

(defn aiueos-value-runtime-provider-complete
  [ticket :i64 route-domain :i64 block :i64
   block-length :i64 descriptor :i64] :i64
  (transport/aiueos-value-runtime-provider-complete
   ticket route-domain block block-length descriptor))

(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))

(defn aiueos-value-runtime-cas-verify
  [block :i64 block-length :i64 expected :i64
   output :i64 workspace :i64] :i64
  (cas/aiueos-value-runtime-cas-verify
   block block-length expected output workspace))

;; The compiler-generated user bytes are pinned in user-v2-inline. EFI has
;; only one 512 KiB payload, which the native desktop uses for its font.
;; This diagnostic copy is source-bound but is not signed app admission.
(defn- surface-word [surface :i64 index :i64] :i64
  (kernel-load-u32 (kernel-subregion surface 8192 (* index 4) 4) 4 0))
(defn- clear-goal [request :i64 index :i64] :bool
  (if (= index 64) true
    (let [written (kernel-store-u8-4k request 4096 (+ 256 index) 0)]
      (and (= (kernel-load-u8-4k request 4096 (+ 256 index)) 0)
           (clear-goal request (+ index 1))))))
(defn- copy-goal [surface :i64 request :i64 length :i64 index :i64] :bool
  (if (= index length) true
    (let [cp (surface-word surface (+ 236 index))]
      (if (not (or (= cp 32) (and (>= cp 97) (<= cp 122)))) false
        (let [written (kernel-store-u8-4k request 4096 (+ 260 index) cp)]
          (and (= (kernel-load-u8-4k request 4096 (+ 260 index)) cp)
               (copy-goal surface request length (+ index 1))))))))
(defn- write-goal [surface :i64 request :i64] :bool
  (let [body-length (surface-word surface 2038)
        goal-length (- body-length 12)]
    (if (or (<= goal-length 0) (> goal-length 51)) false
      (if (clear-goal request 0)
        (do (kernel-store-u32-4k request 4096 256 goal-length)
            (and (= (kernel-load-u32-4k request 4096 256) goal-length)
                 (copy-goal surface request goal-length 0)))
        false))))
(defn main [] :i64
  (let [published (kernel-value-runtime-invoke 2 73 0 0 0 0)
        submitted (if (= published 73) (desktop/goal-main) 0)
        code (kernel-value-domain-code-page 73)
        request (kernel-value-domain-request-page 73)
        stack (kernel-value-domain-stack-page 73)
        surface (kernel-browser-surface)
        staged (if (and (= submitted 1) (> code 0) (> request code) (> stack request))
                 (and (user/stage code request) (write-goal surface request)) false)
        enabled (if staged (kernel-value-enable-user) 0)]
    (if (= enabled 1) (kernel-value-enter-user 73) 0)))
