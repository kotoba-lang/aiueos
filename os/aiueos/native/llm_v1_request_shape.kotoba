(ns aiueos.native.llm-v1-request-shape
  (:require [aiueos.native.llm-v1-header :as header]
            [aiueos.native.llm-v1-utf8 :as utf8])
  (:export [aiueos-llm-v1-request-shape-valid]))

;; The caller must supply distinct, checked host/guest regions. The three
;; request fields are separate <=64 KiB windows, so their combined maximum
;; need not fit into one machine window. A matching selected-model region is
;; an input from host policy, not a guest grant. This function does not verify
;; grant authority or dispatch a provider.
(defn aiueos-llm-v1-request-shape-valid
  [wire-header :i64 wire-header-bytes :i64
   model :i64 model-bytes :i64
   system :i64 system-bytes :i64
   prompt :i64 prompt-bytes :i64
   selected-model :i64 selected-model-bytes :i64
   result :i64 result-bytes :i64] :i64
  (if (not= (header/aiueos-llm-v1-header-valid
             wire-header wire-header-bytes) 1) 0
    (let [declared-model (kernel-load-u32 wire-header wire-header-bytes 12)
          declared-system (kernel-load-u32 wire-header wire-header-bytes 16)
          declared-prompt (kernel-load-u32 wire-header wire-header-bytes 20)
          declared-payload (kernel-load-u32 wire-header wire-header-bytes 32)
          declared-result (kernel-load-u32 wire-header wire-header-bytes 36)]
      (if (and (not= model 0) (not= system 0) (not= prompt 0)
               (not= selected-model 0) (not= result 0)
               (= model-bytes declared-model)
               (= system-bytes declared-system)
               (= prompt-bytes declared-prompt)
               (= (+ model-bytes system-bytes prompt-bytes) declared-payload)
               (= selected-model-bytes model-bytes)
               (= result-bytes declared-result)
               (utf8/aiueos-llm-v1-utf8-valid model model-bytes)
               (utf8/aiueos-llm-v1-utf8-valid system system-bytes)
               (utf8/aiueos-llm-v1-utf8-valid prompt prompt-bytes))
        (loop [index 0]
          (if (= index model-bytes) 1
            (if (= (kernel-load-u8-64k model model-bytes index)
                   (kernel-load-u8-64k selected-model selected-model-bytes index))
              (recur (+ index 1)) 0)))
        0))))
