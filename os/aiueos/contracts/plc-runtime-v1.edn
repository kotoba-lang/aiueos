{:format :aiueos.plc-runtime/v1
 :profile :aiueos-plc-v1
 :requires {:kernel :x86_64-aiueos-rt-kernel-v1
            :timing-profile :hard-real-time
            :cores 1
            :linux false
            :jvm false
            :gc false}
 :program {:source :iec-61131-3-structured-text-subset-v1
           :source-encoding :utf-8
           :types [:bool :dint]
           :dint-overflow :wrap-signed-two-complement-32
           :statements [:assignment]
           :expressions [:literal :variable :not :and :or :xor
                         :equal :not-equal :less :less-equal
                         :greater :greater-equal :add :subtract :multiply]
           :forbidden [:loop :recursion :function-call :pointer
                       :dynamic-allocation :online-interpretation]
           :minimums {:inputs 1 :outputs 1}
           :maximums {:inputs 16 :outputs 16 :assignments 16}}
 :scan {:order [:latch-input-image
                :release-plc-task
                :execute-native-program
                :check-program-result
                :check-budget
                :check-deadline
                :watchdog-checkpoint
                :atomic-output-commit]
        :input-image {:bytes 64 :immutable-during-scan true}
        :output-image {:bytes 64 :shadow true :physical-write :atomic-at-scan-boundary}
        :capabilities {:input-read 16
                       :output-stage 17
                       :output-commit 18
                       :watchdog-checkpoint 19}
        :capability-abi {:input-read-argument :zero-based-input-index
                         :input-read-result :sign-extended-dint-or-bool-word
                         :output-stage-argument {:bits-0-31 :twos-complement-value
                                                 :bits-32-63 :zero-based-output-index}
                         :output-stage-result :one-on-valid-shadow-write
                         :output-commit-argument :declared-output-count
                         :output-commit-result :one-on-atomic-physical-commit
                         :watchdog-argument 1
                         :watchdog-result :one-on-checkpoint}
        :commit-condition [:program-reached-final-commit
                           :within-execution-budget
                           :within-deadline-window
                           :all-output-stages-valid]
        :failure-action {:commit false
                         :physical-output :configured-safe-state
                         :latch-fault true
                         :restart :operator-policy}}
 :task {:scheduler :fixed-priority-preemptive
        :task-set :static-after-admission
        :base-priority-change-after-start false
        :admission :response-time-analysis
        :wcet :measured-against-exact-native-artifact}
 :online-change {:runtime-source-interpretation false
                 :artifact :signed-native-user-elf
                 :admission-required true
                 :activation :scan-boundary
                 :rollback :previous-admitted-artifact}
 :industrial-io {:hard-real-time-drivers :separately-qualified-native-only
                 :diagnostic-protocols :lower-priority-bounded-task
                 :opc-ua :outside-control-loop}
 :safety {:claim :standard-plc-only
          :functional-safety-certified false
          :requires-separate-process [:iec-61508 :iec-62061 :iso-13849]}
 :receipt {:format :aiueos-plc-native-receipt/v1
           :binds [:st-source-sha256 :generated-kotoba-sha256
                   :native-elf-sha256 :compiler-commit
                   :rt-kernel-receipt-sha256 :rt-kernel-artifact-sha256
                   :io-map-sha256
                   :admission-analysis-sha256]}
 :current {:implemented [:bounded-st-frontend
                         :deterministic-kotoba-generation
                         :static-aiueos-user-elf
                         :exact-capability-bitmap
                         :transactional-scan-contract
                         :fail-closed-deployment-receipt]
           :deployment-ready false
           :blockers [:qualified-rt-kernel
                      :native-plc-capability-provider
                      :bounded-physical-io-driver
                      :io-map
                      :wcet-and-response-time-analysis
                      :physical-scan-latency-measurement]}}
