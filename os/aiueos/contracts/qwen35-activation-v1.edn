;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-activation/v1
 :graph {:root aiueos.qwen35-activation
         :modules [aiueos.qwen35-activation]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_activation"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion
                                f32-add f32-sub f32-mul f32-div f32-neg
                                f32-ge f32-le f32-from-bits f32-to-bits
                                i64-to-f32-rounded bit-and bit-or quot]}
 :arguments [:mode :a :b :count :spare]

 ;; WHY THIS OBJECT EXISTS.
 ;; `silu` is applied to 17,408 values per layer per token and `sigmoid` gates
 ;; every attention head. They are five lines of C each and the whole of their
 ;; difficulty is `local_exp`, whose range reduction has to reproduce a cast
 ;; this dialect does not have.

 ;; THE INTEGER TRUNCATION THE C GETS FROM A CAST.
 ;; `local_exp` computes `(int32_t)(scaled + 0.5f)`. `f32-to-i64-truncating`
 ;; and `f32-to-i64-checked` are BOTH refused for native -- x86 yields
 ;; INT64_MIN out of domain, AArch64 saturates and the KIR oracle traps, so
 ;; there is no one answer to admit. The object truncates from the binary32
 ;; pattern instead. That is exact over the only range that reaches it,
 ;; because the C clamps `value` to [-87, 88] first, so `scaled + 0.5` is
 ;; inside (-127, 128) and the exponent is at most 6.

 ;; The vectors carry every clamp boundary as a probe: -87 (returns zero), 88
 ;; and 89 (saturate to the same answer), and +-20 and +-20.5, which switch
 ;; `softplus` between its three branches. A port that got a clamp wrong
 ;; agrees everywhere else.

 :result {:kind :reason-code :admit 0 :range [-4 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-a
           -2 :mode-outside-0-4
           -3 :count-outside-1-65536
           -4 :mode-4-with-a-null-b}
 :modes {0 :silu 1 :sigmoid 2 :softplus 3 :local-exp 4 :silu-gate}

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 4096
                         :a-offset 0 :b-offset 512}
                :floors {:minimum-vectors 9
                         :minimum-memory-assertions 5
                         :every-reachable-reason-observed true}}
 :vectors
 [
  {:name :mode-0, :mode 0, :count 64, :a-hex "", :b-hex "", :expect-a-hex "", :expected 0}
  {:name :mode-1, :mode 1, :count 64, :a-hex "", :b-hex "", :expect-a-hex "", :expected 0}
  {:name :mode-2, :mode 2, :count 64, :a-hex "", :b-hex "", :expect-a-hex "", :expected 0}
  {:name :mode-3, :mode 3, :count 64, :a-hex "", :b-hex "", :expect-a-hex "", :expected 0}
  {:name :mode-4, :mode 4, :count 64, :a-hex "", :b-hex "", :expect-a-hex "", :expected 0}
  {:name :null-a, :mode 0, :count 8, :a-base-override 0, :expected -1}
  {:name :mode-below-zero, :mode -1, :count 8, :expected -2}
  {:name :mode-above-four, :mode 5, :count 8, :expected -2}
  {:name :count-zero, :mode 0, :count 0, :expected -3}
  {:name :count-above-the-ceiling, :mode 0, :count 65537, :expected -3}
  {:name :silu-gate-with-a-null-b, :mode 4, :count 8, :b-base-override 0, :expected -4}
 ]}
