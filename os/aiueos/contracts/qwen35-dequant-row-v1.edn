;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin.
{:format :aiueos.qwen35-dequant-row/v1
 :graph {:root aiueos.qwen35-dequant-row
         :modules [aiueos.qwen35-dequant-row]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_dequant_row"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32 kernel-store-u32
                                kernel-subregion f32-add f32-sub f32-mul
                                f32-from-bits f32-to-bits i64-to-f32-rounded]}
 :arguments [:qtype :src :src-length :dst :dst-length]

 ;; WHY THIS OBJECT EXISTS.
 ;; `aiueos_qwen35_dequantize_row` (`kernel/qwen35_quant.c:584`) is the first
 ;; arithmetic every matvec runs and the last place a wrong nibble is cheap to
 ;; find: a swapped scale index or a mis-signed byte does not crash, it shifts
 ;; one weight and the model degrades in a way no bound catches.

 ;; FOUR TYPES, AND THE FOUR THAT DOMINATE THE MODEL ARE NOT AMONG THEM.
 ;; F32 (0), Q8_0 (8), Q4_K (12) and Q6_K (14) are the four whose equations are
 ;; pure arithmetic over the block's own bytes -- 490 of the artifact's 866
 ;; tensors. IQ3_XXS (120), IQ3_S (106), IQ4_XS (45) and IQ2_S (35) decode
 ;; through codebook grids that `qwen35_quant_tables.inc` holds as static const
 ;; data, and this dialect has no rodata and no bytes literal to put one in.
 ;; Those 306 tensors stay in the C, and the K16 model still runs its dominant
 ;; matvecs there.

 :result {:kind :reason-code :admit 0 :range [-6 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-source
           -2 :null-destination
           -3 :destination-length-not-a-positive-multiple-of-four
           -4 :element-count-above-65536
           -5 :source-length-is-not-the-row-byte-count
           -6 :type-not-f32-q8-0-q4-k-or-q6-k}

 ;; WHERE THE EXPECTED BYTES COME FROM. An independent re-derivation of the C
 ;; in ClojureScript over `Float32Array`, so every rounding in the expectation
 ;; is a real binary32 rounding rather than a double printed short. That proves
 ;; the ALGORITHM against a second reading of the same C and says nothing about
 ;; what amu emitted -- which is why ADR-0137's acceptance is the QEMU
 ;; self-test `QWEN-PARITY dequant`, where the emitted object is compared
 ;; against the compiled C on the CPU, bit for bit.

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 8192
                         :src-offset 0 :dst-offset 4096}
                :floors {:minimum-vectors 11
                         :minimum-memory-assertions 5
                         :every-reachable-reason-observed true}}
 :vectors
 [
  {:name :f32-8, :qtype 0, :count 8, :row-hex "0000a8c3000090bf000064c600007c4000007a44000004410000e4c2000064bf", :expected 0, :expect-row-hex "0000a8c3000090bf000064c600007c4000007a44000004410000e4c2000064bf"}
  {:name :q8-0-32, :qtype 8, :count 32, :row-hex "9456159980b36552b51544a8c87909e3ca44cc8d55dce27e999a29301cee57f98243", :expected 0, :expect-row-hex "00240a45006329c6008052c60042fdc50019264600da064600aef6c500240a4500a8df4500b810c60030b8c500fd464600d06c4400c43ec5009cb1c500a8df450008abc5001f3dc600c90b4600d06cc5005845c500364f46006329c600be27c600da864500e09d450030384500d0ecc400130f46003038c400364fc6005edc45"}
  {:name :q8-0-64, :qtype 8, :count 64, :row-hex "f75552d04b402656ba5a45a24bf3c2ac7db3680fee8d83a88cd788e1e709c39a5210c3de67393803b0fe3a45d5a1af5f2320fc393e59921691998bf530704ae5e665ef5b", :expected 0, :expect-row-hex ""}
  {:name :q4-k-256, :qtype 12, :count 256, :row-hex "de5cbee5169cc0336dcb2e1a050ff2a2819ef0dd4a37f5c458ebc328c182bf6b4bc74751afa286e673127e3af3d1cec597243069be2191ff34faab920914fbf1365a2561d88a27ee29f3cbd0a9f14bcfba860057dc291418ece12a4ef493315f42bc4ea89db1c5050afa6c0ae7d6af2d57a61856023f00cc0c07891dc8780a202adc18f6910e61ecec21e190f091e9e5", :expected 0, :expect-row-hex ""}
  {:name :q6-k-256, :qtype 14, :count 256, :row-hex "", :expected 0, :expect-row-hex ""}
  {:name :null-source, :qtype 8, :count 32, :src-base-override 0, :expected -1}
  {:name :null-destination, :qtype 8, :count 32, :dst-base-override 0, :expected -2}
  {:name :destination-not-a-multiple-of-four, :qtype 8, :count 32, :dst-len-override 130, :expected -3}
  {:name :destination-too-small, :qtype 8, :count 32, :dst-len-override 0, :expected -3}
  {:name :count-above-the-ceiling, :qtype 0, :count 8, :dst-len-override 262148, :src-len-override 262148, :expected -4}
