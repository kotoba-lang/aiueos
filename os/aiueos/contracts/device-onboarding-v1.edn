;; Product contract for adding an aiueos machine to an account and then to the
;; Murakumo/Kekkai/storage planes. Identity, reachability, workload readiness,
;; and data replication are independent gates.
{:format :aiueos.device-onboarding/v1
 :ui {:engine :kotoba-lang/browser
      :surface :aiueos/session
      :design-system :jp-go-dds
      :native-runtime :kotoba-clj/wasm
      :hosted-html-js {:scope :verification-only
                       :counts-as-native? false}}
 :authentication
 {:authority "https://auth.kotoba.cloud"
  :rp-id "auth.kotoba.cloud"
  :endpoints {:sign-in "/sign-in"
              :passkey-options "/v1/passkey/login/options"
              :passkey-verify "/v1/passkey/login/verify"}
  :methods
  {:passkey {:requirements [:single-use-challenge :rp-id-bound
                            :origin-bound :user-present :user-verified
                            :signature-verified :sign-count-checked]}
   :phone-scan {:requirements [:public-device-challenge :phone-device-id
                               :phone-passkey-verified :human-approved]
                :qr-contains [:device-did :model :public-challenge-reference]
                :qr-excludes [:passkey-private-key :account-session
                              :device-enrollment-token]}}
  :shared-flow [:factory :challenge-issued :account-authenticated
                :device-key-proved :claimed :account-synced]
  :private-key-copy? false}
 :node-addition
 {:after [:account-authenticated :device-key-proved]
  :murakumo {:initial-state :pending-runtime-proof
             :ready? false
             :required-proof [:authenticated-heartbeat :real-job-result
                              :reboot-recovery]}
  :kekkai {:implementation "kotoba-lang/kekkai-node"
           :transport :noise-ik
           :initial-state :pending-native-adapter
           :required-proof [:device-key-custody :signed-netmap
                            :peer-handshake :reconnect]}}
 :storage
 {:local {:role :encrypted-cache
          :target :internal-ssd
          :state :not-installed
          :write-authorized? false}
  :metadata {:authority "https://kotobase.net"
             :state :contract-only}
  :blocks {:implementation "kotoba-lang/kotobase-storage"
           :identity :cid
           :state :contract-only}
  :replication {:implementation "kotoba-lang/kotobase-storage-pack"
                :format :car-v2
                :mode :folder-scoped-opt-in
                :state :not-started
                :plaintext-cloud-copy? false
                :required-proof [:encrypted-local-write :cid-round-trip
                                 :second-node-pack-import :conflict-policy]}}
 :present-evidence
 {:state-machine :implemented-and-unit-tested
  :kotoba-browser-render :hosted-engine-smoke
  :physical-k16-auth :unverified
  :physical-k16-kekkai :unverified
  :physical-k16-storage :unverified}
 :safety {:internal-ssd-write-without-fresh-disk-check? false
          :account-claim-implies-murakumo-ready? false
          :kekkai-reachability-implies-storage-sync? false}}
