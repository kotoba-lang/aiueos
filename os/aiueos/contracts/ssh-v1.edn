;; What "AIUEOS is reachable headless over SSH" means, as checkable data
;; (install-v1.edn gate I4, root ADR adr-2608251418 decision 4).
;;
;; The headless floor is declared by REACHABILITY, not by a key file's
;; presence: an external client must complete a real SSH handshake with the
;; key the install intent named, a wrong key must be refused, and both must
;; still hold after a reboot. This contract records the SSH-2 profile the
;; bare-metal server speaks, the userauth decision, the provisioning inputs
;; the installer places, and -- separately, so a built brick is never mistaken
;; for a finished server -- the current state of each piece.
;;
;; Boundary (decision 3, unchanged): the SSH server is AIUEOS's own, in the
;; bare-metal kernel, the way the TLS 1.3 CLIENT already is. Linux is an
;; install-time mechanism only; there is no Linux at runtime, so there is no
;; OpenSSH at runtime. What the installer does at provisioning time (generate
;; the host key, place the authorized key) MAY use the audited Linux live
;; environment; what answers port 22 on the running machine may not.
{:format :aiueos.ssh-contract/v1
 :profile :bare-metal-uefi
 :architecture :x86_64
 :role :server

 ;; The SSH-2 profile. Every algorithm is chosen so its primitive either
 ;; already exists in the kernel or is a named crypto brick below -- no
 ;; algorithm is listed that has no path to the metal.
 :transport
 {:protocol "SSH-2.0"
  :identification "SSH-2.0-aiueos_0.1"
  :kex "curve25519-sha256"          ; X25519 (kernel kotoba) + SHA-256 exchange hash (kernel kotoba)
  :host-key "ssh-ed25519"           ; needs Ed25519 SIGN -- crypto brick, not yet on the metal
  :cipher "aes128-gcm@openssh.com"  ; AES-128-GCM (kernel) -- GCM tag is the MAC, no separate HMAC
  :mac :implicit-in-gcm
  :compression "none"
  :rekey :not-in-r0}                 ; one session, bounded; rekey is a later tranche

 ;; Userauth is publickey only. The client (the owner's machine) proves it
 ;; holds the private half of the key the intent named, by signing the SSH
 ;; session identifier; the server verifies that signature against the
 ;; provisioned authorized key. Password auth is never a default (decision 4).
 :userauth
 {:method "publickey"
  :algorithm "ssh-ed25519"          ; the intent's key is ssh-ed25519 -> needs Ed25519 VERIFY
  :against :provisioned-authorized-key
  :password :refused
  :refuses [:wrong-key              ; a key not in the authorized set
            :wrong-user             ; a principal the provision record does not name
            :bad-signature          ; signature that does not verify under the offered key
            :unbound-hostkey]}      ; host key not matching the provisioned seed's public half

 ;; What the installer writes to the target so the first boot has an identity
 ;; and an authorized peer (decision 4, decision 2). Generated at install time
 ;; -- the host key is per-device and one-time; the authorized key is copied
 ;; from the intent, never invented.
 :provisioning
 {:schema "aiueos.provision.v1"
  :written-by "os/aiueos/scripts/make-provision-record.cljs"
  :placed-by "os/aiueos/scripts/install-to-disk.cljs"      ; after the release image, before the target receipt
  :location :reserved-provision-partition                   ; a dedicated GPT partition; NOT inside the release extent
  :binds [:hostname
          :device-claim-ref
          :ssh-host-key-ed25519-seed        ; 32 random bytes, one-time; never leaves the device in the clear
          :ssh-host-key-ed25519-public      ; derived, published as the host key fingerprint
          :authorized-keys                  ; [{principal algo blob fingerprint}] from the intent
          :install-intent-sha256
          :created-at]
  :host-key-generation :install-time-mechanism   ; node ed25519 in the live bundle, like the installer itself
  :secret-floor "the seed is written only to the target's provision partition;
                 it is not logged, not left on the install USB, and not
                 reused across installs (safety floor 1: no credential entry;
                 the seed is generated by the tool, never typed)."}

 ;; The reachability floor: none of these is satisfied by a static check.
 :reachability
 {:requires [:sshd-listens-on-tcp-22-after-boot
             :offline-check-of-provisioned-authorized-key-ownership-and-binding
             :external-client-completes-publickey-handshake-with-intent-key
             :same-handshake-after-reboot
             :wrong-key-refused-with-reason
             :password-attempt-refused]
  :external-client :outside-the-installer          ; a real ssh(1) from another host, not the gate's own process
  :not-green-on [:key-file-present-in-image
                 :sshd-binary-present
                 :port-22-open-without-a-completed-auth]}

 ;; Recovery stays a separate physical path (decision 4): re-place the
 ;; authorized key from a recovery environment; no long-lived shared password
 ;; is ever baked into the image.
 :recovery {:path :physical
            :re-place-authorized-key true
            :long-lived-shared-password :never}

 ;; The crypto bricks the server needs that the kernel does not yet have.
 ;; Each is a Kotoba object measured against published test vectors on its
 ;; own, before any of it is wired into a server -- a brick that passes its
 ;; vectors is real; a server that cannot be reached is not.
 :crypto-bricks
 {:sha512 {:object "os/aiueos/kotoba/sha512.kotoba"
           :vectors :fips-180-4
           :reuses :none
           :state :landing}                        ; this tranche
  :ed25519-verify {:object "os/aiueos/kotoba/ed25519-verify.kotoba"
                   :vectors :rfc8032
                   :reuses [:sha512 :x25519-field-arithmetic]  ; GF(2^255-19) ops from x25519.kotoba
                   :needs [:edwards-point-add :scalar-mult :point-decompress-sqrt]
                   :state :not-yet-implemented}
  :ed25519-sign {:object "os/aiueos/kotoba/ed25519-sign.kotoba"
                 :vectors :rfc8032
                 :reuses [:sha512 :ed25519-verify]
                 :needs [:scalar-reduce-mod-L :base-point-mult]
                 :state :not-yet-implemented}}

 ;; Current state, mirrored into install-v1.edn gate I4. Update both together.
 ;; The four measured blockers between here and a served handshake (kernel
 ;; survey 2026-08-25, all file:line verified). None is a matter of wiring;
 ;; each is a named addition.
 :blockers
 {:passive-open
  ;; RESOLVED 2026-08-25 for the identification exchange (ADR-0102):
  ;; net_ssh_listen (pci.c, behind -DAIUEOS_SSH_LISTEN) accepts one inbound
  ;; connection on :22 and exchanges SSH-2.0 id strings, proved by an external
  ;; client in smoke-qemu-ssh.cljs. It reuses tcp-segment-valid for inbound
  ;; admission -- tcp-seq-acceptable.kotoba is still unlinked and would be
  ;; needed for a windowed, multi-segment stream, not for this single exchange.
  "RESOLVED for the id exchange (ADR-0102). Still open for a full stream: a
   windowed TCB and tcp-seq-acceptable.kotoba are needed once the connection
   carries kex and userauth rather than one line each way."
  :rx-path
  "The virtio-net RX ring holds exactly ONE buffer and is polled (no MSI-X
   vector); the ring handles are stack locals of virtio_net(). The id-exchange
   listener works within this by re-posting per segment and keeping the
   exchange to one line each way; a real session needs the handles promoted to
   file-scope statics with a deeper queue."
  :entropy-and-sign
  "There is no random-bytes API (virtio-rng asks for 32 bytes once and
   discards them) and no signing primitive of any kind (ECDSA is verify-only,
   Ed25519 absent). A standards SSH server MUST sign the exchange hash H per
   handshake, so a provisioned-and-only-verified host key does not suffice --
   host-key SIGN is unavoidable."
  :no-steady-state
  "main.c is a straight line ending in ud2 -> qemu_exit(0x30); there is no
   loop to serve from. A service loop must be inserted before that exit, with
   its own evidence marker, and must stay under the 1 MiB kernel-ELF ceiling."}

 :state
 {:i4 :red
  :provisioning :landed                ; ADR-0101
  :passive-open :landed                ; ADR-0102: accept + SSH id exchange, external client measured
  :sshd :not-yet-implemented           ; kex/host-key/userauth need the crypto bricks below
  :note "Reusable on the metal today: X25519 (arbitrary scalar x point),
         SHA-256, HMAC-SHA256, HKDF, AES-128-GCM (= aes128-gcm@openssh.com),
         digest-equal. The TLS 1.3 client (tls13.c) is a TCP-passive byte
         codec driven by a pump in pci.c -- ssh.c mirrors that shape. The
         reference implementations for the crypto bricks are
         kotoba-lang/org-ietf-ed25519 (sign/verify/seed recovery) and
         kotoba-lang/org-ietf-sftp (experimental SSH transport); both are
         .cljc and inform the Kotoba port, they are not the bare-metal path.
         Kotoba objects take up to 5 i64 args and are slow (ECDSA verify is
         seconds), so the pump must ACK the peer before a verify."}}
