;; The guest browser desktop's maturity ladder (ADR-0226).
;;
;; GOAL: kotoba-lang/browser's surface is the aiueos desktop you can use on
;; KERNEL.ELF -- seen on the display, driven by pointer and keyboard in one
;; running event loop, laid out as browser lays it out -- and then the browser
;; component itself runs there.
;;
;; One floor is closed only by its gate: a `kbb --backend sci --classpath src
;; scripts/compositor-guest.cljk <gate>` profile that
;;   (a) is registered in src/aiueos/compositor/guest.cljk, AND
;;   (b) has its "`<gate>` exit 0 means ..." paragraph in README.md
;; on origin/main. The loop's tick reads exactly those two facts; a floor
;; with no gate yet (:gate nil) is never counted as closed.
;;
;; Order is the order a loop takes them. :needs-a-human floors are skipped by
;; the loop and reported. :blocked-by floors are skipped the same way: a
;; measured wall that another repo must remove first (the compiler, usually),
;; with :reproduce -- the commands that show the wall -- and :until -- what
;; has to be true before a loop takes the floor again. Re-run :reproduce
;; before removing :blocked-by; do not remove it on belief. Editing this file (split a floor, reorder, add one)
;; is part of an iteration when measuring shows the ladder was wrong -- say
;; why in the commit.
{:format :aiueos.desktop-maturity/v1
 :goal "kotoba-lang/browser's surface as the usable aiueos desktop on KERNEL.ELF, then the browser component itself on the kernel"
 :floors
 [{:id :frame :gate "guest-browser-frame" :adr "0223"
   :goal "Kotoba writes the retained draw list; C presents it in order"}
  {:id :pointer :gate "guest-browser-input" :adr "0223"
   :goal "a real virtio-tablet press focuses and raises the topmost window"}
  {:id :text :gate "guest-browser-text" :adr "0224"
   :goal "titles and bodies in Japanese and ASCII from the initramfs font, on the display"}
  {:id :text-raise :gate "guest-browser-text-raised" :adr "0224"
   :goal "a raise re-lays the text in stack order"}
  {:id :typing :gate "guest-browser-type" :adr "0225"
   :goal "virtio-keyboard through the Kotoba IME into the focused window"}
  {:id :preedit :gate "guest-browser-preedit"
   :goal "the composition (preedit) is drawn underlined at the end of the focused body while it is being typed, and disappears on commit"
   :why "typing is blind until Enter; browser.document-input shows composition state"}
  {:id :ime-toggle :gate "guest-browser-ime-toggle"
   :goal "a toggle key (Hankaku/Zenkaku, evdev 41) switches the IME off and on; off sends latin straight in"
   :why "the IME-off path exists in browser-ime but no key reaches it"}
  {:id :drag :gate "guest-browser-drag"
   :goal "press on a titlebar, move, release: the window moves by the pointer delta (browser.input pointer capture :drag)"
   :why "browser.input captures titlebar drags; the kernel reduces only pointer/down"}
  {:id :resize :gate "guest-browser-resize"
   :goal "press on the 16 px resize handle, move, release: the window resizes, clamped at 120x80 (browser.input :resize)"}
  {:id :event-loop :gate "guest-browser-event-loop"
   :goal "one running loop takes interleaved pointer and key events over several seconds and presents a frame after each, instead of one scripted pass"
   :why "every gate so far is a fixed sequence; a desktop is a loop"}
  {:id :caret :gate "guest-browser-caret"
   :goal "the focused body shows a caret; Backspace with an empty preedit deletes the code point before it (browser.text-edit delete-backward)"}
  {:id :launch-close :gate "guest-browser-launch"
   :goal "a launcher row opens a window (:app/launch) and a close control removes it, focus moving to the last remaining window (browser.surface close-window)"}
  {:id :flow-layout :gate "guest-browser-flow-parity"
   :goal "the kernel's body layout equals browser.surface + cssom's draw ops for the same surface, compared op by op against the hosted engine"
   :why "the kernel places text by its own rules today (:no-flow-layout)"}
  {:id :browser-component :gate nil
   :goal "kotoba-lang/browser's surface/input reducers compiled as a whole component and linked into KERNEL.ELF, replacing the mirrored objects"
   :why "the mirrored objects are the migration's scaffold, not its end"
   ;; Measured 2026-09-25 with amu origin/main 2dcaac74 and browser 6cbc1ee;
   ;; re-measured the same day at amu e442e253 (kotoba-sema 05d8bd8a) and
   ;; browser d735c86. `amu check` is target-independent (bin/amu routes
   ;; `check` past --target), so x86_64-aiueos-kernel-v1 and aarch64-macos
   ;; are one measurement. Three walls were ordinary Clojure forms and
   ;; LANDED in the compiler: (:k m) on a map means get (amu#1088), conj on a
   ;; vector appends (amu#1089), remove is filter negated (amu#1092). The
   ;; rest are one language decision, written up as amu docs/adr 0352
   ;; (proposed): browser's reducers are dynamically typed Clojure over open
   ;; maps and hiccup, amu's application profile is closed and static on
   ;; purpose. Rewriting browser.surface / browser.input into amu's typed
   ;; primitives would still be a second copy of the reducers -- unless the
   ;; hosted engine runs that typed source too (ADR 0352 option C).
   :blocked-by
   {:repo "kotoba-lang/amu"
    :decision "amu docs/adr/0352-browser-reducers-need-a-decision-not-more-builtins.md (proposed; owner decides A dynamic Clojure data / B caller-driven inference / C one typed source)"
    :landed ["wall 3: (:k m) / (:k m d) on the bounded or typed map means get -- kotoba-sema 110cb48e, amu#1088"
             "wall 4: conj on a :vector-i64 / :vector-f64 appends at the end -- kotoba-sema 45913acc, amu#1089"
             "wall 7: remove lowers to filter with the predicate negated -- kotoba-sema 05d8bd8a, amu#1092"]
    :walls
    ["project link: browser.text-edit / browser.input / browser.surface each -> \"project module ... requires an explicit :export vector\" (ADR 0005; the attr-map {:kotoba/export [...]} after the ns docstring is the designed, SCI-compatible spelling -- a browser change, not made here)"
     "unannotated parameters are :i64 (callers do not inform them): (defn f [m] (:a m)) -> \"record-get without a type descriptor requires a record value; got :i64\"; every reducer takes an unannotated map"
     "text_edit.cljk:6 -> :kotoba.error/map-literal-value: a keyword map whose value is nil (:text/composition nil) has no value type (no open maps; absence is [:option T])"
     "text_edit code-unit-at is #?(:clj (.charAt ..) :cljs (.charCodeAt ..)) with no :kotoba/:default branch -> \"function body is empty\" (host interop is a permanent refusal); count of a string is refused BY DECISION (UTF-8 bytes vs UTF-16 code units); subs unknown"
     "open-map operations on records: assoc of a new key, dissoc, merge, select-keys; a vector of records -> \"expected i64, got [:record ...]\""
     "runtime type tests over hiccup (nil? string? vector? sequential? map?): string? unknown; the only dynamically shaped value is :document (ADR 0028: bounded, no functions, no truthiness)"
     "a function stored in a map (:app/document-fn) -> exit 70 internal compiler error (a defect: must refuse, not crash)"
     "for / concat / reverse / vec / nth (vector destructuring of a parameter) unknown; 2-arity some is refused by vocabulary (some is the option constructor)"
     "native qualification, independent of the decision: the landed forms `amu check` clean but `amu compile --target x86_64-aiueos-kernel-v1` (and aarch64-macos) refuses them -- \"native target ... does not qualify map-new\" for a keyword map, \"does not qualify the boundary types [:vector-i64 :vector-i64] of function __kotoba_loop_1\" for filter/remove over a vector; (defn main [] (+ 40 2)) compiles for both (kotoba-lang/kotoba-native)"
     "browser.surface requires cssom.layout and kotoba.wasm.dom; with cssom 9224d359 and dom-gpu f2d0eba9 on the source path the link stops at \"source exceeds 1 MiB admission limit\" (cssom/layout.cljk alone is 1,083,132 bytes; ADR 0005's linked-source bound)"]
    :reproduce "in an amu checkout at origin/main after npm ci, with browser at B: bin/amu check $B/src/browser/{text_edit,input,surface}.cljk --source-path $B/src -> exit 65 at the export wall; add {:kotoba/export [...]} after each ns docstring in a scratch copy to reach the next walls (amu ADR 0352 ## Reproduce)"
    :until "amu ADR 0352 is decided and amu admits browser.surface + browser.input + browser.text-edit unchanged (source as the hosted engine runs it) FOR THE KERNEL: `amu compile src/browser/surface.cljk --source-path src --unpinned --target x86_64-aiueos-kernel-v1` exits 0 -- `amu check` alone is target-independent and stops before native qualification"}}
  ;; Owner decision 2026-09-25: the dictionary is generated in-repo, not
  ;; taken from SKK (GPL). The source is Unicode's Unihan readings, which
  ;; carry the Unicode License v3. Taken 2026-09-25 (ADR-0235): the
  ;; generator reads kJapanese, the same readings in kana, rather than
  ;; kJapaneseOn / kJapaneseKun, which carry them in romaji and fewer of them
  ;; (U+4E0B: 14 against 5).
  {:id :dictionary :gate "guest-browser-dictionary" :adr "0235"
   :goal "Space converts a reading of any length through a kana-kanji dictionary generated in-repo from Unicode Unihan kJapanese (Unicode License v3) for every kanji the desktop font carries; the dictionary travels in the initramfs like the font, the hosted IME oracle reads the same generated file, and the candidates' order is a rule written in the generator"
   :why "the oracle's three readings (か ひ あ) make conversion a demonstration, not an input method; SKK dictionaries are GPL"}
  ;; Extended 2026-09-25 (owner: continue past 13/16). Each floor below is
  ;; a browser behaviour the kernel desktop does not have yet; the order is
  ;; the order the loop takes them.
  {:id :pointer-cursor :gate "guest-browser-cursor" :adr "0236"
   :goal "the pointer is drawn every frame at the tablet position (a sprite laid out by Kotoba as ops, over everything), and moves with the pointer in the event loop"
   :why "the desktop takes a pointer it never shows"}
  {:id :focus-cycle :gate "guest-browser-focus-cycle"
   :goal "a window-manager shortcut (Alt+Tab, evdev 56 + 15) focuses and raises the next window in stack order, as a :window/focus action through browser-reduce; the key does not reach the body"
   :why "keyboard-only use cannot change the focused window"}
  {:id :scroll :gate "guest-browser-scroll"
   :goal "a wheel event over a window scrolls its body (browser.surface scroll-window: :window/scroll clamped at 0); the frame clips the scrolled body to the window"
   :why "a body longer than its window is cut, not reachable"}
  {:id :selection :gate "guest-browser-selection"
   :goal "Shift+Left / Shift+Right extend a selection from the caret in the focused body (browser.text-edit move-caret with :extend?), drawn as a highlight behind the glyphs; Backspace deletes the selection"
   :why "text editing stops at the caret"}
  {:id :clipboard :gate "guest-browser-clipboard"
   :goal "Ctrl+C copies the selection and Ctrl+V pastes it into the focused body only after the permission broker (broker-admit, ADR-0096) admits :clipboard; a refused grant pastes nothing"
   :why "browser.desktop-backend brokers clipboard; the kernel desktop has no path to it"}
  {:id :damage-present :gate "guest-browser-damage"
   :goal "a frame transfers and flushes only the rectangle that changed since the last one (virtio-gpu TRANSFER_TO_HOST_2D / RESOURCE_FLUSH with the damage rect), and the display is pixel-identical to a full present"
   :why "every event re-sends 1280 x 800 x 4 bytes"}
  {:id :p5 :gate nil :needs-a-human "a real machine with an aiueos image; QEMU is not P5"
   :goal "the same desktop on physical hardware"}]}
