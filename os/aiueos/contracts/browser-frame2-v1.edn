;; Companion to kotoba-native kernel-object-entries `aiueos-browser-frame2`
;; (guest browser desktop frame with text, ADR-0224).
;;
;; One list of rects AND glyphs, window by window in stack order. Every
;; success vector asserts the whole op list. The expected lists were produced
;; by a model written apart from the object (layout rules in the object
;; header), over a five-glyph fixture cut from os/aiueos/fonts/aiueos-16.fnt:
;; U+003F ? , U+0041 A, U+0061 a, U+3042 あ (16 px), U+FFFD. U+3041 ぁ is NOT
;; in the fixture, so it must come out as the U+FFFD glyph.
;;
;; SURFACE at :surface (8192 bytes): state words 0..31, titles at word
;; 32 + 32(id-1), bodies at 160 + 64(id-1), scratch 416..431, IME 432..479,
;; ops from word 480 (byte 1920), 24 bytes each: kind x y a b rgb (kind 2:
;; a = glyph index, b = width). `fourth-window-body-reads-all-64` pins the
;; 2026-09-24 overlap of the old scratch (400..415) with window 4's body.
;;
;; COMPOSITION (ADR-0227): the IME words 433 (romaji length), 434.. (romaji),
;; 445 (preedit length), 446.. (preedit) are drawn after the focused body,
;; each glyph with a 1 px rule at y + 17. The six `composition-*` /
;; `committed-*` vectors' op lists come from
;; os/aiueos/scripts/browser-frame-model.cljk --ops, the same model that
;; reproduces every older success vector here byte for byte and the three
;; census lines ADR-0224 / 0225 pinned on serial.
;;
;; CARET (ADR-0232): every success vector's list now ends the focused window
;; with a 1 x 16 #111111 rect at the cursor (kind 1, a = 1, b = 16), unless
;; its foot passes the bottom inset (`body-stops-at-the-bottom-inset`,
;; `composition-cut-at-the-bottom-inset` keep their old lists). The eleven
;; lists that changed were regenerated from the model, whose decoder first
;; reproduced all thirteen old lists from their seeds unchanged.
;;
;; LAUNCHER AND CLOSE (ADR-0233): word 31 is the app register. Every vector
;; above has it 0 and kept its list. The four `launcher-*` / `close-*` /
;; `*-40-wide-*` vectors set it: the launcher row and buttons right after the
;; background, a close control (16 x 16 #e4e8ef and U+00D7 -- the fixture has
;; no U+00D7, so its U+FFFD) after each title of a window at least 40 wide,
;; the title clipping 20 px earlier. Their lists come from
;; browser-frame-model.cljk --ops over the fixture font.
{:format :aiueos.browser-frame2/v1
 :entry aiueos-browser-frame2
 :graph {:root aiueos.browser-frame2
         :modules [aiueos.browser-frame2]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_browser_frame2"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion]}
 :arguments [:surface :surface-bytes :font :font-bytes]
 :result {:kind :count-or-reason :range [-9 -1]}
 :reasons {-1 :null-region-or-surface-not-8192
           -2 :abi-or-window-count-outside-1-4
           -3 :focus-is-not-a-window
           -4 :rect-leaves-viewport-or-shorter-than-titlebar
           -5 :more-than-261-ops
           -6 :font-refused
           -7 :window-id-outside-1-4
           -8 :ime-lengths-past-their-buffers
           -9 :app-register-past-app-4}
 :mirrors {:text-colour "browser.surface default-theme :fg #111111"
           :line-height "browser.surface default-theme :line-height 20"
           :body-inset "browser.surface/window-node .window-body padding 8"
           :titlebar-height "browser.input/titlebar-height 28"}
 :trusts-caller-for [:no-flow-layout :no-word-breaking :no-bidi]
 :verification {:node-stack-size 4000
                :fuel 1048576
                :memory {:base 4096 :image-bytes 8400
                         :regions {:surface 0 :font 8192}}
                :floors {:minimum-vectors 30
                         :minimum-memory-assertions 15
                         :every-reachable-reason-observed true}}
