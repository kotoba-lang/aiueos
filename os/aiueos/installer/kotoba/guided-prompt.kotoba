(ns aiueos.installer.guided-prompt
  (:export [main]))

;; The first slice of the guided installer on the selfhost substrate
;; (owner direction 2026-10-18: the install chain runs on amu-compiled
;; kotoba only -- no node, nbb or npm; Linear JUN-70 slice S1).
;;
;; One console screen, the shape guided-install.cljk has on nbb:
;;   argv 1  the question to print
;;   argv 2  the answers file to write (must be inside the fs scope)
;; Prints the question, reads ONE line from stdin, writes the answer to
;; the answers file through :fs/app-data. Exit codes are the guided
;; installer's contract (installer/README.md):
;;   0  answered and written
;;   2  refused, with AIUEOS_GUIDED_REFUSE <reason> on stdout
;;   3  could not answer -- stdin ended before any byte arrived
;;
;; MEASURED SUBSTRATE SEMANTICS (2026-10-18, x86_64-linux-static under
;; podman --platform linux/amd64): the static image's _start calls main and
;; writes its i64 return to stdout, then exit_group(0) -- kotoba-native
;; `linux_static.cljk` documents exactly this ("as the loader's default mode
;; does"). So the outcome codes above ARE the result line (the last stdout
;; line), not the process exit status; the process exits 0, and only a trap
;; gets a status (lang/limits.edn :static-elf :exit-codes, 120..126). A
;; caller that needs 0/2/3 reads the result line. :fs/app-data WRITE answers
;; with the body it wrote (amu tools/test-linux-static-handlers.cljk asserts
;; `write=[<body>]`), so success is `written` = the answer, not "1".
;;
;; What this slice does NOT do yet (later S1 pieces): the screen sequence,
;; the answer-file schema, the derived disk match, the confirm screen.
;; Compile (amu, --jvm-free):
;;   amu compile os/aiueos/installer/kotoba/guided-prompt.kotoba \
;;     --target x86_64-linux-static --jvm-free \
;;     --policy os/aiueos/installer/kotoba/guided-prompt-policy.edn \
;;     --output guided-prompt.elf

(defn emit [s :string] :string (typed-cap-call :io/write :string :string s))
(defn emit-error [s :string] :string (typed-cap-call :io/write-error :string :string s))
(defn stdin [s :string] :string (typed-cap-call :io/read :string :string s))
(defn fsq [s :string] :string (typed-cap-call :fs/app-data :string :string s))
(defn arg [i :string] :string (typed-cap-call :cli/args :string :string i))

(defn nl [] :string (string-substring "a
b" 1 2))

;; Accumulate the rest of the line, one byte at a time, up to the newline
;; or EOF. The newline itself is consumed, never returned.
(defn read-rest [acc :string] :string
  (let [c (stdin "1")]
    (if (string=? c "") acc
      (if (string=? c (nl)) acc
        (read-rest (string-concat acc c))))))

(defn refuse [reason :string] :i64
  (do (emit "AIUEOS_GUIDED_REFUSE ") (emit reason) (emit (nl)) 2))

(defn main [] :i64
  (let [q (arg "0") out (arg "1")]
    (if (string=? q "") (refuse "no-question")
      (if (string=? out "") (refuse "no-out-path")
        (do (emit q) (emit (nl))
          (let [c (stdin "1")]
            (cond
              (string=? c "")
              (do (emit "AIUEOS_GUIDED_REFUSE nobody-answered") (emit (nl)) 3)
              (string=? c (nl)) (refuse "empty-answer")
              :else
              (let [answer (string-concat c (read-rest ""))
                    written (fsq (string-concat out (string-concat "WRITE_SEP" answer)))]
                (if (string=? written answer)
                  (do (emit "AIUEOS_GUIDED_ANSWER_WRITTEN ") (emit answer) (emit (nl)) 0)
                  (do (emit "AIUEOS_GUIDED_REFUSE write-failed:") (emit written) (emit (nl)) 2))))))))))
