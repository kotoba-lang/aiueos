(ns aiueos.uefi-loader-probe
  (:require [aiueos.uefi.console :as console]
            [aiueos.uefi.elf :as elf])
  (:export [efi-main main mark-when present verdict]))

;; A BOOTX64.EFI, written in Kotoba, that says what it decided.
;;
;; This composes the first two loader modules -- `aiueos.uefi.console` and
;; `aiueos.uefi.elf` -- into one image, and it is the evidence that the PT_LOAD
;; admission contract runs as x86-64 machine code on a real firmware rather
;; than only inside an interpreter.
;;
;; ---------------------------------------------------------------------------
;; THE FIXTURE IS A REAL KERNEL, NOT A HAND-BUILT HEADER
;; ---------------------------------------------------------------------------
;; The 176 bytes below are the ELF header and both program headers of a kernel
;; that amu itself produced:
;;
;;   amu compile testkernel.kotoba --target x86_64-aiueos-kernel-v1 \
;;       --artifact image --fuel 32768 --output TESTKERN.ELF
;;   110,872 bytes,
;;   sha256 e4a5c9dc3ca03e310d9b8a0924e9e2ce510fb9678335bd2fe6496b7e9c182f1e
;;
;;   e_entry 1052672  e_phoff 64  e_phentsize 56  e_phnum 2
;;   seg0  PT_LOAD flags 5  offset  4096  paddr 1052672  filesz=memsz    160
;;   seg1  PT_LOAD flags 6  offset 32768  paddr 1081344  filesz=memsz  77824
;;
;; A header invented to pass would only prove that the rules agree with
;; themselves. This one proves the loader admits what the packager emits.
;;
;; ---------------------------------------------------------------------------
;; FIVE REFUSALS, EACH NAMING ITS OWN CLAUSE
;; ---------------------------------------------------------------------------
;; Five copies of those same 176 bytes follow, each with ONE field changed, and
;; each is expected to answer one specific reason. A verdict that merely went
;; non-zero would not distinguish "the file is wrong" from "the reader is".
;;
;;   magic    e_ident[1] 45 -> 46      reason  2
;;   machine  e_machine  62 -> 40      reason  5
;;   paddr0   seg0 p_paddr -> 0x8000   reason 24  (segment 0, clause 4)
;;   memsz0   seg0 p_memsz 160 -> 192  reason 23  (segment 0, clause 3)
;;   flags1   seg1 p_flags 6 -> 7      reason 41
;;
;; ---------------------------------------------------------------------------
;; THE DEBUG CONSOLE
;; ---------------------------------------------------------------------------
;;   K  the image entry ran
;;   H  RCX (ImageHandle) survived the entry shim
;;   S  RDX (SystemTable) survived it
;;   C  ConOut is at SystemTable+0x40 and is not null
;;   N  ClearScreen, SetAttribute and OutputString all returned EFI_SUCCESS
;;   A  the real kernel's headers were ADMITTED (reason 0)
;;   b c d e f  each mutation was refused with ITS OWN reason
;;   Z  kernel-system-table still answers, so R9 survived every call
;;
;; then `out 0xf4, 16`, so QEMU leaves with (16 << 1) | 1 = 33.

(defn mark-when [flag byte]
  (if (= flag 1) (kernel-out-u8 233 byte) 0))

(defn present [word]
  (if (= word 0) 0 1))

;; Prints the reason on the firmware console and marks the debug console only
;; when it is the reason this variant is supposed to produce.
(defn verdict [out base image-len expected marker]
  (let [r (elf/admit base 176 image-len)
        sp (console/put out (ucs2 " "))
        n (console/put-number out r)
        m (mark-when (if (= r expected) 1 0) marker)]
    (+ r (* 0 (+ sp (+ n m))))))

(defn efi-main [image-handle system-table]
  (let [out (console/con-out system-table)
        cleared (console/clear-screen out)
        attr (console/set-attribute out 15)
        banner (console/put out (ucs2 "AIUEOS KOTOBA LOADER\r\n"))
        m0 (kernel-out-u8 233 75)
        m1 (mark-when (present image-handle) 72)
        m2 (mark-when (present system-table) 83)
        m3 (mark-when (present out) 67)
        m4 (mark-when (if (= cleared 0) (if (= attr 0) (if (= banner 0) 1 0) 0) 0) 78)
        lh (console/put out (ucs2 "entry  "))
        eh (console/put-hex64 out (elf/entry-point (bytes-literal "") 176)
                              1152921504606846976)
        nl0 (console/put out (ucs2 "\r\nverdict"))
        v0 (verdict out (bytes-literal "")    110872 0  65)
        v1 (verdict out (bytes-literal "")   110872 2  98)
        v2 (verdict out (bytes-literal "") 110872 5  99)
        v3 (verdict out (bytes-literal "")  110872 24 100)
        v4 (verdict out (bytes-literal "")  110872 23 101)
        v5 (verdict out (bytes-literal "")  110872 41 102)
        nl1 (console/put out (ucs2 "\r\n"))
        parked (kernel-system-table)
        m5 (mark-when (if (= parked system-table) 1 0) 90)
        done (kernel-out-u32 244 16)]
    0))

(defn main [] 0)
