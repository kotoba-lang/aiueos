(ns iprobe
  (:require [aiueos.uefi.console :as console]
            [aiueos.uefi.integrity :as integrity])
  (:export [efi-main main mark-when digest-verdict]))

;; The digest half of `uefi/loader-probe.kotoba`, on its own.
;;
;; ---------------------------------------------------------------------------
;; WHY A SECOND PROBE EXISTS, AND WHEN TO DELETE IT
;; ---------------------------------------------------------------------------
;; `loader-probe.kotoba` is the real one and carries these two verdicts too.
;; It could not be BUILT on 2026-09-03: it also exercises `aiueos.uefi.memory`,
;; whose `kernel-uefi-alloc-region` is not in amu main yet (amu#766 open), so
;; every `--fuel` value answers
;;
;;     aggregate ABI rejected: call-abi-not-admitted
;;
;; -- measured on main's probe UNCHANGED, so it is not this stream's break.
;; This file is the same `digest-verdict` body and the same constants with the
;; memory half removed, so the digest evidence does not wait on that PR.
;;
;; DELETE IT once amu#766 lands and the loader smoke goes green: two probes for
;; one program is exactly the shape ADR-2608080100 argues against, and this one
;; only earns its place while the other cannot be compiled.
;;
;;   amu compile os/aiueos/uefi/integrity-probe.kotoba \
;;     --source-path os/aiueos/kotoba --target x86_64-aiueos-uefi-v1 \
;;     --artifact image --fuel 32768 --output BOOTX64.EFI --jvm-free
;;
;; boots to debugcon `Kgh`, exit 33, firmware console `digest 0 4`.

(defn mark-when [flag byte] (if (= flag 1) (kernel-out-u8 233 byte) 0))

(defn digest-verdict [out src expected marker]
  (let [r (integrity/verify (kernel-scratch-region) 16384 src 176 expected)
        sp (console/put out (ucs2 " "))
        n (console/put-number out r)
        m (mark-when (if (= r (if (= marker 103) 0 4)) 1 0) marker)]
    (+ r (* 0 (+ sp (+ n m))))))

(defn efi-main [image-handle system-table]
  (let [out (console/con-out system-table)
        m0 (kernel-out-u8 233 75)
        lh (console/put out (ucs2 "digest"))
        d0 (digest-verdict out (bytes-literal "")
                           (bytes-literal "db5502b1e112b394008f0fa17a7a4cfe891411d3e79a537874c025187f1825e1")
                           103)
        d1 (digest-verdict out (bytes-literal "")
                           (bytes-literal "db5502b1e112b394008f0fa17a7a4cfe891411d3e79a537874c025187f1825e2")
                           104)
        nl (console/put out (ucs2 "\r\n"))
        done (kernel-out-u32 244 16)]
    0))

(defn main [] 0)
