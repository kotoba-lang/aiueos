;; Guest browser desktop input: one canonical event -> kotoba-lang/browser
;; surface action, applied to the surface state, on KERNEL.ELF (ADR-0223).
;;
;; WHY THIS IS A KOTOBA OBJECT AND NOT A C TABLE
;;
;; C owns the virtio-input rings and scales a tablet's absolute axes to
;; surface pixels (mechanism). WHICH window a pointer lands on, and what that
;; does to focus and stacking, is the browser guest's decision
;; (kotoba-lang/browser ADR 0002). C never chooses a window.
;;
;; Mirrored from kotoba-lang/browser:
;;   pointer/down  browser.input/actions-for-event: window-at walks
;;                 `:surface/windows` in reverse (topmost first) with an
;;                 inclusive point-in-rect; a hit yields `:window/focus`,
;;                 a miss yields no action.
;;   window/focus  browser.surface/focus-window: set focus AND move the
;;                 window to the end of `:surface/windows` (raise).
;;   keyboard/key  browser.input: `:keyboard/key` on the focused window;
;;                 no geometry changes.
;;   pointer capture (ADR-0229) browser.input: a pointer/down that hits a
;;                 window inside its titlebar (y .. y + 28, inclusive) and
;;                 outside its 16 px resize handle captures `:drag` with the
;;                 offset from the window origin; a hit anywhere else clears
;;                 the capture; a miss leaves it as it was. pointer/move under
;;                 `:drag` is `:window/move` to (point - offset) --
;;                 browser.surface/move-window, which neither focuses nor
;;                 raises. pointer/up clears the capture.
;;   resize capture (ADR-0230) browser.input: a pointer/down inside the 16 px
;;                 resize handle (the last 16 px of both axes, inclusive)
;;                 captures `:resize` with the press point and the window's
;;                 size at the press. pointer/move under `:resize` is
;;                 `:window/resize` to (max 120 (w0 + px - x0)) x
;;                 (max 80 (h0 + py - y0)) -- browser.surface/resize-window,
;;                 which neither focuses, raises nor moves the origin.
;; Not mirrored: text editing, IME. Named leftover `:no-text-edit`.
;; A move whose origin would be negative is refused (-6) and changes nothing:
;; the u32 surface has no negative coordinate; browser.surface would store it.
;;
;; Same 128-byte u32 state as browser-frame.kotoba (same temporary native
;; constraints -- word types, at most five parameters -- and the same removal
;; condition).
;;
;; STATE (u32 words): 0..4 abi n focus vw vh, 5..24 id x y w h per window
;; (bottom first), 25 capture kind (0 none, 1 drag, 2 resize), 26 captured
;; window id, 27 28 the drag's offset from the window origin or the resize's
;; press point, 29 30 the resize's size at the press (0 for a drag). 31 is not
;; read.
;;
;; ABI: [state state-bytes kind a b], mutates state in place.
;;   kind 1 pointer/down at (a, b) -> focused window id, or 0 on a miss
;;   kind 2 key (a = code, b = value) -> focused window id that receives it
;;   kind 3 pointer/move to (a, b) -> the moved or resized window id, or 0
;;          uncaptured
;;   kind 4 pointer/up -> 0, capture cleared
;;   -1 null region / wrong size   -2 abi or n out of range
;;   -3 focus is not a window id   -4 capture is not none, or a drag or resize
;;                                    of a window
;;   -5 unknown event kind         -6 the move would put the origin below 0

(ns aiueos.browser-reduce
  (:export [aiueos-browser-reduce main]))

;; The state size is checked once at the entry (it must be 128).
(defn w-at [st i]
  (kernel-load-u32 (kernel-subregion st 128 (* i 4) 4) 4 0))

(defn w-put [st i v]
  (kernel-store-u32 (kernel-subregion st 128 (* i 4) 4) 4 0 v))

(defn has-id [st n k id]
  (if (>= k n) 0
    (if (= (w-at st (+ 5 (* k 5))) id) 1
      (has-id st n (+ k 1) id))))

(defn inside [st k px py]
  (let [b (+ 5 (* k 5))
        x (w-at st (+ b 1))
        y (w-at st (+ b 2))
        w (w-at st (+ b 3))
        h (w-at st (+ b 4))]
    (if (< px x) 0
      (if (> px (+ x w)) 0
        (if (< py y) 0
          (if (> py (+ y h)) 0 1))))))

;; Topmost first. Returns the stack index + 1, or 0.
(defn hit [st k px py]
  (if (< k 0) 0
    (if (= (inside st k px py) 1) (+ k 1)
      (hit st (- k 1) px py))))

(defn copy-rec [st from to]
  (let [fb (+ 5 (* from 5))
        tb (+ 5 (* to 5))]
    (do (w-put st tb (w-at st fb))
        (w-put st (+ tb 1) (w-at st (+ fb 1)))
        (w-put st (+ tb 2) (w-at st (+ fb 2)))
        (w-put st (+ tb 3) (w-at st (+ fb 3)))
        (w-put st (+ tb 4) (w-at st (+ fb 4))))))

(defn shift-down [st k n]
  (if (>= k (- n 1)) 0
    (do (copy-rec st (+ k 1) k)
        (shift-down st (+ k 1) n))))

(defn raise [st k n]
  (let [b (+ 5 (* k 5))
        id (w-at st b)
        x (w-at st (+ b 1))
        y (w-at st (+ b 2))
        w (w-at st (+ b 3))
        h (w-at st (+ b 4))
        tb (+ 5 (* (- n 1) 5))]
    (do (shift-down st k n)
        (w-put st tb id)
        (w-put st (+ tb 1) x)
        (w-put st (+ tb 2) y)
        (w-put st (+ tb 3) w)
        (w-put st (+ tb 4) h)
        (w-put st 2 id)
        id)))

;; Index of window id in the stack, or -1.
(defn index-of [st n k id]
  (if (>= k n) -1
    (if (= (w-at st (+ 5 (* k 5))) id) k
      (index-of st n (+ k 1) id))))

(defn capture-ok [st n]
  (if (= (w-at st 25) 0) 1
    (if (= (w-at st 25) 1) (has-id st n 0 (w-at st 26))
      (if (= (w-at st 25) 2) (has-id st n 0 (w-at st 26)) 0))))

;; browser.input in-resize-handle?: the last 16 px of both axes, inclusive.
(defn in-handle [st k px py]
  (let [b (+ 5 (* k 5))
        r (+ (w-at st (+ b 1)) (w-at st (+ b 3)))
        f (+ (w-at st (+ b 2)) (w-at st (+ b 4)))]
    (if (< px (- r 16)) 0
      (if (< py (- f 16)) 0 1))))

;; Set the capture for a press on stack index k (before the raise moves it).
(defn set-capture [st kind id c d]
  (do (w-put st 25 kind) (w-put st 26 id) (w-put st 27 c) (w-put st 28 d)))

(defn capture [st k px py]
  (let [b (+ 5 (* k 5))
        x (w-at st (+ b 1))
        y (w-at st (+ b 2))]
    (do (w-put st 29 0) (w-put st 30 0)
        (if (= (in-handle st k px py) 1)
          (do (set-capture st 2 (w-at st b) px py)
              (w-put st 29 (w-at st (+ b 3)))
              (w-put st 30 (w-at st (+ b 4))))
          (if (> py (+ y 28))
            (set-capture st 0 0 0 0)
            (set-capture st 1 (w-at st b) (- px x) (- py y)))))))

(defn press [st n k1 px py]
  (if (= k1 0) 0
    (do (capture st (- k1 1) px py)
        (raise st (- k1 1) n))))

(defn move-to [st k nx ny]
  (let [b (+ 5 (* k 5))]
    (if (< nx 0) -6
      (if (< ny 0) -6
        (do (w-put st (+ b 1) nx)
            (w-put st (+ b 2) ny)
            (w-at st b))))))

;; browser.input :resize: the size at the press plus the pointer's travel
;; from the press point, never below 120 x 80. Signed arithmetic: a travel
;; larger than the size clamps, it does not wrap.
(defn at-least [v floor]
  (if (< v floor) floor v))

(defn resize-to [st k px py]
  (let [b (+ 5 (* k 5))]
    (do (w-put st (+ b 3) (at-least (+ (w-at st 29) (- px (w-at st 27))) 120))
        (w-put st (+ b 4) (at-least (+ (w-at st 30) (- py (w-at st 28))) 80))
        (w-at st b))))

(defn drag [st n px py]
  (if (= (w-at st 25) 0) 0
    (if (= (w-at st 25) 2)
      (resize-to st (index-of st n 0 (w-at st 26)) px py)
      (move-to st (index-of st n 0 (w-at st 26))
               (- px (w-at st 27)) (- py (w-at st 28))))))

(defn release [st]
  (do (set-capture st 0 0 0 0) (w-put st 29 0) (w-put st 30 0) 0))

(defn aiueos-browser-reduce [st sb kind a b]
  (if (= st 0) -1
    (if (not (= sb 128)) -1
      (let [abi (w-at st 0)
            n (w-at st 1)
            focus (w-at st 2)]
        (if (not (= abi 1)) -2
          (if (< n 1) -2
            (if (> n 4) -2
              (if (= (has-id st n 0 focus) 0) -3
                (if (= (capture-ok st n) 0) -4
                  (if (= kind 1) (press st n (hit st (- n 1) a b) a b)
                    (if (= kind 2) focus
                      (if (= kind 3) (drag st n a b)
                        (if (= kind 4) (release st) -5)))))))))))))

(defn main [] 0)
