(ns aiueos.qwen35-gguf-header-valid)

;; GGUF v3 container header admission for the Qwen3.8-27B artifact this OS
;; boots with (`contracts/qwen38-qwen35-runtime-v1.edn`).
;;
;; Ported from the opening of `kernel/qwen35_runtime.c`'s
;; `aiueos_qwen35_model_parse` (the null/length/artifact guards and the four
;; header fields it reads before `parse_metadata`). The C returns a bare 0/1;
;; this returns a REASON CODE, because a caller that is handed a 10.9 GiB
;; supervisor-read-only mapping and told only "no" cannot tell a truncated
;; window from the wrong file.
;;
;;     0            admitted
;;    -1            null base
;;    -2            accessible window smaller than the 24-byte header
;;    -3            artifact length is not the admitted artifact
;;    -4            accessible window claims to exceed the artifact
;;    -5            magic is not "GGUF"
;;    -6            container version is not 3
;;    -7            tensor count is not 866
;;    -8            metadata (key/value) count is not 50
;;
;; **Zero is the success value**, the `aiueos-dhcp-reply-valid` convention and
;; not the boolean one its neighbours use: `if (header_valid(...))` inverts the
;; decision and admits exactly the headers this object rejected.
;;
;; Every read narrows the region first. `kernel-load-u32`'s window ceiling is
;; 512 bytes and this region is 10,934,860,704, so passing `accessible`
;; straight to a load traps on the length check before it reads anything;
;; `kernel-subregion` is the checked narrowing, and its own offset/sublength
;; check is what makes the 4-byte window legitimate rather than asserted.

(defn u32-at [base length offset]
  (kernel-load-u32 (kernel-subregion base length offset 4) 4 0))

;; `low | (high << 32)` in the C. Multiplication by 2^32 is the same bits: an
;; i64 result wraps modulo 2^64 exactly as the C's uint64_t does, so a hostile
;; high word produces the same value here and there. Only equality is asked of
;; it below, so the signed reading of those bits is never consulted.
(defn u64-at [base length offset]
  (+ (u32-at base length offset)
     (* (u32-at base length (+ offset 4)) 4294967296)))

(defn aiueos-qwen35-gguf-header-valid [base accessible artifact]
  (if (= base 0) -1
    (if (< accessible 24) -2
      (if (not (= artifact 10934860704)) -3
        (if (> accessible artifact) -4
          (if (not (= (u32-at base accessible 0) 1179993927)) -5
            (if (not (= (u32-at base accessible 4) 3)) -6
              (if (not (= (u64-at base accessible 8) 866)) -7
                (if (not (= (u64-at base accessible 16) 50)) -8
                  0)))))))))

(defn main [] 0)
