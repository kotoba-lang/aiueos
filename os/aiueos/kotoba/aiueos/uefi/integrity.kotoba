;; ===========================================================================
;; THIS MODULE HAS NEVER RETURNED ON A CPU. IT IS BLOCKED, AND HERE IS WHY.
;; ===========================================================================
;; It compiles, and every part of it was exercised under OVMF except the one
;; that matters. Measured 2026-09-03, `sha-block` traps with #UD inside a
;; Kotoba UEFI image while the SAME library runs correctly as a kernel object
;; (`sha256-stream.o`, `sha256-region.o`).
;;
;; The cause is not this module and not the memory it touches. Bisected in the
;; guest, one boot per step, marking the debug console after each:
;;
;;   K1        `kernel-scratch-region` written and read back
;;   K12       a 64-byte `kernel-subregion` of a `bytes-literal`, bytes 0 and
;;             63 both correct through the library's own window-64 accessor
;;   K123      `store32`/`load32` round trip, then `sha-init`
;;   -> #UD    `sha-block` over that block and that state
;;
;; and a separate probe stored and read back all eight of offsets 0, 255, 256,
;; 300, 360, 424, 455 and 511 in the scratch state, exit 33 -- so the whole
;; 512-byte window the library uses is sound.
;;
;; THE BLOCKER IS FUEL, AND THE FLAG THAT WOULD RAISE IT IS INERT.
;; `sha256-region.kotoba` measures 1,772 fuel per 64-byte block; a UEFI image
;; runs on `native-fuel!`'s default of 512 (amu
;; `src/kotoba/compiler/nbb/cli.cljs:89`). `--fuel` is READ AND VALIDATED on
;; this route -- 250,000,000 is refused as "native fuel budget is not
;; admitted", 1,048,576 is accepted -- and then does not reach the image:
;;
;;   --fuel 512      -> sha256 714a7509d057b654cb8ae4181284250ce82514626d50e7d25f624cc979872f29
;;   --fuel 1048576  -> sha256 714a7509d057b654cb8ae4181284250ce82514626d50e7d25f624cc979872f29
;;
;; BYTE-IDENTICAL across a 2048x difference in the declared budget, and a
;; 2,000-iteration arithmetic loop traps identically under both while a
;; 200-iteration one completes under both. A knob that is validated and then
;; discarded looks exactly like a knob that works, which is the failure this
;; repository's six questions are about.
;;
;; So this module is landed as source and is NOT wired into
;; `uefi/loader-probe.kotoba`: the probe stays green on what it can actually
;; demonstrate. When the image route installs the declared budget, add the two
;; digest verdicts to the probe and this becomes measurable in one boot -- the
;; call is `(verify (kernel-scratch-region) 16384 src src-len expected)`.
;; ===========================================================================

;; Does this kernel hash to the digest we expected?
;;
;; `os/aiueos/uefi/main.c` asks that twice -- once over a model read from a
;; volume (:676) and once over the embedded release payload, where
;; `read_verified_embedded` (:966-992) compares thirty-two bytes against
;; `aiueos_expected_kernel_sha256` and refuses the boot if any of them differs.
;; That comparison is the loader's central security decision: everything after
;; it runs as ring-0 code on this machine.
;;
;; ---------------------------------------------------------------------------
;; WHAT THIS MODULE DOES NOT CONTAIN
;; ---------------------------------------------------------------------------
;; SHA-256. `aiueos.lib.sha256-stream` already has the compression function and
;; `sha256-region.kotoba` already drives it over a caller region; this calls the
;; same library the same way rather than making a third instance of the rounds.
;; What is here is the part neither of those has: the COMPARISON, and a verdict
;; that names which half failed.
;;
;; ---------------------------------------------------------------------------
;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
;; ---------------------------------------------------------------------------
;;    0  the region hashes to the expected digest
;;    1  st-len below the 512 bytes the state region requires
;;    2  src-len negative
;;    3  src-len above the 1 MiB ceiling `sha256-region.kotoba` states
;;    4  the digest differs from the expected one
;;
;; 4 is deliberately not 0-or-1: a caller that treated "differs" as truthy and
;; "st too small" as truthy alike would refuse for the right reason by accident.
;;
;; ---------------------------------------------------------------------------
;; THE CEILING IS THE WINDOW, NOT THE HASH
;; ---------------------------------------------------------------------------
;; `sha-blocks` narrows the caller's region with `kernel-subregion`, so the
;; SOURCE has to be one region this image may name. The widest bounded window
;; is 65,536 bytes, so a `src` reached through a memory window cannot today be
;; the 1 MiB `KERNEL_BUFFER_SIZE` the C hashes -- the ceiling below is the
;; library's, and the window is a second and lower one that the caller meets or
;; does not. A region that IS 1 MiB needs a base this image may name, which is
;; what an `AllocatePages` result is not yet (its address arrives from a load).
;; Stating the library's ceiling here rather than the window's keeps this module
;; honest when that changes.

(ns aiueos.uefi.integrity
  (:require [aiueos.lib.sha256-stream :as sha])
  (:export [digest-region digest-differs verify]))

;; The same drive `sha256-region.kotoba` performs, against the same library.
(defn digest-region [st src src-len]
  (let [full (quot src-len 64)
        rem (- src-len (* full 64))
        i (sha/sha-init st)
        b (sha/sha-blocks st src src-len 0 full)]
    (+ 1 (* 0 (+ i (+ b (sha/sha-final st
                                       (kernel-subregion src src-len (* full 64) rem)
                                       rem)))))))

;; The raw big-endian digest is at offset 424 of the state region. Answers 1 as
;; soon as a byte differs -- there is nothing secret in a kernel image's hash,
;; so there is nothing here for a timing side channel to learn.
(defn digest-differs [st expected i]
  (if (= i 32) 0
    (if (= (sha/sl st (+ 424 i)) (kernel-load-u8 expected 32 i))
      (digest-differs st expected (+ i 1))
      1)))

(defn verify [st st-len src src-len expected]
  (if (< st-len 512) 1
    (if (< src-len 0) 2
      (if (> src-len 1048576) 3
        (let [d (digest-region st src src-len)]
          (+ (* 0 d) (if (= (digest-differs st expected 0) 0) 0 4)))))))
