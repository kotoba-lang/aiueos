(ns aiueos.qwen35-gguf-kv-scan)

;; GGUF v3 metadata admission for the Qwen3.8-27B artifact
;; (`contracts/qwen38-qwen35-runtime-v1.edn`). A port of
;; `kernel/qwen35_runtime.c`'s `parse_metadata` plus the scalar half of
;; `exact_contract_valid`.
;;
;; It walks the 50 key/value pairs between the container header and the tensor
;; table, requires all 31 keys the C requires with the values the C requires,
;; skips every other key by the C's own bounded rules, and writes what it
;; learned into a caller-owned 128-byte workspace.
;;
;; ## Return
;;
;; **Zero is the success value.** Non-zero is a REASON CODE, never a count:
;;
;;      0            admitted
;;     -1            null model base
;;     -2            null workspace
;;     -3            workspace is not 128 bytes
;;     -4            accessible window below the 24-byte header
;;     -5 .. -8      header: magic, version, tensor count, metadata count
;;     -9            a key string ran past the accessible window
;;    -10            the value that follows a key ran past it
;;    -11            an unknown key's value did not skip (bad type, nesting
;;                   deeper than the C admits, or an element count above the
;;                   C's 1,000,000 ceiling)
;;    -13            not all 31 required keys were present
;;    -14            the metadata section did not end at 10,945,379
;;    -51 .. -80     a contract scalar disagreed; the code is -(50 + slot/4),
;;                   so the workspace slot names the field
;;   -100 .. -130    required key k carried the wrong GGUF value TYPE
;;   -200 .. -230    required key k carried the wrong VALUE, or its value ran
;;                   past the window
;;
;; The header clauses are repeated here rather than delegated to
;; `aiueos-qwen35-gguf-header-valid`: a kernel object exports one symbol and
;; cannot call another (ADR-0030). Their codes are deliberately the SAME
;; -5..-8, so the two objects do not disagree about what a bad magic is called.
;;
;; ## Workspace (128 bytes, u32 little-endian, all written by this object)
;;
;;     0  tensor-table offset (= metadata end)   10945379
;;     4  block_count                                  65
;;     8  context_length                           262144
;;    12  embedding_length                           5120
;;    16  feed_forward_length                       17408
;;    20  attention.head_count                         24
;;    24  attention.head_count_kv                       4
;;    28  attention.key_length                        256
;;    32  attention.value_length                      256
;;    36  ssm.group_count      (linear key heads)      16
;;    40  ssm.time_step_rank   (linear value heads)    48
;;    44  ssm.state_size                              128
;;    48  ssm.inner_size                             6144
;;    52  ssm.conv_kernel                               4
;;    56  full_attention_interval                       4
;;    60  rope.dimension_count                         64
;;    64  rope.dimension_sections[0]                   11
;;    68  rope.dimension_sections[1]                   11
;;    72  rope.dimension_sections[2]                   10
;;    76  rope.dimension_sections[3]                    0
;;    80  nextn_predict_layers                          1
;;    84  vocabulary                               248320
;;    88  tokenizer bos                            248044
;;    92  tokenizer eos                            248046
;;    96  tokenizer padding                        248055
;;   100  token array: file offset of the first element
;;   104  token array: element count               248320
;;   108  token array: file offset just past the last element
;;   112  merge array: file offset of the first element
;;   116  merge array: element count               247587
;;   120  merge array: file offset just past the last element
;;   124  required-key mask                    2147483647
;;
;; Slots 100..120 are what a later tokenizer stream needs and the C never
;; recorded: `read_expected_array_length` walks those two arrays to prove they
;; parse and then throws the coordinates away, so every later reader would have
;; to walk 495,907 length-prefixed strings again to find where they start.
;;
;; The data-section offset is NOT here. It is `align32(tensor_info_end)`, and
;; `tensor_info_end` is not known until the tensor table has been walked --
;; that is `aiueos-qwen35-tensor-table-bind`'s output, and putting the
;; artifact's expected value here would be transcribing a constant rather than
;; deriving one. Slot 0 is where that walk starts.
;;
;; ## Reading a 10.9 GiB region through a 512-byte window
;;
;; `kernel-load-u32` refuses a declared length above 512, so the region length
;; can never be handed to a load. Every access narrows with `kernel-subregion`
;; first, whose own offset/sub-length check is emitted by the backends -- so a
;; four-byte window at a computed offset is checked rather than asserted.
;;
;; ## Where this is deliberately narrower than the C
;;
;; `qwen35.attention.layer_norm_rms_epsilon` is a float32 and this dialect has
;; no float32, so the range check is done on the IEEE-754 BIT PATTERN, which is
;; monotonic in the value for positive finite floats. That admits exactly the
;; positive floats in [0.0000009f, 0.0000011f]. The C writes
;; `if (epsilon < 0.0000009f || epsilon > 0.0000011f) return 0;` and a NaN
;; compares false against both, so **the C admits NaN here and this object
;; refuses it**. The divergence is in the refusing direction, against a value
;; the admitted artifact does not carry (its epsilon is 1e-6f, bits
;; 897988541), and it is stated rather than discovered.

;; ---------------------------------------------------------------- readers

(defn u8-at [base length off]
  (kernel-load-u8 (kernel-subregion base length off 1) 1 0))

(defn u32-at [base length off]
  (kernel-load-u32 (kernel-subregion base length off 4) 4 0))

;; `low | (high << 32)` in the C. The product wraps modulo 2^64 exactly as the
;; C's uint64_t does, so the BITS agree; what differs is the reading, and every
;; caller that treats this as a length refuses a negative result before using
;; it -- which is the same refusal the C's unsigned comparison performs, since
;; a value at or above 2^63 cannot be a length inside an 11 MB prefix.
(defn u64-at [base length off]
  (+ (u32-at base length off)
     (* (u32-at base length (+ off 4)) 4294967296)))

;; ------------------------------------------------------- literal key table
;;
;; The 31 required keys, then the three expected string VALUES (entries 31..33)
;; so that one comparison routine serves both. Eight ASCII bytes per word: the
;; high byte of a key is always below 0x80, so a packed word is a positive i64
;; and `quot` is exact.
;;
;;  0 general.architecture                     17 qwen35.ssm.time_step_rank
;;  1 general.name                             18 qwen35.ssm.inner_size
;;  2 qwen35.block_count                       19 qwen35.full_attention_interval
;;  3 qwen35.context_length                    20 qwen35.rope.dimension_count
;;  4 qwen35.embedding_length                  21 tokenizer.ggml.model
;;  5 qwen35.feed_forward_length               22 tokenizer.ggml.pre
;;  6 qwen35.attention.head_count              23 tokenizer.ggml.tokens
;;  7 qwen35.attention.head_count_kv           24 tokenizer.ggml.token_type
;;  8 qwen35.rope.dimension_sections           25 tokenizer.ggml.merges
;;  9 qwen35.rope.freq_base                    26 tokenizer.ggml.eos_token_id
;; 10 qwen35.attention.layer_norm_rms_epsilon  27 tokenizer.ggml.padding_token_id
;; 11 qwen35.attention.key_length              28 tokenizer.ggml.bos_token_id
;; 12 qwen35.attention.value_length            29 general.quantization_version
;; 13 qwen35.nextn_predict_layers              30 general.file_type
;; 14 qwen35.ssm.conv_kernel                   31 "qwen35"
;; 15 qwen35.ssm.state_size                    32 "Qwen3.8-27B"
;; 16 qwen35.ssm.group_count                   33 "gpt2"

(defn key-length [i]
  (if (= i 0) 20 (if (= i 1) 12 (if (= i 2) 18 (if (= i 3) 21 (if (= i 4) 23
  (if (= i 5) 26 (if (= i 6) 27 (if (= i 7) 30 (if (= i 8) 30 (if (= i 9) 21
  (if (= i 10) 39 (if (= i 11) 27 (if (= i 12) 29 (if (= i 13) 27 (if (= i
  14) 22 (if (= i 15) 21 (if (= i 16) 22 (if (= i 17) 25 (if (= i 18) 21 (if
  (= i 19) 30 (if (= i 20) 27 (if (= i 21) 20 (if (= i 22) 18 (if (= i 23)
  21 (if (= i 24) 25 (if (= i 25) 21 (if (= i 26) 27 (if (= i 27) 31 (if (=
  i 28) 27 (if (= i 29) 28 (if (= i 30) 17 (if (= i 31) 6 (if (= i 32) 11
  (if (= i 33) 4 0)))))))))))))))))))))))))))))))))))

(defn key-word [i]
  (if (= i 0) 3345155767185335655 (if (= i 1) 7162258778474377825 (if (= i
  2) 1701999988 (if (= i 5) 3345155767185335655 (if (= i 6) 1701667182 (if
  (= i 10) 7074650559657375601 (if (= i 11) 8462091486327172972 (if (= i 12)
  29806 (if (= i 15) 7146708153695303537 (if (= i 16) 7809088339330756207
  (if (= i 17) 448629534309 (if (= i 20) 7290823341771159409 (if (= i 21)
  7453010313246761581 (if (= i 22) 29401385160502367 (if (= i 25)
  7362880935809087345 (if (= i 26) 8607064323336201573 (if (= i 27)
  7453005949476041313 (if (= i 28) 26740 (if (= i 30) 7002592965619447665
  (if (= i 31) 7957695015376221300 (if (= i 32) 8026363845639759918 (if (= i
  33) 7630453 (if (= i 35) 7002592965619447665 (if (= i 36)
  7957695015376221300 (if (= i 37) 8026363845639759918 (if (= i 38)
  130203535044213 (if (= i 40) 8227572064264222577 (if (= i 41)
  7308613649288228975 (if (= i 42) 7310291548072670062 (if (= i 43)
  126918152778851 (if (= i 45) 8227572064264222577 (if (= i 46)
  8171062882124263535 (if (= i 47) 435727458911 (if (= i 50)
  7002592965619447665 (if (= i 51) 7957695015376221300 (if (= i 52)
  7953201247113276462 (if (= i 53) 6877961393919586927 (if (= i 54)
  31084758854496357 (if (= i 55) 7002592965619447665 (if (= i 56)
  7957695015376221300 (if (= i 57) 7954883474134231854 (if (= i 58) 6845543
  (if (= i 60) 7002592965619447665 (if (= i 61) 7957695015376221300 (if (= i
  62) 7809071833887634990 (if (= i 63) 448629534309 (if (= i 65)
  7939341688112510833 (if (= i 66) 7310028700353067109 (if (= i 67)
  8746391108560578916 (if (= i 68) 7565925 (if (= i 70) 8299629658302150513
  (if (= i 71) 6878806905539423603 (if (= i 72) 119182900487531 (if (= i 75)
  8299629658302150513 (if (= i 76) 7310575247905680755 (if (= i 77)
  435845428063 (if (= i 80) 8299629658302150513 (if (= i 81)
  8103505641671126387 (if (= i 82) 128017765458783 (if (= i 85)
  8299629658302150513 (if (= i 86) 6874020705939123571 (if (= i 87)
