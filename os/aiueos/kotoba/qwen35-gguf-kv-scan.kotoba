  7954882443257803631 (if (= i 143) 6580575 (if (= i 145)
  3345155767185335655 (if (= i 146) 7024042517626713457 (if (= i 147)
  8243124845218326900 (if (= i 148) 1852795251 (if (= i 150)
  3345155767185335655 (if (= i 151) 8104636957502237030 (if (= i 152) 101
  (if (= i 155) 58495011747697 (if (= i 160) 3258405128832907089 (if (= i
  161) 4339506 (if (= i 165) 846491751
  0))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

;; `bit-shift-left` has no admitted lowering in this subset (measured against
;; amu b1fdaad2), so the two powers below are tables rather than shifts.
(defn pow256 [r]
  (if (= r 0) 1 (if (= r 1) 256 (if (= r 2) 65536 (if (= r 3) 16777216
  (if (= r 4) 4294967296 (if (= r 5) 1099511627776
  (if (= r 6) 281474976710656 (if (= r 7) 72057594037927936 0)))))))))

(defn pow2 [k]
  (if (= k 0) 1 (if (= k 1) 2 (if (= k 2) 4 (if (= k 3) 8 (if (= k 4) 16
  (if (= k 5) 32 (if (= k 6) 64 (if (= k 7) 128 (if (= k 8) 256
  (if (= k 9) 512 (if (= k 10) 1024 (if (= k 11) 2048 (if (= k 12) 4096
  (if (= k 13) 8192 (if (= k 14) 16384 (if (= k 15) 32768 (if (= k 16) 65536
  (if (= k 17) 131072 (if (= k 18) 262144 (if (= k 19) 524288
  (if (= k 20) 1048576 (if (= k 21) 2097152 (if (= k 22) 4194304
  (if (= k 23) 8388608 (if (= k 24) 16777216 (if (= k 25) 33554432
  (if (= k 26) 67108864 (if (= k 27) 134217728 (if (= k 28) 268435456
  (if (= k 29) 536870912 (if (= k 30) 1073741824 0))))))))))))))))))))))))))))))))

(defn key-byte [k i]
  (bit-and (quot (key-word (+ (* k 5) (quot i 8)))
                 (pow256 (- i (* 8 (quot i 8)))))
           255))

;; The C's `string_is`, which compares lengths first; every caller has already
;; matched the length, so this only walks the bytes.
(defn key-eq-from [base accessible koff k i]
  (if (= i (key-length k)) 1
    (if (= (u8-at base accessible (+ koff i)) (key-byte k i))
      (key-eq-from base accessible koff k (+ i 1))
      0)))

;; The index of the required key this one is, or 31 for "not one of them" --
;; which is the C's `else if` chain falling through to `skip_value`.
(defn key-index-from [base accessible koff klen k]
  (if (= k 31) 31
    (if (= klen (key-length k))
      (if (= (key-eq-from base accessible koff k 0) 1)
        k
        (key-index-from base accessible koff klen (+ k 1)))
      (key-index-from base accessible koff klen (+ k 1)))))

;; ------------------------------------------------------- the C's skip_value
;;
;; `scalar_size`: zero means "not a scalar", which is how the C tells a string
;; or an array from a number.
(defn scalar-size [t]
  (if (= t 0) 1 (if (= t 1) 1 (if (= t 7) 1
  (if (= t 2) 2 (if (= t 3) 2
  (if (= t 4) 4 (if (= t 5) 4 (if (= t 6) 4
  (if (= t 10) 8 (if (= t 11) 8 (if (= t 12) 8 0))))))))))))

;; `read_string`: a u64 length then that many bytes. Returns the position just
;; past, or -1. A length at or above 2^63 arrives negative and is refused
;; before the bound comparison, because a signed `>` would admit it.
(defn skip-string [base accessible pos]
  (if (> (+ pos 8) accessible) -1
    (let [len (u64-at base accessible pos)]
      (if (< len 0) -1
        (if (> len (- accessible (+ pos 8))) -1
          (+ pos (+ 8 len)))))))

;; The C's `skip_value` is recursive with a `depth >= 2` cut-off. A kernel
;; object cannot express mutual recursion, so the three depths are unrolled
;; into three functions -- which makes the cut-off structural rather than a
;; counter that could be miscompared.
(defn skip-d2 [base accessible pos t]
  (let [size (scalar-size t)]
    (if (> size 0)
      (if (> size (- accessible pos)) -1 (+ pos size))
      (if (= t 8) (skip-string base accessible pos) -1))))

(defn skip-d2-elements [base accessible pos t n]
  (if (= n 0) pos
    (let [next (skip-d2 base accessible pos t)]
      (if (< next 0) next
        (skip-d2-elements base accessible next t (- n 1))))))

(defn skip-d1 [base accessible pos t]
  (let [size (scalar-size t)]
    (if (> size 0)
      (if (> size (- accessible pos)) -1 (+ pos size))
      (if (= t 8) (skip-string base accessible pos)
        (if (not (= t 9)) -1
          (if (> (+ pos 12) accessible) -1
            (let [et (u32-at base accessible pos)
                  n (u64-at base accessible (+ pos 4))
                  es (scalar-size (u32-at base accessible pos))]
              (if (< n 0) -1
                (if (> n 1000000) -1
                  (if (> es 0)
                    (if (> (* es n) (- accessible (+ pos 12))) -1
                      (+ pos (+ 12 (* es n))))
                    (skip-d2-elements base accessible (+ pos 12) et n)))))))))))

(defn skip-d1-elements [base accessible pos t n]
  (if (= n 0) pos
    (let [next (skip-d1 base accessible pos t)]
      (if (< next 0) next
        (skip-d1-elements base accessible next t (- n 1))))))

(defn skip-d0 [base accessible pos t]
  (let [size (scalar-size t)]
    (if (> size 0)
      (if (> size (- accessible pos)) -1 (+ pos size))
      (if (= t 8) (skip-string base accessible pos)
        (if (not (= t 9)) -1
          (if (> (+ pos 12) accessible) -1
            (let [et (u32-at base accessible pos)
                  n (u64-at base accessible (+ pos 4))
                  es (scalar-size (u32-at base accessible pos))]
              (if (< n 0) -1
                (if (> n 1000000) -1
                  (if (> es 0)
                    (if (> (* es n) (- accessible (+ pos 12))) -1
                      (+ pos (+ 12 (* es n))))
                    (skip-d1-elements base accessible (+ pos 12) et n)))))))))))

;; The two tokenizer arrays hold 248,320 and 247,587 length-prefixed strings.
;; `skip-d2-elements` would walk them one recursive call deep per element,
;; which is what the machine does and what the KIR oracle cannot: the
;; interpreter recurses on its host stack, so a 248,320-deep walk is a host
;; stack overflow rather than a verdict. Chunking makes the deepest host stack
;; ~2 x sqrt(n) instead of n, and on the machine it is the same loop -- the
;; backend turns self tail calls into a jump, so the chunk only costs the
;; 970 extra fuel of the outer loop.
;; `skip-string` is inlined here rather than called. It is the same three
;; clauses, and the reason is cost: this is the only loop in the object whose
;; trip count is in the hundreds of thousands, so every call it makes is
;; multiplied by 495,907. Calling `skip-string` (which calls `u64-at`, which
;; calls `u32-at` twice) is five charged calls per element instead of one --
;; 2.5 million rather than 496,000, on the machine's fuel and in the oracle's
;; interpreter alike.
(defn skip-strings-chunk [base accessible pos n]
  (if (= n 0) pos
    (if (> (+ pos 8) accessible) -1
      (let [len (+ (kernel-load-u32 (kernel-subregion base accessible pos 4) 4 0)
                   (* (kernel-load-u32
                       (kernel-subregion base accessible (+ pos 4) 4) 4 0)
                      4294967296))]
        (if (< len 0) -1
          (if (> len (- accessible (+ pos 8))) -1
            (skip-strings-chunk base accessible (+ pos (+ 8 len))
                                (- n 1))))))))

(defn skip-strings [base accessible pos remaining]
  (if (= remaining 0) pos
    (let [chunk (if (> remaining 512) 512 remaining)
          next (skip-strings-chunk base accessible pos chunk)]
      (if (< next 0) next
        (skip-strings base accessible next (- remaining chunk))))))

;; ------------------------------------------------------------ key dispatch
;;
;; 1 uint32 (stored, sometimes with a required value)   5 float32 in a range
;; 2 an expected string                                 6 string array + walk
;; 3 the four rope sections                             7 int32 array + skip
;; 4 float32 with one exact value
(defn key-kind [k]
  (if (= k 0) 2 (if (= k 1) 2 (if (= k 8) 3 (if (= k 9) 4 (if (= k 10) 5
  (if (= k 21) 2 (if (= k 22) 2 (if (= k 23) 6 (if (= k 24) 7
  (if (= k 25) 6 1)))))))))))

;; Workspace slot for a stored uint32, or -1 for one the C checks and drops.
(defn plan-slot [k]
  (if (= k 2) 4 (if (= k 3) 8 (if (= k 4) 12 (if (= k 5) 16 (if (= k 6) 20
  (if (= k 7) 24 (if (= k 11) 28 (if (= k 12) 32 (if (= k 13) 80
  (if (= k 14) 52 (if (= k 15) 44 (if (= k 16) 36 (if (= k 17) 40
  (if (= k 18) 48 (if (= k 19) 56 (if (= k 20) 60 (if (= k 26) 92
  (if (= k 27) 96 (if (= k 28) 88 -1))))))))))))))))))))

;; The five uint32 keys the C compares against a literal, and -1 for the rest.
(defn expect-u32 [k]
  (if (= k 26) 248046 (if (= k 27) 248055 (if (= k 28) 248044
  (if (= k 29) 2 (if (= k 30) 23 -1))))))

;; Table entry holding the expected string value.
(defn expect-str [k]
  (if (= k 0) 31 (if (= k 1) 32 (if (= k 21) 33 (if (= k 22) 31 -1)))))

(defn array-count [k]
  (if (= k 23) 248320 (if (= k 24) 248320 (if (= k 25) 247587 -1))))

(defn array-slot [k]
  (if (= k 23) 100 (if (= k 25) 112 -1)))

;; --------------------------------------------------------- value handlers
;;
;; Each takes the position of the VALUE and re-reads the GGUF type word that
;; precedes it. Re-reading four bytes costs less than the sixth parameter the
;; ABI does not have.

(defn rv-u32 [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 4)) (- -100 k)
    (if (> (+ vpos 4) accessible) (- -200 k)
      (let [v (u32-at base accessible vpos)
            e (expect-u32 k)
            s (plan-slot k)]
        (if (if (< e 0) false (not (= v e)))
          (- -200 k)
          (do (if (< s 0) 0 (kernel-store-u32 plan 128 s v))
              (+ vpos 4)))))))

(defn rv-string [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 8)) (- -100 k)
    (if (> (+ vpos 8) accessible) (- -200 k)
      (let [len (u64-at base accessible vpos)
            e (expect-str k)]
        (if (< len 0) (- -200 k)
          (if (> len (- accessible (+ vpos 8))) (- -200 k)
            (if (not (= len (key-length e))) (- -200 k)
              (if (= (key-eq-from base accessible (+ vpos 8) e 0) 1)
                (+ vpos (+ 8 len))
                (- -200 k)))))))))

(defn rv-rope [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 9)) (- -100 k)
    (if (> (+ vpos 28) accessible) (- -200 k)
      (if (not (= (u32-at base accessible vpos) 5)) (- -200 k)
        (if (not (= (u64-at base accessible (+ vpos 4)) 4)) (- -200 k)
          (do (kernel-store-u32 plan 128 64 (u32-at base accessible (+ vpos 12)))
              (kernel-store-u32 plan 128 68 (u32-at base accessible (+ vpos 16)))
              (kernel-store-u32 plan 128 72 (u32-at base accessible (+ vpos 20)))
              (kernel-store-u32 plan 128 76 (u32-at base accessible (+ vpos 24)))
              (+ vpos 28)))))))

;; 1259902592 is the IEEE-754 single of 10000000.0f, which is what the C's
;; `read_f32(reader) != 10000000.0f` compares. Comparing the bits is exact for
;; a value that is not NaN, and 10000000.0f is not.
(defn rv-f32-exact [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 6)) (- -100 k)
    (if (> (+ vpos 4) accessible) (- -200 k)
      (if (= (u32-at base accessible vpos) 1259902592) (+ vpos 4)
        (- -200 k)))))

;; 896636807 and 898868150 are the bits of 0.0000009f and 0.0000011f. See the
;; header for the one place this is narrower than the C.
(defn rv-f32-range [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 6)) (- -100 k)
    (if (> (+ vpos 4) accessible) (- -200 k)
      (let [b (u32-at base accessible vpos)]
        (if (< b 896636807) (- -200 k)
          (if (> b 898868150) (- -200 k) (+ vpos 4)))))))

(defn rv-str-array [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 9)) (- -100 k)
    (if (> (+ vpos 12) accessible) (- -200 k)
      (if (not (= (u32-at base accessible vpos) 8)) (- -200 k)
        (if (not (= (u64-at base accessible (+ vpos 4)) (array-count k))) (- -200 k)
          (let [start (+ vpos 12)
                end (skip-strings base accessible start (array-count k))]
            (if (< end 0) (- -200 k)
              (do (kernel-store-u32 plan 128 (array-slot k) start)
                  (kernel-store-u32 plan 128 (+ (array-slot k) 4) (array-count k))
                  (kernel-store-u32 plan 128 (+ (array-slot k) 8) end)
                  (if (= k 23) (kernel-store-u32 plan 128 84 248320) 0)
                  end))))))))

(defn rv-i32-array [k base accessible vpos plan]
  (if (not (= (u32-at base accessible (- vpos 4)) 9)) (- -100 k)
    (if (> (+ vpos 12) accessible) (- -200 k)
      (if (not (= (u32-at base accessible vpos) 5)) (- -200 k)
        (if (not (= (u64-at base accessible (+ vpos 4)) (array-count k))) (- -200 k)
          (if (> (* 4 (array-count k)) (- accessible (+ vpos 12))) (- -200 k)
            (+ vpos (+ 12 (* 4 (array-count k))))))))))

(defn required-value [k base accessible vpos plan]
  (let [kind (key-kind k)]
    (if (= kind 1) (rv-u32 k base accessible vpos plan)
      (if (= kind 2) (rv-string k base accessible vpos plan)
        (if (= kind 3) (rv-rope k base accessible vpos plan)
          (if (= kind 4) (rv-f32-exact k base accessible vpos plan)
            (if (= kind 5) (rv-f32-range k base accessible vpos plan)
              (if (= kind 6) (rv-str-array k base accessible vpos plan)
                (if (= kind 7) (rv-i32-array k base accessible vpos plan)
                  (- -100 k))))))))))

;; --------------------------------------------- the scalar exact contract
;;
;; `exact_contract_valid`'s scalar half, read back out of the workspace so that
;; what is CHECKED is what was WRITTEN. Checking the values as they arrive
;; would leave the workspace unverified, which is the half a later object
;; consumes. -1 means the slot carries a derived offset with nothing to
;; compare it to.
(defn expect-slot [slot]
  (if (= slot 4) 65 (if (= slot 8) 262144 (if (= slot 12) 5120
  (if (= slot 16) 17408 (if (= slot 20) 24 (if (= slot 24) 4
  (if (= slot 28) 256 (if (= slot 32) 256 (if (= slot 36) 16
  (if (= slot 40) 48 (if (= slot 44) 128 (if (= slot 48) 6144
  (if (= slot 52) 4 (if (= slot 56) 4 (if (= slot 60) 64
  (if (= slot 64) 11 (if (= slot 68) 11 (if (= slot 72) 10
  (if (= slot 76) 0 (if (= slot 80) 1 (if (= slot 84) 248320
  (if (= slot 88) 248044 (if (= slot 92) 248046 (if (= slot 96) 248055
  (if (= slot 104) 248320 (if (= slot 116) 247587 -1)))))))))))))))))))))))))))

(defn contract-ok [plan slot]
  (if (> slot 120) 0
    (let [e (expect-slot slot)]
      (if (< e 0) (contract-ok plan (+ slot 4))
        (if (= (kernel-load-u32 plan 128 slot) e)
          (contract-ok plan (+ slot 4))
          (- 0 (+ 50 (quot slot 4))))))))

(defn plan-clear [plan off]
  (if (>= off 128) 0
    (do (kernel-store-u32 plan 128 off 0)
        (plan-clear plan (+ off 4)))))

;; ------------------------------------------------------------- the walk

(defn scan-entries [base accessible plan pos index]
  (if (= index 50)
    (if (not (= (kernel-load-u32 plan 128 124) 2147483647)) -13
      (if (not (= pos 10945379)) -14
        (do (kernel-store-u32 plan 128 0 pos)
            (contract-ok plan 4))))
    (if (> (+ pos 8) accessible) -9
      (let [klen (u64-at base accessible pos)]
        (if (< klen 0) -9
          (if (> klen (- accessible (+ pos 8))) -9
            (let [koff (+ pos 8)
                  tpos (+ koff klen)]
              (if (> (+ tpos 4) accessible) -10
                (let [k (key-index-from base accessible koff klen 0)]
                  (if (= k 31)
                    (let [next (skip-d0 base accessible (+ tpos 4)
                                        (u32-at base accessible tpos))]
                      (if (< next 0) -11
                        (scan-entries base accessible plan next (+ index 1))))
                    (let [next (required-value k base accessible (+ tpos 4) plan)]
                      (if (< next 0) next
                        (do (kernel-store-u32 plan 128 124
                              (bit-or (kernel-load-u32 plan 128 124) (pow2 k)))
                            (scan-entries base accessible plan next
                                          (+ index 1)))))))))))))))

(defn aiueos-qwen35-gguf-kv-scan [base accessible plan plan-length]
  (if (= base 0) -1
    (if (= plan 0) -2
      (if (not (= plan-length 128)) -3
        (if (< accessible 24) -4
          (if (not (= (u32-at base accessible 0) 1179993927)) -5
            (if (not (= (u32-at base accessible 4) 3)) -6
              (if (not (= (u64-at base accessible 8) 866)) -7
                (if (not (= (u64-at base accessible 16) 50)) -8
                  (do (plan-clear plan 0)
                      (scan-entries base accessible plan 24 0)))))))))))

(defn main [] 0)
