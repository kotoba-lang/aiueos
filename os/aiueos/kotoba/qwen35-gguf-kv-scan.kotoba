  (= i 91) 8243116113461669235 (if (= i 92) 435845428063 (if (= i 95)
  7362880935809087345 (if (= i 96) 7310596056690748533 (if (= i 97)
  7955995144646915182 (if (= i 98) 119165854836084 (if (= i 100)
