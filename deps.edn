{:paths ["src" "resources"]
 ;; The decision plane left this repository on 2026-08-21 (root
 ;; ADR-2608219500). `grant` decides whether a component may run; what is
 ;; still here is the machine that runs it. The edge is one-way and the
 ;; require graph is checkable: nothing in `grant` requires `aiueos`.
 ;;
 ;; `abi` is no longer a direct dependency -- `grant.component-abi` and
 ;; `grant.contract` were the only namespaces that used it, and they moved.
 ;; It still arrives transitively through `grant`; it is not restated here,
 ;; because a dependency nothing in this repository requires is a claim
 ;; about the wrong repository.
 :deps {io.github.kotoba-lang/grant {:git/url "https://github.com/kotoba-lang/grant.git"
                                     :git/sha "86d15e306853bd3658efb1fdfde3f8508dba9ef3"}
        io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "74235d1cdf8034334f01dcb2f6faaff0c731146e"}
        ;; This workspace's own TLS 1.3 and HTTP/1.1, so a request can leave
        ;; this machine without `java.net.http`. Both are RUNTIME dependencies
        ;; of `aiueos.provider.cloud-own` and both are TCB: a TLS client that
        ;; accepts the wrong peer, or an HTTP parser that mis-frames a body,
        ;; ends with this machine acting on somebody else's bytes.
        ;;
        ;; Pinned at each repository's `main` tip; `gh api
        ;; repos/kotoba-lang/<repo>/compare/<sha>...main` answers `identical`
        ;; for both, measured 2026-08-22. org-ietf-x509, org-ietf-asn1 and
        ;; kotoba-lang/json arrive transitively and are not restated here --
        ;; a dependency no namespace in this repository requires by name is a
        ;; claim about the wrong repository.
        io.github.kotoba-lang/org-ietf-tls
        {:git/url "https://github.com/kotoba-lang/org-ietf-tls.git"
         :git/sha "b91d4a144e7ce89380643e440f7eac48d91e45a4"}
        io.github.kotoba-lang/http
        {:git/url "https://github.com/kotoba-lang/http.git"
         :git/sha "1af5514a3a27098812be4e172d718908fb58e78e"}
        ;; Portable compositor session state (z-stack, focus, window
        ;; lifecycle). GPU draw stays kami.webgpu.ir in the SPA canvas.
        io.github.kotoba-lang/window-session-state
        {:git/url "https://github.com/kotoba-lang/window-session-state.git"
         :git/sha "8a897953ce207c42838b81f13482464cac14fabb"}
        ;; Hosted Kotoba Browser device approval renders the canonical
        ;; auth.kotoba.cloud URL locally. No third-party QR endpoint learns a
        ;; live approval flow. Version 1.8.0 is the upstream Maven release.
        io.nayuki/qrcodegen {:mvn/version "1.8.0"}
        ;; Device-owned CAIP-122/CACAO.  AIUEOS keeps the raw Ed25519 seed on
        ;; the node, signs its own Murakumo heartbeat/queue capabilities, and
        ;; never asks auth.kotoba.cloud to impersonate the device.
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         :git/sha "cd98347a1b8460186dd1bb63ed818fb7d01ffd8a"}
        com.dylibso.chicory/wasm {:mvn/version "1.4.0"}
        com.dylibso.chicory/runtime {:mvn/version "1.4.0"}}
 :aliases
  {:test {:extra-paths ["test"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         ;; TEST-ONLY. The compiler and the KIR interpreter drive
         ;; `tcp-seq-acceptable.kotoba`; org-ietf-tcp supplies the reference
         ;; implementation it is checked against. None of the three is linked
         ;; into anything this repo ships.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/kotoba-kir
                      {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                       :git/sha "674a5beea7c6c02178a69808db05dcad65397f1b"}
                      ;; TEST-ONLY, and pinned directly rather than taken
                      ;; through amu, because the admission verifiers need the
                      ;; `kernel-object-entries` row for
                      ;; `kotoba_aiueos_cid_v1_admit`. Closest-wins puts this
                      ;; ahead of amu's own kotoba-native pin.
                      io.github.kotoba-lang/kotoba-native
                      {:git/url "https://github.com/kotoba-lang/kotoba-native.git"
                       :git/sha "ff02fd24bfd24bf8a44373319a9fc0eec73a374e"}
                      ;; The repository was renamed compiler -> amu. One
                      ;; repository reachable under two coordinates is what the
                      ;; workspace's dep-coordinate-identity detector exists to
                      ;; catch, so the coordinate follows the name.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "6889fa736750348863d2b98d69e688131a2ca515"}
                      io.github.kotoba-lang/org-ietf-tcp
                      {:git/url "https://github.com/kotoba-lang/org-ietf-tcp.git"
                       :git/sha "d8c15e23b6c169a4ed044cd7764923ecbb789be4"}
                      ;; TEST-ONLY, and the whole point of it is that it is a
                      ;; DIFFERENT implementation: `aiueos.sha256-stream-parity-test`
                      ;; re-derives every digest the three streaming SHA-256
                      ;; contracts assert, from the message each contract
                      ;; describes, so a transcription error in a contract is
                      ;; caught by something that did not read the contract's
                      ;; answer. Pure `.cljc`; nothing this repo ships links it.
                      io.github.kotoba-lang/org-nist-sha2
                      {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
                       :git/sha "cb67e53e590e0999d741523797729a3d747cda95"}
                      ;; Hosted kami IR constructors (kami.webgpu.ir). The
                      ;; browser executor stays cljs; this is the JVM floor.
                      io.github.kotoba-lang/webgpu
                      {:git/url "https://github.com/kotoba-lang/webgpu.git"
                       :git/sha "17598c1206a31e594b0e028245f222e53b1b8b71"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

   ;; The fleet's suite. It used to be `:test` minus `-e :upstream-blocked`,
   ;; which dropped exactly one test whose twelve failures ADR-0050 established
   ;; as correct and amu#625/#626 owned. Both are answered as of 2026-08-20 --
   ;; #625 landed as a lock rather than a compare-exchange -- so the twelve are
   ;; declared rather than silently unbuilt and nothing is excluded here.
   ;;
   ;; It exists so a murakumo fleet gate can be green when the repository is
   ;; healthy. Lowering a threshold to get there would have been the other
   ;; option, and it would have made every future failure invisible instead of
   ;; one known one explicit (ADR-0063).
   :test-fleet {:extra-paths ["test"]
                :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             io.github.kotoba-lang/kotoba-kir
                             {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                              :git/sha "674a5beea7c6c02178a69808db05dcad65397f1b"}
                             io.github.kotoba-lang/kotoba-native
                             {:git/url "https://github.com/kotoba-lang/kotoba-native.git"
                              :git/sha "ff02fd24bfd24bf8a44373319a9fc0eec73a374e"}
                             io.github.kotoba-lang/amu
                             {:git/url "https://github.com/kotoba-lang/amu.git"
                              :git/sha "6889fa736750348863d2b98d69e688131a2ca515"}
                             ;; Same reason as in `:test`, and it has to be here
                             ;; too: this alias selects every `aiueos.*`
                             ;; namespace except one, so
                             ;; `sha256-stream-parity-test` runs on the fleet
                             ;; and would fail to LOAD without it -- which reads
                             ;; as a broken test rather than a missing pin.
                             ;; org-nist-sha2 is PUBLIC, unlike org-ietf-tcp,
                             ;; so a credential-free node can resolve it
                             ;; (ADR-0068).
                             io.github.kotoba-lang/org-nist-sha2
                             {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
                              :git/sha "cb67e53e590e0999d741523797729a3d747cda95"}
                             io.github.kotoba-lang/webgpu
                             {:git/url "https://github.com/kotoba-lang/webgpu.git"
                              :git/sha "17598c1206a31e594b0e028245f222e53b1b8b71"}
                             }
                ;; No org-ietf-tcp here, and the parity test that needs it is
                ;; not selected. **That repository is private**, and fleet nodes
                ;; hold no credentials by invariant, so `clojure -P` on a node
                ;; dies with "could not read Username for https://github.com"
                ;; before a single test runs — which is how this alias failed
                ;; its first real gate (ADR-0068).
                :main-opts ["-m" "cognitect.test-runner"
                            "-r" "^aiueos\\.(?!tcp-seq-acceptable-parity-test).*$"]}

   ;; The nbb admission runner (os/aiueos/scripts/verify-admissions.cljs).
   ;; A SEPARATE alias with its OWN amu pin on purpose: the runner needs
   ;; kotoba.compiler.project's ClojureScript printer fix (amu#714), while
   ;; :test keeps the compiler the committed value-runtime verdicts were
   ;; measured against. Advancing :test instead would have moved that pin 255
   ;; commits and re-measured ten receipts as a side effect of adding a runner.
   ;; ADVANCED 2026-09-02 (ADR-0139). The previous pin (0085e138) predates
   ;; amu#742, so `project/link-source` could not link a module a kernel object
   ;; imports -- and all three streaming SHA-256 contracts are two-module
   ;; projects. ADR-0135's "Not done" named advancing this as the next change;
   ;; this is it. `hkdf-sha256-v1.edn` runs on this pin too, which is what
   ;; ADR-0135 could only do by passing a closure in by hand.
   :verify-admissions
   {:extra-deps {io.github.kotoba-lang/amu
                 {:git/url "https://github.com/kotoba-lang/amu.git"
                  :git/sha "ca869d79e118a3d1eb532602bcb4c39c87f6ea29"}
                 ;; Pinned explicitly, not taken through amu: amu's own pin
                 ;; predates `kir/execute`'s optional memory image, and without
                 ;; it every vector traps `:kernel-memory-unavailable`. The
                 ;; runner refuses rather than reporting a pass in that case,
                 ;; which is how this was caught.
                 ;;
                 ;; ADVANCED 2026-09-02 for the RTL8125 driver objects, and the
                 ;; FRONTEND had to move with it. At the pins this alias carried
                 ;; before, `kernel-fence-load` / `kernel-fence-store` /
                 ;; `kernel-rdtsc` (the SYSOPS slice) have no entry in
                 ;; `kotoba.compiler.frontend`'s operator table, so
                 ;; `sema/analyze` refuses the whole module with `operation has
                 ;; no admitted type signature` -- four of the six driver
                 ;; objects could not be lowered at all, let alone executed, and
                 ;; a runner that cannot lower an object cannot report anything
                 ;; about it.
                 ;;
                 ;; `kotoba-sema` is pinned to the SHA amu's own `deps.edn`
                 ;; names at the tip this repo's objects are compiled with, so
                 ;; the frontend that admits a program here is the frontend that
                 ;; admitted the `.o`. Pinning it directly rather than advancing
                 ;; the amu above keeps that amu's ClojureScript printer fix,
                 ;; which is the reason this alias exists.
                 io.github.kotoba-lang/kotoba-sema
                 {:git/url "https://github.com/kotoba-lang/kotoba-sema.git"
                  :git/sha "e42b74eff72fdea0f55ec883a293c937421ca571"}
                 io.github.kotoba-lang/kotoba-kir
                 {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                  :git/sha "08bdab8b1084160dcb58ac291a002b140a5abf13"}}}

   :tcb-check {:main-opts ["-m" "aiueos.tcb"]}

   ;; The gate that leaves this machine (ADR-0073). An OPERATOR runs this, not
   ;; the murakumo fleet: fleet nodes hold no credentials by invariant and
   ;; their egress is not uniform, so a gate that needs an open path to three
   ;; named hosts cannot be a fleet gate.
   ;;   clojure -M:cloud-live check
   ;;   clojure -M:cloud-live pin https://kotobase.net https://api.murakumo.cloud
   ;;   clojure -M:cloud-live write
   ;; Exit 0 = every attempted leg admitted, 1 = a leg was refused,
   ;; 3 = a leg could not be answered (no network, nothing to ask).
   :cloud-live {:main-opts ["-m" "aiueos.cloud-live"]}

   ;; Mac VM phone-bind proving slice (root ADR-2608221625 P1b / P1c).
   ;;   clojure -M:phone-bind smoke
   ;;   clojure -M:phone-bind pre-enroll
   ;;   clojure -M:phone-bind serve
   ;; Exit 0 = QEMU headless + HTTP phone bind (or pre-enroll) admitted,
   ;; 1 = refused, 3 = could not answer (no QEMU/firmware).
   ;; This is not the C-free kernel gate and not clojure -M:test.
   :phone-bind {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :main-opts ["-m" "aiueos.phone-bind"]}

   ;; Hosted daily shell (root ADR-2608221625 P1 / P3). Not cloud-live check.
   ;;   clojure -M:session smoke
   ;;   clojure -M:session guest
   ;;   clojure -M:session operator
   ;;   clojure -M:session serve
   ;; smoke: DADS SPA + kotobase read + murakumo infer from this process.
   ;; guest: grant-limited :app/notes visible in the same SPA (P3).
   ;; operator: grant-gated live itonami.cloud from the same SPA (P4).
   ;; Exit 1 refused / not DADS. Exit 3 unmeasured.
   :session {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
             :main-opts ["-m" "aiueos.session"]}

   ;; Named-partial hosted desktop + guest virtio-gpu 2D + hosted WM
   ;; (ADR-0079 / ADR-0084 / ADR-0085).
   ;;   clojure -M:compositor smoke   ; SPA + surfaces + query-pci (not 2D)
   ;;   clojure -M:compositor gpu     ; KERNEL.ELF CREATE+FLUSH serial
   ;;   clojure -M:compositor wm      ; ≥2 surfaces, z-order, DADS, input
   ;;   clojure -M:compositor ime     ; romaji→kana; off-path latin is red
   ;;   clojure -M:compositor kanji   ; Space converts か→加; kana-only Space is red
   ;;   clojure -M:compositor kami    ; hosted kami.webgpu init!/draw!; clear-only is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-ime ; KERNEL.ELF Kotoba k+a→U+304B; hosted JVM IME is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-wm  ; KERNEL.ELF Kotoba two-surface z-hit; hosted JVM WM is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-paint ; KERNEL.ELF paints both boot rects in z-order; key-order paint is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-input ; KERNEL.ELF virtio-keyboard used-ring; C synthetic fill is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-gpu-two ; KERNEL.ELF two virtio-gpu 2D resources; C hardcoded count is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-scanout-two ; KERNEL.ELF scanout 1 onto resource 2; C hardcoded bind is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-broker ; KERNEL.ELF clipboard admit / picker refuse; hosted JVM WM is red
   ;;   nbb --classpath src scripts/compositor-guest.cljs guest-session ; KERNEL.ELF packed front 2 restore; hosted JVM WM is red
   ;; JVM leftover: clojure -M:compositor guest-* exits 1 (:jvm-gate-runner, ADR-0100)
   ;;   clojure -M:compositor serve
   ;; smoke Exit 0 = DADS SPA, window-session-state restore, wipe red,
   ;;   QEMU -device virtio-gpu-pci with -display none.
   ;; gpu Exit 0 = guest serial CREATE result=ok AND FLUSH result=ok.
   ;;   GET_DISPLAY_INFO and query-pci are reds for gpu.
   ;; wm Exit 0 = two stacked surfaces, raise changes front, overlap hit
   ;;   ≠ key-order, DADS title bars, pointer → focused guest.
   ;;   One surface / z-order no-op is red. ime: ka→か. kanji: か→加.
   ;; guest-ime Exit 0 = KERNEL.ELF serial GUEST_IME_OK committed=u+304b latin-leak=0.
   ;;   Hosted AIUEOS_COMPOSITOR_IME_OK is red. Leftover :native-compositor-absent.
   ;; guest-paint Exit 0 = KERNEL.ELF serial GUEST_PAINT_OK boot-overlap=2 raised-overlap=1 key-order=0.
   ;;   Hosted AIUEOS_COMPOSITOR_WM_OK is red. Leftover :native-compositor-absent.
   ;; guest-input Exit 0 = KERNEL.ELF serial GUEST_INPUT_OK eventq-used=1 synthetic=0.
   ;;   Hosted AIUEOS_COMPOSITOR_WM_OK is red. C synthetic-smoke is leftover.
   ;; guest-gpu-two Exit 0 = KERNEL.ELF serial GUEST_GPU_TWO_OK resources=2 flush=2 kotoba-n=2.
   ;;   Hosted AIUEOS_COMPOSITOR_WM_OK is red. One resource is leftover :one-resource.
   ;; guest-scanout-two Exit 0 = KERNEL.ELF serial GUEST_SCANOUT_TWO_OK scanouts=2 resource-0=1 resource-1=2 kotoba-n=2.
   ;;   Hosted AIUEOS_COMPOSITOR_WM_OK is red. One scanout is leftover :one-scanout.
   ;; guest-broker Exit 0 = KERNEL.ELF serial GUEST_BROKER_OK clipboard=1 picker=0 kotoba-clip=1 kotoba-pick=0.
   ;;   Hosted AIUEOS_COMPOSITOR_WM_OK is red. Picker on clipboard-only grant is leftover :always-grant.
   ;; guest-session Exit 0 = KERNEL.ELF serial GUEST_SESSION_OK restored-front=2 packed=2 kotoba-front=2 hit=2.
   ;;   Hosted AIUEOS_COMPOSITOR_WM_OK is red. Always-front restore is leftover :always-front.
   ;; kami Exit 0 = SPA calls kami.webgpu init!/draw! on #kami-viewport with
   ;;   a render-ir of ≥1 instance. beginRenderPass clear-only is red.
   ;; Exit 1 refused. Exit 3 unmeasured. Not P5. Goal not complete.
   :compositor {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :extra-deps {io.github.kotoba-lang/webgpu
                             {:git/url "https://github.com/kotoba-lang/webgpu.git"
                              :git/sha "17598c1206a31e594b0e028245f222e53b1b8b71"}
                             com.microsoft.playwright/playwright {:mvn/version "1.49.0"}}
                :main-opts ["-m" "aiueos.compositor"]}

   ;; Compile the browser presenter that actually calls kami.webgpu.
   ;;   clojure -M:kami-presenter
   ;; Output: apps/session/kami-presenter.js (served as /kami-presenter.js).
   :kami-presenter {:extra-paths ["apps/session/src"]
                    :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                 io.github.kotoba-lang/webgpu
                                 {:git/url "https://github.com/kotoba-lang/webgpu.git"
                                  :git/sha "17598c1206a31e594b0e028245f222e53b1b8b71"}}
                    :main-opts ["-m" "cljs.main"
                                "-t" "browser"
                                "-O" "simple"
                                "-o" "apps/session/kami-presenter.js"
                                "-c" "aiueos.session.kami-presenter"]}

   ;; P2: QEMU UEFI + KERNEL.ELF reaches kotobase (ADR-0081 / ADR-0041).
   ;;   clojure -M:bare-metal cloud
   ;; Exit 0 = guest HTTP GET + CID verify. Exit 1 = named leftover
   ;; (`:http-absent`, `:tls-absent`, `:host-fetch-does-not-count`, …).
   ;; Exit 3 = QEMU/OVMF/serial unmeasured.
   ;; Hosted `cloud-live` and `session smoke` do not count.
   ;;   clojure -M:bare-metal cert-verify
   ;; Exit 0 = guest CertificateVerify (ECDSA P-256) admitted.
   ;; HTTP+CID without that serial line is leftover `:cert-verify-hashed-only`.
   :bare-metal {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :main-opts ["-m" "aiueos.bare-metal"]}

   ;; Release attestations (SBOM + SLSA-style provenance) for a built artifact.
   ;;   clojure -M:attest sha256:<disk-digest> <source-commit> <builder> --isolated
   :attest {:main-opts ["-m" "aiueos.sbom"]}

   ;; Judge two independent builds of the same source commit. The digests are
   ;; two release build receipts' `disk.sha256`; the flags are assertions about
   ;; the environment that produced them and are never defaulted true.
   ;;   clojure -M:reproduce <source-commit> sha256:<d1> sha256:<d2> --fresh-clone --hermetic
   :reproduce {:main-opts ["-m" "aiueos.reproducibility"]}

   :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
           :ns-default build}

  ;; ADR-0014 V0: run the self-owned VMM ("hvt tender") KVM boot spike.
  ;; Needs a real /dev/kvm (Linux) and FFM native access. Prints an EDN run
  ;; receipt on stdout; exit 0 iff the guest emitted "HI\n" and requested
  ;; PSCI SYSTEM_OFF. Verified by `scripts/hvt-smoke.cljs`.
  :hvt {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "aiueos.hvt"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
