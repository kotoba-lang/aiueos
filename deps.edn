{:paths ["src" "resources"]
 ;; The decision plane left this repository on 2026-08-21 (root
 ;; ADR-2608219500). `grant` decides whether a component may run; what is
 ;; still here is the machine that runs it. The edge is one-way and the
 ;; require graph is checkable: nothing in `grant` requires `aiueos`.
 ;;
 ;; `abi` is no longer a direct dependency -- `grant.component-abi` and
 ;; `grant.contract` were the only namespaces that used it, and they moved.
 ;; It still arrives transitively through `grant`; it is not restated here,
 ;; because a dependency nothing in this repository requires is a claim
 ;; about the wrong repository.
 :deps {io.github.kotoba-lang/grant {:git/url "https://github.com/kotoba-lang/grant.git"
                                     :git/sha "7ed742ba1982a60c3140638343dfc02061f979c9"}
        io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "49fc4ce359752e9fe6e547e9071b5b9b40da937a"}
        com.dylibso.chicory/wasm {:mvn/version "1.4.0"}
        com.dylibso.chicory/runtime {:mvn/version "1.4.0"}}
 :aliases
  {:test {:extra-paths ["test"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         ;; TEST-ONLY. The compiler and the KIR interpreter drive
         ;; `tcp-seq-acceptable.kotoba`; org-ietf-tcp supplies the reference
         ;; implementation it is checked against. None of the three is linked
         ;; into anything this repo ships.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/kotoba-kir
                      {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                       :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "5df2bbe1bd81c5894edc7fa8e50fc27a5d0bd1ba"}
                      io.github.kotoba-lang/org-ietf-tcp
                      {:git/url "https://github.com/kotoba-lang/org-ietf-tcp.git"
                       :git/sha "73ace58d11e409bb387e26c2d99dccba79a99116"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

   ;; The fleet's suite. It used to be `:test` minus `-e :upstream-blocked`,
   ;; which dropped exactly one test whose twelve failures ADR-0050 established
   ;; as correct and amu#625/#626 owned. Both are answered as of 2026-08-20 --
   ;; #625 landed as a lock rather than a compare-exchange -- so the twelve are
   ;; declared rather than silently unbuilt and nothing is excluded here.
   ;;
   ;; It exists so a murakumo fleet gate can be green when the repository is
   ;; healthy. Lowering a threshold to get there would have been the other
   ;; option, and it would have made every future failure invisible instead of
   ;; one known one explicit (ADR-0063).
   :test-fleet {:extra-paths ["test"]
                :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             io.github.kotoba-lang/kotoba-kir
                             {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                              :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}
                             io.github.kotoba-lang/compiler
                             {:git/url "https://github.com/kotoba-lang/amu.git"
                              :git/sha "5df2bbe1bd81c5894edc7fa8e50fc27a5d0bd1ba"}
                             }
                ;; No org-ietf-tcp here, and the parity test that needs it is
                ;; not selected. **That repository is private**, and fleet nodes
                ;; hold no credentials by invariant, so `clojure -P` on a node
                ;; dies with "could not read Username for https://github.com"
                ;; before a single test runs — which is how this alias failed
                ;; its first real gate (ADR-0068).
                :main-opts ["-m" "cognitect.test-runner"
                            "-r" "^aiueos\\.(?!tcp-seq-acceptable-parity-test).*$"]}

   :tcb-check {:main-opts ["-m" "aiueos.tcb"]}

   ;; Release attestations (SBOM + SLSA-style provenance) for a built artifact.
   ;;   clojure -M:attest sha256:<disk-digest> <source-commit> <builder> --isolated
   :attest {:main-opts ["-m" "aiueos.sbom"]}

   ;; Judge two independent builds of the same source commit. The digests are
   ;; two release build receipts' `disk.sha256`; the flags are assertions about
   ;; the environment that produced them and are never defaulted true.
   ;;   clojure -M:reproduce <source-commit> sha256:<d1> sha256:<d2> --fresh-clone --hermetic
   :reproduce {:main-opts ["-m" "aiueos.reproducibility"]}

   :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
           :ns-default build}

  ;; ADR-0014 V0: run the self-owned VMM ("hvt tender") KVM boot spike.
  ;; Needs a real /dev/kvm (Linux) and FFM native access. Prints an EDN run
  ;; receipt on stdout; exit 0 iff the guest emitted "HI\n" and requested
  ;; PSCI SYSTEM_OFF. Verified by `scripts/hvt-smoke.cljs`.
  :hvt {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "aiueos.hvt"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
