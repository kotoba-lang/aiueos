{:paths ["src" "resources"]
 ;; The decision plane left this repository on 2026-08-21 (root
 ;; ADR-2608219500). `grant` decides whether a component may run; what is
 ;; still here is the machine that runs it. The edge is one-way and the
 ;; require graph is checkable: nothing in `grant` requires `aiueos`.
 ;;
 ;; `abi` is no longer a direct dependency -- `grant.component-abi` and
 ;; `grant.contract` were the only namespaces that used it, and they moved.
 ;; It still arrives transitively through `grant`; it is not restated here,
 ;; because a dependency nothing in this repository requires is a claim
 ;; about the wrong repository.
 :deps {io.github.kotoba-lang/grant {:git/url "https://github.com/kotoba-lang/grant.git"
                                     :git/sha "86d15e306853bd3658efb1fdfde3f8508dba9ef3"}
        io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "74235d1cdf8034334f01dcb2f6faaff0c731146e"}
        ;; This workspace's own TLS 1.3 and HTTP/1.1, so a request can leave
        ;; this machine without `java.net.http`. Both are RUNTIME dependencies
        ;; of `aiueos.provider.cloud-own` and both are TCB: a TLS client that
        ;; accepts the wrong peer, or an HTTP parser that mis-frames a body,
        ;; ends with this machine acting on somebody else's bytes.
        ;;
        ;; Pinned at each repository's `main` tip; `gh api
        ;; repos/kotoba-lang/<repo>/compare/<sha>...main` answers `identical`
        ;; for both, measured 2026-08-22. org-ietf-x509, org-ietf-asn1 and
        ;; kotoba-lang/json arrive transitively and are not restated here --
        ;; a dependency no namespace in this repository requires by name is a
        ;; claim about the wrong repository.
        io.github.kotoba-lang/org-ietf-tls
        {:git/url "https://github.com/kotoba-lang/org-ietf-tls.git"
         :git/sha "b91d4a144e7ce89380643e440f7eac48d91e45a4"}
        io.github.kotoba-lang/http
        {:git/url "https://github.com/kotoba-lang/http.git"
         :git/sha "1af5514a3a27098812be4e172d718908fb58e78e"}
        ;; Portable compositor session state (z-stack, focus, window
        ;; lifecycle). GPU draw stays kami.webgpu.ir in the SPA canvas.
        io.github.kotoba-lang/window-session-state
        {:git/url "https://github.com/kotoba-lang/window-session-state.git"
         :git/sha "8a897953ce207c42838b81f13482464cac14fabb"}
        com.dylibso.chicory/wasm {:mvn/version "1.4.0"}
        com.dylibso.chicory/runtime {:mvn/version "1.4.0"}}
 :aliases
  {:test {:extra-paths ["test"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         ;; TEST-ONLY. The compiler and the KIR interpreter drive
         ;; `tcp-seq-acceptable.kotoba`; org-ietf-tcp supplies the reference
         ;; implementation it is checked against. None of the three is linked
         ;; into anything this repo ships.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/kotoba-kir
                      {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                       :git/sha "136a62e0ad93585c5ecfa6755c82aa4ac2637e14"}
                      ;; The repository was renamed compiler -> amu. One
                      ;; repository reachable under two coordinates is what the
                      ;; workspace's dep-coordinate-identity detector exists to
                      ;; catch, so the coordinate follows the name.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "6889fa736750348863d2b98d69e688131a2ca515"}
                      io.github.kotoba-lang/org-ietf-tcp
                      {:git/url "https://github.com/kotoba-lang/org-ietf-tcp.git"
                       :git/sha "d8c15e23b6c169a4ed044cd7764923ecbb789be4"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

   ;; The fleet's suite. It used to be `:test` minus `-e :upstream-blocked`,
   ;; which dropped exactly one test whose twelve failures ADR-0050 established
   ;; as correct and amu#625/#626 owned. Both are answered as of 2026-08-20 --
   ;; #625 landed as a lock rather than a compare-exchange -- so the twelve are
   ;; declared rather than silently unbuilt and nothing is excluded here.
   ;;
   ;; It exists so a murakumo fleet gate can be green when the repository is
   ;; healthy. Lowering a threshold to get there would have been the other
   ;; option, and it would have made every future failure invisible instead of
   ;; one known one explicit (ADR-0063).
   :test-fleet {:extra-paths ["test"]
                :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             io.github.kotoba-lang/kotoba-kir
                             {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                              :git/sha "136a62e0ad93585c5ecfa6755c82aa4ac2637e14"}
                             io.github.kotoba-lang/amu
                             {:git/url "https://github.com/kotoba-lang/amu.git"
                              :git/sha "6889fa736750348863d2b98d69e688131a2ca515"}
                             }
                ;; No org-ietf-tcp here, and the parity test that needs it is
                ;; not selected. **That repository is private**, and fleet nodes
                ;; hold no credentials by invariant, so `clojure -P` on a node
                ;; dies with "could not read Username for https://github.com"
                ;; before a single test runs — which is how this alias failed
                ;; its first real gate (ADR-0068).
                :main-opts ["-m" "cognitect.test-runner"
                            "-r" "^aiueos\\.(?!tcp-seq-acceptable-parity-test).*$"]}

   :tcb-check {:main-opts ["-m" "aiueos.tcb"]}

   ;; The gate that leaves this machine (ADR-0073). An OPERATOR runs this, not
   ;; the murakumo fleet: fleet nodes hold no credentials by invariant and
   ;; their egress is not uniform, so a gate that needs an open path to three
   ;; named hosts cannot be a fleet gate.
   ;;   clojure -M:cloud-live check
   ;;   clojure -M:cloud-live pin https://kotobase.net https://api.murakumo.cloud
   ;;   clojure -M:cloud-live write
   ;; Exit 0 = every attempted leg admitted, 1 = a leg was refused,
   ;; 3 = a leg could not be answered (no network, nothing to ask).
   :cloud-live {:main-opts ["-m" "aiueos.cloud-live"]}

   ;; Mac VM phone-bind proving slice (root ADR-2608221625 P1b / P1c).
   ;;   clojure -M:phone-bind smoke
   ;;   clojure -M:phone-bind pre-enroll
   ;;   clojure -M:phone-bind serve
   ;; Exit 0 = QEMU headless + HTTP phone bind (or pre-enroll) admitted,
   ;; 1 = refused, 3 = could not answer (no QEMU/firmware).
   ;; This is not the C-free kernel gate and not clojure -M:test.
   :phone-bind {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :main-opts ["-m" "aiueos.phone-bind"]}

   ;; Hosted daily shell (root ADR-2608221625 P1 / P3). Not cloud-live check.
   ;;   clojure -M:session smoke
   ;;   clojure -M:session guest
   ;;   clojure -M:session operator
   ;;   clojure -M:session serve
   ;; smoke: DADS SPA + kotobase read + murakumo infer from this process.
   ;; guest: grant-limited :app/notes visible in the same SPA (P3).
   ;; operator: grant-gated live itonami.cloud from the same SPA (P4).
   ;; Exit 1 refused / not DADS. Exit 3 unmeasured.
   :session {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
             :main-opts ["-m" "aiueos.session"]}

   ;; Named-partial hosted desktop + guest virtio-gpu 2D (ADR-0079 / ADR-0084).
   ;;   clojure -M:compositor smoke   ; SPA + surfaces + query-pci (not 2D)
   ;;   clojure -M:compositor gpu     ; KERNEL.ELF CREATE+FLUSH serial
   ;;   clojure -M:compositor serve
   ;; smoke Exit 0 = DADS SPA, window-session-state restore, wipe red,
   ;;   QEMU -device virtio-gpu-pci with -display none.
   ;; gpu Exit 0 = guest serial CREATE result=ok AND FLUSH result=ok.
   ;;   GET_DISPLAY_INFO and query-pci are reds for gpu.
   ;; Exit 1 refused. Exit 3 unmeasured. Not a WM. IME leftover.
   :compositor {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :main-opts ["-m" "aiueos.compositor"]}

   ;; P2: QEMU UEFI + KERNEL.ELF reaches kotobase (ADR-0081 / ADR-0041).
   ;;   clojure -M:bare-metal cloud
   ;; Exit 0 = guest HTTP GET + CID verify. Exit 1 = named leftover
   ;; (`:http-absent`, `:tls-absent`, `:host-fetch-does-not-count`, …).
   ;; Exit 3 = QEMU/OVMF/serial unmeasured.
   ;; Hosted `cloud-live` and `session smoke` do not count.
   :bare-metal {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :main-opts ["-m" "aiueos.bare-metal"]}

   ;; Release attestations (SBOM + SLSA-style provenance) for a built artifact.
   ;;   clojure -M:attest sha256:<disk-digest> <source-commit> <builder> --isolated
   :attest {:main-opts ["-m" "aiueos.sbom"]}

   ;; Judge two independent builds of the same source commit. The digests are
   ;; two release build receipts' `disk.sha256`; the flags are assertions about
   ;; the environment that produced them and are never defaulted true.
   ;;   clojure -M:reproduce <source-commit> sha256:<d1> sha256:<d2> --fresh-clone --hermetic
   :reproduce {:main-opts ["-m" "aiueos.reproducibility"]}

   :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
           :ns-default build}

  ;; ADR-0014 V0: run the self-owned VMM ("hvt tender") KVM boot spike.
  ;; Needs a real /dev/kvm (Linux) and FFM native access. Prints an EDN run
  ;; receipt on stdout; exit 0 iff the guest emitted "HI\n" and requested
  ;; PSCI SYSTEM_OFF. Verified by `scripts/hvt-smoke.cljs`.
  :hvt {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "aiueos.hvt"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
